---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { buildProductView, getRelatedProductSlugs } from '../../lib/product-selection';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products
    .filter(p => !p.data.draft)
    .map(p => ({
      params: { slug: p.id.replace(/\.md$/, '') },
      props: { product: p },
    }));
}

const { product } = Astro.props;
const data = product.data;
const productView = buildProductView(product);
if (!productView) throw new Error(`Unknown product reference: ${product.id}`);
const model = productView.model;
const category = productView.family.name;
const quoteUrl = `/contact/?product=${encodeURIComponent(model)}`;
const datasheetUrl = `/contact/?product=${encodeURIComponent(model)}&request=datasheet`;

const allProducts = await getCollection('products');
const relatedSlugs = getRelatedProductSlugs(product.id, data.relatedProducts);
const related = relatedSlugs.flatMap(slug => {
  const candidate = allProducts.find(item => item.id === slug && !item.data.draft);
  return candidate ? [candidate] : [];
});
const { Content } = await render(product);

const archiveReferenceRows = [
  {
    label: productView.orientation.label,
    scope: productView.orientation.scope,
    value: productView.orientation.value ?? productView.statusNote,
  },
];

function visualAlt(url: string): string {
  const labels: Array<[string, string]> = [
    ['hero-2.webp', 'Editorial roof-level panel-forming workflow in an industrial building'],
    ['truck-site-roll-forming-lift.webp', 'Editorial truck-mounted equipment arrangement at a project site'],
    ['40hq-logistics-checkpoints.svg', 'Editorial diagram of container logistics review checkpoints'],
    ['port-loading-logistics.webp', 'Editorial port handling and logistics planning scene'],
    ['crawler-truck-selection-matrix.svg', 'Editorial crawler and truck configuration selection diagram'],
    ['roof-level-workflow.svg', 'Editorial roof-level roll-forming workflow diagram'],
    ['roll-forming-input-map.svg', 'Editorial roll-forming project input diagram'],
    ['large-deck-steel-structure.webp', 'Editorial large-deck platform arrangement in a steel structure'],
    ['ceiling-platform-underside.webp', 'Editorial underside work context for a large-deck platform'],
    ['ceiling-platform-project-data.svg', 'Editorial ceiling-platform project data checklist'],
  ];
  return labels.find(([suffix]) => url.endsWith(suffix))?.[1]
    || 'Representative editorial equipment-planning visual';
}

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: data.title,
  description: data.description,
  about: {
    '@type': 'Thing',
    name: `${model} archived reference configuration`,
    description: productView.scopeStatement,
  },
};
---

<BaseLayout title={data.title} description={data.description} ogImage={data.images?.[0]} transparentNav={false}>
  <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />

  {data.faq && data.faq.length > 0 && (
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: data.faq.map(item => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer },
      })),
    })} />
  )}

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: 'Products', item: new URL('/products/', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: data.title },
    ],
  })} />

  <div class="bread">
    <a href="/">Home</a> / <a href="/products/">Products</a> / <span>{model}</span>
  </div>

  <section class="product-hero">
    <div class="product-hero__gallery" aria-label={`${model} editorial planning gallery`}>
      {data.images && data.images.length > 0 ? (
        <div class="decision-gallery">
          {data.images.map((img: string, i: number) => (
            <figure class="decision-gallery__figure">
              <img src={img} alt={visualAlt(img)} width="640" height="480" loading={i === 0 ? 'eager' : 'lazy'} />
              <figcaption>AI-assisted editorial visual. {productView.imageDisclosure}</figcaption>
            </figure>
          ))}
        </div>
      ) : (
        <div class="product-hero__main">{model}</div>
      )}
    </div>

    <div class="product-hero__info">
      <div class="product-hero__tag">{category}</div>
      <h1 class="product-hero__name">{model}</h1>
      <p class="product-hero__sub">{data.title.split(' — ')[1] || category}</p>
      <div class="reference-status">
        <span>{productView.status}</span>
        <strong>{productView.statusNote}</strong>
      </div>
      <p class="scope-statement">{productView.scopeStatement}</p>
      <div class="specs-mini">
        <div class="spec-mini">
          <div class="spec-mini__label">{productView.orientation.label}</div>
          <div class="spec-mini__val">{productView.orientation.value ?? productView.statusNote}</div>
          <div class="spec-mini__scope">{productView.orientation.scope}</div>
        </div>
        <div class="spec-mini">
          <div class="spec-mini__label">Confirmation gate</div>
          <div class="spec-mini__val">{productView.confirmationGate}</div>
        </div>
      </div>
      <div class="product-hero__btns">
        <a href={quoteUrl} class="btn btn--primary">Request a project review →</a>
        <a href={datasheetUrl} class="btn btn--outline-blue">Request available reference documents</a>
      </div>
    </div>
  </section>

  <nav class="decision-nav" aria-label="Product decision sections">
    <a href="#selection-overview">Selection overview</a>
    <a href="#archive-reference">Archive reference</a>
    <a href="#project-inputs">Project inputs</a>
    <a href="#workflows-to-assess">Workflows to assess</a>
    <a href="#questions-and-documents">Questions and documents</a>
  </nav>

  <div class="decision-page">
    <section id="selection-overview" class="decision-section decision-section--content">
      <div class="decision-section__heading">
        <p>Selection overview</p>
        <h2>Use the reference to frame a project review</h2>
        <p>{productView.family.workflow}</p>
      </div>
      <div class="product-markdown"><Content /></div>
    </section>

    <section id="archive-reference" class="decision-section decision-section--tint">
      <div class="decision-section__heading">
        <p>Archive reference</p>
        <h2>Public orientation, not a current-model specification</h2>
        <p>{productView.scopeStatement}</p>
      </div>
      <div class="reference-summary">
        <div>
          <span>Reference status</span>
          <strong>{productView.status}</strong>
          <p>{productView.statusNote}</p>
        </div>
        <div>
          <span>Confirmation gate</span>
          <strong>Project documents control</strong>
          <p>{productView.confirmationGate}</p>
        </div>
      </div>
      <div class="specs-table-wrap">
        <table class="specs-table">
          <caption>Public archive orientation</caption>
          <thead>
            <tr><th scope="col">Reference field</th><th scope="col">Published orientation</th></tr>
          </thead>
          <tbody>
            {archiveReferenceRows.map(row => (
              <tr>
                <th scope="row">{row.label}<small>{row.scope}</small></th>
                <td>{row.value}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section id="project-inputs" class="decision-section">
      <div class="decision-section__heading">
        <p>Project inputs</p>
        <h2>Prepare these inputs before configuration review</h2>
        <p>The checklist follows the {productView.family.shortName} family route.</p>
      </div>
      <ul class="decision-list">
        {productView.family.projectInputs.map(input => <li>{input}</li>)}
      </ul>
    </section>

    <section id="workflows-to-assess" class="decision-section decision-section--tint">
      <div class="decision-section__heading">
        <p>Workflows to assess</p>
        <h2>Review the interfaces around the equipment</h2>
        <p>These are review topics, not claims that the reference is suitable for a site.</p>
      </div>
      <div class="workflow-grid">
        {productView.family.workflowsToAssess.map((workflow, index) => (
          <article>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{workflow}</h3>
          </article>
        ))}
      </div>
    </section>

    <section id="questions-and-documents" class="decision-section">
      <div class="decision-section__heading">
        <p>Questions and documents</p>
        <h2>Close the review with available reference documents</h2>
        <p>{productView.buyerQuestion}</p>
      </div>

      {data.faq && data.faq.length > 0 && (
        <div class="faq-grid">
          {data.faq.map(item => <article class="faq-item"><h3>{item.question}</h3><p>{item.answer}</p></article>)}
        </div>
      )}

      <div class="documents-panel">
        <div>
          <h3>Documents to request and validate</h3>
          <ul>
            {productView.family.requiredDocuments.map(document => <li>{document}</li>)}
          </ul>
          <p>Availability and applicability depend on the reviewed configuration. The signed project documents, not this page, control an order.</p>
        </div>
        <div class="documents-panel__actions">
          <a href={datasheetUrl} class="btn btn--primary">Request available reference documents</a>
          <a href={quoteUrl} class="btn btn--outline-blue">Send project inputs</a>
        </div>
      </div>
    </section>
  </div>

  <section class="sec related-section">
    <div class="sec__header">
      <div class="sec__overline">Related references</div>
      <h2 class="sec__title">Continue the selection review</h2>
    </div>
    <div class="related">
      {related.map(rp => {
        const relatedView = buildProductView(rp);
        if (!relatedView) return null;
        const rModel = relatedView.model;
        return (
          <a href={`/products/${rp.id}/`} class="related-card">
            {rp.data.images?.[0] ? (
              <figure class="related-card__img" style={`background-image:url('${rp.data.images[0]}');background-size:contain;background-position:center;background-repeat:no-repeat;`}>
                <figcaption class="related-card__disclosure">AI-assisted editorial visual. {relatedView.imageDisclosure}</figcaption>
              </figure>
            ) : (
              <div class="related-card__img">{rModel}</div>
            )}
            <div class="related-card__body">
              <h3>{rModel}</h3>
              <p>{relatedView.status} · {relatedView.statusNote}</p>
              <span>View reference →</span>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <style>
    .decision-gallery {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: min(100%, 640px);
      gap: 16px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding: 0 0 8px;
    }
    .decision-gallery__figure {
      scroll-snap-align: start;
      margin: 0;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      overflow: hidden;
      background: #f8fafc;
    }
    .decision-gallery__figure img {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 4 / 3;
      object-fit: contain;
      background: #f8fafc;
    }
    .decision-gallery__figure figcaption {
      padding: 10px 14px;
      border-top: 1px solid #e2e8f0;
      background: #f1f5f9;
      color: #475569;
      font-size: .82rem;
      line-height: 1.5;
    }
    .reference-status {
      display: flex;
      flex-wrap: wrap;
      gap: 8px 14px;
      margin: 18px 0 8px;
      color: #475569;
    }
    .reference-status span {
      padding: 4px 9px;
      border-radius: 999px;
      background: #e0f2fe;
      color: #075985;
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .04em;
    }
    .scope-statement,
    .spec-mini__scope {
      color: #64748b;
      line-height: 1.65;
    }
    .spec-mini__scope {
      margin-top: 6px;
      font-size: 12px;
    }
    .decision-nav {
      position: sticky;
      top: 0;
      z-index: 5;
      display: flex;
      gap: 8px;
      max-width: var(--max-w);
      margin: 0 auto;
      padding: 12px var(--section-px);
      overflow-x: auto;
      background: rgba(255, 255, 255, .96);
      border-block: 1px solid #e2e8f0;
      backdrop-filter: blur(10px);
    }
    .decision-nav a {
      flex: 0 0 auto;
      padding: 8px 12px;
      border-radius: 999px;
      background: #f1f5f9;
      color: #334155;
      font-size: 14px;
      font-weight: 650;
      text-decoration: none;
    }
    .decision-page {
      max-width: var(--max-w);
      margin: 0 auto;
      padding: 0 var(--section-px);
    }
    .decision-section {
      scroll-margin-top: 92px;
      padding: 72px 0;
      border-bottom: 1px solid #e2e8f0;
    }
    .decision-section--tint {
      margin-inline: calc(var(--section-px) * -1);
      padding-inline: var(--section-px);
      background: #f8fafc;
    }
    .decision-section__heading {
      max-width: 780px;
      margin-bottom: 28px;
    }
    .decision-section__heading > p:first-child {
      margin: 0 0 8px;
      color: #2563eb;
      font-size: 13px;
      font-weight: 800;
      letter-spacing: .08em;
      text-transform: uppercase;
    }
    .decision-section__heading h2 {
      margin: 0 0 12px;
      color: #0f172a;
      font-size: clamp(28px, 4vw, 42px);
      line-height: 1.1;
    }
    .decision-section__heading p:last-child {
      color: #475569;
      font-size: 17px;
      line-height: 1.7;
    }
    .product-markdown {
      max-width: 860px;
      color: #334155;
      font-size: 16px;
      line-height: 1.85;
    }
    .reference-summary {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
      margin-bottom: 24px;
    }
    .reference-summary > div,
    .workflow-grid article,
    .documents-panel {
      padding: 22px;
      border: 1px solid #dbe3ee;
      border-radius: 14px;
      background: #fff;
    }
    .reference-summary span,
    .workflow-grid span {
      color: #2563eb;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: .06em;
      text-transform: uppercase;
    }
    .reference-summary strong {
      display: block;
      margin: 8px 0;
      color: #0f172a;
      font-size: 19px;
    }
    .reference-summary p {
      margin: 0;
      color: #64748b;
      line-height: 1.6;
    }
    .specs-table-wrap {
      overflow-x: auto;
    }
    .specs-table caption {
      padding: 0 0 12px;
      color: #475569;
      font-weight: 700;
      text-align: left;
    }
    .specs-table th {
      text-align: left;
    }
    .specs-table small {
      display: block;
      margin-top: 4px;
      color: #64748b;
      font-weight: 400;
    }
    .decision-list {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 14px;
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .decision-list li {
      position: relative;
      padding: 20px 20px 20px 48px;
      border: 1px solid #dbe3ee;
      border-radius: 12px;
      color: #1e293b;
      font-weight: 650;
    }
    .decision-list li::before {
      position: absolute;
      top: 20px;
      left: 20px;
      content: '✓';
      color: #2563eb;
      font-weight: 900;
    }
    .workflow-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
    }
    .workflow-grid h3 {
      margin: 12px 0 0;
      color: #1e293b;
      font-size: 18px;
      line-height: 1.45;
    }
    .documents-panel {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 32px;
      margin-top: 30px;
      background: #f8fafc;
    }
    .documents-panel h3 {
      margin-top: 0;
      color: #0f172a;
    }
    .documents-panel li,
    .documents-panel p {
      color: #475569;
      line-height: 1.65;
    }
    .documents-panel__actions {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 10px;
      min-width: 280px;
    }
    .related-card__body h3 {
      margin: 0 0 8px;
      color: #0f172a;
      font-size: 20px;
    }
    .related-card__body span {
      color: #2563eb;
      font-size: 14px;
      font-weight: 700;
    }
    @media (max-width: 768px) {
      .reference-summary,
      .decision-list,
      .workflow-grid,
      .documents-panel {
        grid-template-columns: 1fr;
      }
      .decision-section {
        padding-block: 52px;
      }
      .documents-panel__actions {
        min-width: 0;
      }
    }
  </style>
</BaseLayout>
