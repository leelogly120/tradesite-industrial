---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { buildProductView, getRelatedProductSlugs } from '../../lib/product-selection';
import { EQUIPMENT_CATALOG, RELATED_FORMING_EQUIPMENT } from '../../lib/equipment-catalog';
import { getProductGuides } from '../../lib/guide-navigation';
import { catalogProductJsonLd } from '../../lib/catalog-product-jsonld';
import GuideLinks from '../../components/GuideLinks.astro';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products
    .filter(p => !p.data.draft)
    .map(p => ({
      params: { slug: p.id.replace(/\.md$/, '') },
      props: { product: p },
    }));
}

const { product } = Astro.props;
const data = product.data;
const productView = buildProductView(product);
if (!productView) throw new Error(`Unknown product reference: ${product.id}`);
const model = productView.model;
const category = productView.family.name;
const familyDetails = {
  'crawler-roll-forming-lifts': { name: 'Crawler Roll Forming Lift' },
  'truck-mounted-roll-forming-lifts': { name: 'Truck-Mounted Roll Forming Lift' },
  'crawler-ceiling-platforms': { name: 'Crawler Ceiling Platform' },
  'roll-forming-machines': { name: 'Roll Forming Line' },
} as const;
const familyDetail = familyDetails[productView.family.id];
const equipment = EQUIPMENT_CATALOG.find(item => item.referenceFamilyId === productView.family.id) ?? RELATED_FORMING_EQUIPMENT;
const metaTitle = product.id === 'arc-f20-crawler-ceiling-platform'
  ? 'ARC-F20 Crawler Large-Deck Ceiling Work Platform (20m Class)'
  : product.id === 'arc-t25hq-truck-mounted-roll-forming-lift-40hq'
    ? 'ARC-T25HQ Vehicle-Mounted Lift — 40HQ Packing Route'
    : data.title;
const productGuides = getProductGuides(productView.family.id, await getCollection('blog'));
const quoteUrl = productView.catalogSpecs
  ? `/contact/?model=${encodeURIComponent(model)}&product=${encodeURIComponent(model)}&request=quote`
  : `/contact/?product=${encodeURIComponent(model)}&request=quote`;
const catalogSchema = catalogProductJsonLd(product.id);
const referenceSectionLabel = productView.catalogSpecs ? 'Catalog reference' : 'Archive reference';
const datasheetUrl = `/contact/?product=${encodeURIComponent(model)}&request=datasheet`;

const allProducts = await getCollection('products');
const relatedSlugs = getRelatedProductSlugs(product.id, data.relatedProducts);
const related = relatedSlugs.flatMap(slug => {
  const candidate = allProducts.find(item => item.id === slug && !item.data.draft);
  return candidate ? [candidate] : [];
});
const { Content } = await render(product);

const archiveReferenceRows = [
  {
    label: productView.orientation.label,
    scope: productView.orientation.scope,
    value: productView.orientation.value,
  },
];

function visualAlt(url: string): string {
  const labels: Array<[string, string]> = [
    ['hero-2.webp', 'Editorial roof-level panel-forming workflow in an industrial building'],
    ['truck-site-roll-forming-lift.webp', 'Editorial truck-mounted equipment arrangement at a project site'],
    ['40hq-logistics-checkpoints.svg', 'Editorial diagram of container logistics review checkpoints'],
    ['port-loading-logistics.webp', 'Editorial port handling and logistics planning scene'],
    ['crawler-truck-selection-matrix.svg', 'Editorial crawler and truck configuration selection diagram'],
    ['roof-level-workflow.svg', 'Editorial roof-level roll-forming workflow diagram'],
    ['roll-forming-input-map.svg', 'Editorial roll-forming project input diagram'],
    ['large-deck-steel-structure.webp', 'Editorial large-deck platform arrangement in a steel structure'],
    ['ceiling-platform-underside.webp', 'Editorial underside work context for a large-deck platform'],
    ['ceiling-platform-project-data.svg', 'Editorial ceiling-platform project data checklist'],
  ];
  return labels.find(([suffix]) => url.endsWith(suffix))?.[1]
    || 'Representative editorial equipment-planning visual';
}

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: metaTitle,
  description: data.description,
  about: {
    '@type': 'Thing',
    name: `${model} ${productView.status}: ${productView.orientation.scope}`,
    description: productView.scopeStatement,
  },
};
---

<BaseLayout title={metaTitle} description={data.description} ogImage={data.images?.[0]} transparentNav={false}>
  <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
  {catalogSchema && <script type="application/ld+json" set:html={JSON.stringify(catalogSchema)} />}

  {data.faq && data.faq.length > 0 && (
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: data.faq.map(item => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer },
      })),
    })} />
  )}

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: 'Products', item: new URL('/products/', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: data.title },
    ],
  })} />

  <div class="bread">
    <a href="/">Home</a> / <a href="/products/">Products</a> / <span>{model}</span>
  </div>

  <section class="product-intro">
    <div class="product-intro__copy">
      <div class="product-hero__tag">{category}</div>
      <h1 class="product-hero__name">{productView.headline ?? `${model} ${familyDetail.name}`}</h1>
      <div class="reference-status">
        <span>{productView.status}</span>
        <a href="#archive-reference">View historical reference</a>
      </div>
      <p class="product-workflow" data-product-workflow>{equipment.description}</p>
      <div class="product-hero__btns">
        <a href={quoteUrl} class="btn btn--primary" data-product-primary-cta>Request a quote →</a>
        <a href={datasheetUrl} class="btn btn--outline-blue">Request specifications</a>
      </div>
      {productView.catalogSpecs && <p class="product-workflow">Request a quote — send the 8 inputs (height, profile, machine mass, coil, access, chassis yes/no, destination, timeline) via the contact form, WhatsApp +86 15515922444, or leelogly120@gmail.com.</p>}
    </div>
    <figure class="product-intro__photo" data-product-photo>
      <img src={equipment.image.src} width={equipment.image.width} height={equipment.image.height} alt={equipment.image.alt} fetchpriority="high" />
      <figcaption>{equipment.image.caption} Family reference photograph, not an image of this ARC model.</figcaption>
    </figure>
  </section>
  <ul class="product-features" aria-label="Equipment features">{equipment.features.map(feature => <li>{feature}</li>)}</ul>

  <nav class="decision-nav" aria-label="Product decision sections">
    <a href="#selection-overview">Equipment background</a>
    <a href="#archive-reference">{referenceSectionLabel}</a>
    <a href="#project-inputs">Project inputs</a>
    <a href="#workflows-to-assess">System interfaces</a>
    <a href="#questions-and-documents">FAQs and documents</a>
    <a href="#product-guides">Technical guides</a>
  </nav>

  <div class="decision-page">
    <section id="archive-reference" class="decision-section decision-section--tint">
      <div class="decision-section__heading">
        <p>{referenceSectionLabel}</p>
        <h2>{productView.catalogSpecs ? 'Catalog reference specifications' : 'Historical class and current specification'}</h2>
        <p>{productView.scopeStatement} {productView.statusNote}. Current height, load, dimensions and options are established by the {productView.confirmationGate.toLowerCase()}.</p>
      </div>
      {productView.catalogSpecs && (
        <div class="specs-table-wrap">
          <table class="specs-table">
            <caption>Minimum catalog specification — confirm unknown values on RFQ</caption>
            <thead>
              <tr><th scope="col">Field</th><th scope="col">Catalog reference</th><th scope="col">Notes</th></tr>
            </thead>
            <tbody>
              {productView.catalogSpecs.map(row => (
                <tr>
                  <th scope="row">{row.field}</th>
                  <td>{row.value}</td>
                  <td>{row.notes}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
      <div class="specs-table-wrap">
        <table class="specs-table">
          <caption>{productView.catalogSpecs ? 'Published orientation' : 'Public archive orientation'}</caption>
          <thead>
            <tr><th scope="col">Reference field</th><th scope="col">Published orientation</th></tr>
          </thead>
          <tbody>
            {archiveReferenceRows.map(row => (
              <tr>
                <th scope="row">{row.label}<small>{row.scope}</small></th>
                <td>{row.value}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section id="selection-overview" class="decision-section decision-section--content">
      <div class="decision-section__heading"><p>Equipment background</p><h2>{model} selection notes</h2></div>
      <div class="product-markdown"><Content /></div>
    </section>

    <section id="project-inputs" class="decision-section">
      <div class="decision-section__heading">
        <p>Project inputs</p>
        <h2>Tell us about your application</h2>
      </div>
      <ul class="decision-list">
        {productView.family.projectInputs.map(input => <li>{input}</li>)}
      </ul>
    </section>

    <section id="workflows-to-assess" class="decision-section decision-section--tint">
      <div class="decision-section__heading">
        <p>Workflows to assess</p>
        <h2>Match the system to the site</h2>
      </div>
      <div class="workflow-grid">
        {productView.family.workflowsToAssess.map((workflow, index) => (
          <article>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{workflow}</h3>
          </article>
        ))}
      </div>
    </section>

    <section id="questions-and-documents" class="decision-section">
      <div class="decision-section__heading">
        <p>Questions and documents</p>
        <h2>Questions and specification documents</h2>
      </div>

      {data.faq && data.faq.length > 0 && (
        <div class="faq-grid">
          {data.faq.map(item => <article class="faq-item"><h3>{item.question}</h3><p>{item.answer}</p></article>)}
        </div>
      )}

      <div class="documents-panel">
        <div>
          <h3>Documents to request and validate</h3>
          <ul>
            {productView.family.requiredDocuments.map(document => <li>{document}</li>)}
          </ul>
          <p>Request the available documents for the proposed configuration.</p>
        </div>
        <div class="documents-panel__actions">
          <a href={datasheetUrl} class="btn btn--primary">Request available reference documents</a>
          <a href={quoteUrl} class="btn btn--outline-blue">Request a quote</a>
        </div>
      </div>
    </section>
    <GuideLinks id="product-guides" title="Technical guides for this equipment family" introduction="Practical guidance on the machine, worksite and transport questions." links={productGuides} />
  </div>

  <section class="sec related-section">
    <div class="sec__header">
      <div class="sec__overline">Related catalog models</div>
      <h2 class="sec__title">Continue the selection review</h2>
      <p class="catalog-disclaimer">Catalog references on this page support selection and RFQ. Final height, load, dimensions, options, and transport arrangement are confirmed by the quotation technical schedule, approved drawings, and applicable load chart for the ordered configuration.</p>
    </div>
    <div class="related">
      {related.map(rp => {
        const relatedView = buildProductView(rp);
        if (!relatedView) return null;
        const rModel = relatedView.model;
        return (
          <a href={`/products/${rp.id}/`} class="related-card">
            <div class="related-card__body">
              <h3>{rModel}</h3>
              <p>{relatedView.status} · {relatedView.statusNote}</p>
              <span>View reference →</span>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <details class="product-gallery-section">
    <summary>Optional equipment planning illustrations</summary>
    <p>These AI-assisted editorial visuals explain planning relationships and are not model-specific evidence.</p>
    <div class="product-hero__gallery" aria-label={`${model} editorial planning gallery`}>
      <div class="decision-gallery">
        {data.images.map((img: string) => (
          <figure class="decision-gallery__figure">
            <img src={img} alt={visualAlt(img)} width="640" height="480" loading="lazy" />
            <figcaption>AI-assisted editorial visual. {productView.imageDisclosure}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </details>

  <style>
    .product-intro,
    .product-gallery-section {
      max-width: var(--max-w);
      margin-inline: auto;
      padding-inline: var(--section-px);
    }
    .product-intro {
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      gap: clamp(2rem, 5vw, 5rem);
      align-items: center;
      padding-block: 24px 32px;
    }
    .product-intro__copy {
      min-width: 0;
    }
    .product-hero__name { margin-block: 10px 18px; color: #123b50; font-size: clamp(32px, 3.8vw, 50px); line-height: 1.08; letter-spacing: -.03em; }
    .product-hero__tag { color: #a4411c; font-size: 13px; letter-spacing: .07em; }
    .product-intro__photo { min-width: 0; margin: 0; background: #eaf0f3; }
    .product-intro__photo img { display: block; width: 100%; height: auto; max-height: 430px; object-fit: contain; }
    .product-intro__photo figcaption { padding: 12px 16px; color: #526570; font-size: 13px; line-height: 1.5; background: #f3f6f8; }
    .product-features { max-width: var(--max-w); display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; margin: 0 auto 32px; padding: 0 var(--section-px); list-style: none; }
    .product-features li { padding: 16px 18px; background: #eaf0f3; border-top: 2px solid #b04b26; color: #123b50; font-size: 16px; font-weight: 600; line-height: 1.5; }
    .reference-status a { color: #526570; font-size: 13px; min-height: 28px; display: inline-flex; align-items: center; }
    .product-hero__btns { gap: 10px; }
    .product-hero__btns .btn { padding-inline: 20px; }
    .product-workflow {
      margin: 1rem 0 1.5rem;
      color: #526570;
      font-size: 1.05rem;
      line-height: 1.7;
    }
    .product-gallery-section {
      padding-block: 18px 40px;
      color: #526570;
    }
    .product-gallery-section summary { min-height: 48px; padding-block: 12px; color: #123b50; cursor: pointer; font-weight: 700; }
    .product-gallery-section > p { font-size: 14px; line-height: 1.5; }
    .product-gallery-heading {
      max-width: 720px;
      margin-bottom: 1.25rem;
    }
    .product-gallery-heading p {
      margin: 0 0 .4rem;
      color: #2563eb;
      font-size: .78rem;
      font-weight: 800;
      letter-spacing: .08em;
      text-transform: uppercase;
    }
    .product-gallery-heading h2 {
      margin: 0;
      color: #0f172a;
      font-size: clamp(1.45rem, 3vw, 2rem);
      line-height: 1.2;
    }
    .decision-gallery {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: min(100%, 640px);
      gap: 16px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding: 0 0 8px;
    }
    .decision-gallery__figure {
      scroll-snap-align: start;
      margin: 0;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      overflow: hidden;
      background: #f8fafc;
    }
    .decision-gallery__figure img {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 4 / 3;
      object-fit: contain;
      background: #f8fafc;
    }
    .decision-gallery__figure figcaption {
      padding: 10px 14px;
      border-top: 1px solid #e2e8f0;
      background: #f1f5f9;
      color: #475569;
      font-size: .82rem;
      line-height: 1.5;
    }
    .reference-status {
      display: flex;
      flex-wrap: wrap;
      gap: 8px 14px;
      margin: 18px 0 8px;
      color: #475569;
    }
    .reference-status span {
      padding: 4px 9px;
      border-radius: 999px;
      background: #eaf0f3;
      color: #123b50;
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .04em;
    }
    .scope-statement,
    .spec-mini__scope {
      color: #64748b;
      line-height: 1.65;
    }
    .spec-mini__scope {
      margin-top: 6px;
      font-size: 12px;
    }
    .decision-nav {
      position: sticky;
      top: var(--nav-height);
      z-index: 12;
      display: flex;
      gap: 8px;
      max-width: var(--max-w);
      margin: 0 auto;
      padding: 12px var(--section-px);
      overflow-x: auto;
      background: rgba(255, 255, 255, .96);
      border-block: 1px solid #e2e8f0;
      backdrop-filter: blur(10px);
    }
    .decision-nav a {
      flex: 0 0 auto;
      padding: 8px 12px;
      border-radius: 999px;
      background: #f1f5f9;
      color: #334155;
      font-size: 14px;
      font-weight: 650;
      text-decoration: none;
    }
    .decision-page {
      max-width: var(--max-w);
      margin: 0 auto;
      padding: 0 var(--section-px);
    }
    .decision-section {
      scroll-margin-top: calc(var(--nav-height) + 5rem);
      padding: 40px 0;
      border-bottom: 1px solid #e2e8f0;
    }
    .decision-section--tint {
      margin-inline: calc(var(--section-px) * -1);
      padding-inline: var(--section-px);
      background: #f8fafc;
    }
    .decision-section__heading {
      max-width: 780px;
      margin-bottom: 28px;
    }
    .decision-section__heading > p:first-child {
      margin: 0 0 8px;
      color: #a4411c;
      font-size: 13px;
      font-weight: 800;
      letter-spacing: .08em;
      text-transform: uppercase;
    }
    .decision-section__heading h2 {
      margin: 0 0 12px;
      color: #123b50;
      font-size: clamp(26px, 3vw, 34px);
      line-height: 1.1;
    }
    .decision-section__heading p:last-child {
      color: #475569;
      font-size: 17px;
      line-height: 1.7;
    }
    .product-markdown {
      max-width: 860px;
      color: #334155;
      font-size: 16px;
      line-height: 1.85;
    }
    .reference-summary {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
      margin-bottom: 24px;
    }
    .reference-summary > div,
    .workflow-grid article,
    .documents-panel {
      padding: 22px;
      border: 1px solid #dbe3ee;
      border-radius: 14px;
      background: #fff;
    }
    .reference-summary span,
    .workflow-grid span {
      color: #2563eb;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: .06em;
      text-transform: uppercase;
    }
    .reference-summary strong {
      display: block;
      margin: 8px 0;
      color: #0f172a;
      font-size: 19px;
    }
    .reference-summary p {
      margin: 0;
      color: #64748b;
      line-height: 1.6;
    }
    .specs-table-wrap {
      overflow-x: auto;
    }
    .specs-table caption {
      padding: 0 0 12px;
      color: #475569;
      font-weight: 700;
      text-align: left;
    }
    .specs-table th {
      text-align: left;
    }
    .specs-table small {
      display: block;
      margin-top: 4px;
      color: #64748b;
      font-weight: 400;
    }
    .decision-list {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 14px;
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .decision-list li {
      position: relative;
      padding: 20px 20px 20px 48px;
      border: 1px solid #dbe3ee;
      border-radius: 12px;
      color: #1e293b;
      font-weight: 650;
    }
    .decision-list li::before {
      position: absolute;
      top: 20px;
      left: 20px;
      content: '✓';
      color: #2563eb;
      font-weight: 900;
    }
    .workflow-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
    }
    .workflow-grid h3 {
      margin: 12px 0 0;
      color: #1e293b;
      font-size: 18px;
      line-height: 1.45;
    }
    .documents-panel {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 32px;
      margin-top: 30px;
      background: #f8fafc;
    }
    .documents-panel h3 {
      margin-top: 0;
      color: #0f172a;
    }
    .documents-panel li,
    .documents-panel p {
      color: #475569;
      line-height: 1.65;
    }
    .documents-panel__actions {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 10px;
      min-width: 280px;
    }
    .catalog-disclaimer { max-width: 760px; margin: 0 0 18px; color: #64748b; font-size: 14px; line-height: 1.6; }
    .related-card__body h3 {
      margin: 0 0 8px;
      color: #0f172a;
      font-size: 20px;
    }
    .related-card__body span {
      color: #2563eb;
      font-size: 14px;
      font-weight: 700;
    }
    @media (max-width: 768px) {
      .product-intro {
        grid-template-columns: 1fr;
        gap: 1.25rem;
      }
      .product-hero__name { font-size: 34px; }
      .product-workflow { font-size: 16px; line-height: 1.6; margin-block: 12px 18px; }
      .product-features { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
      .product-features li { padding: 12px; font-size: 14px; }
      .product-intro__photo img { max-height: 320px; }
      .product-hero__btns { flex-direction: row; flex-wrap: wrap; }
      .product-hero__btns .btn { padding: 12px 14px; font-size: 14px; }
      .reference-summary,
      .decision-list,
      .workflow-grid,
      .documents-panel {
        grid-template-columns: 1fr;
      }
      .decision-section {
        padding-block: 32px;
      }
      .documents-panel__actions {
        min-width: 0;
      }
      :global(#product-guides) {
        scroll-margin-top: calc(var(--nav-height) + 5rem);
      }
    }
  </style>
</BaseLayout>
