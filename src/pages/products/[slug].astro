---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products
    .filter(p => !p.data.draft)
    .map(p => ({
      params: { slug: p.id.replace(/\.md$/, '') },
      props: { product: p },
    }));
}

const { product } = Astro.props;
const data = product.data;
const specs = data.specifications || {};
const model = data.title.split(' ')[0];
const category = data.category || 'ARC Equipment';
const heightVal = specs['Archived Height Class'] || specs['Archived Sheet Thickness'] || 'Project review';
const loadVal = specs['Archived Payload Class'] || specs['Load Basis'] || specs['Material Boundary'] || 'Project review';
const platformVal = specs['Platform Envelope'] || specs['Forming-Line Interface'] || specs['Line Interface'] || 'Project review';
const weightVal = specs['Final Confirmation'] || 'Signed project documents';
const quoteUrl = `/contact/?product=${encodeURIComponent(model)}`;
const datasheetUrl = `/contact/?product=${encodeURIComponent(model)}&request=datasheet`;

const allProducts = await getCollection('products');
const sameCat = allProducts.filter(p => p.id !== product.id && !p.data.draft && p.data.category === data.category);
const others = allProducts.filter(p => p.id !== product.id && !p.data.draft && p.data.category !== data.category);
const related = [...sameCat, ...others].slice(0, 3);
const { Content } = await render(product);

const applications = category.includes('Ceiling')
  ? [
      ['Steel-Building Ceilings', 'Large-span ceiling panels, insulation and service installation.'],
      ['Warehouses & Industrial Buildings', 'High-bay lighting, HVAC, sprinkler and overhead maintenance after project review.'],
      ['Stadium & Terminal', 'Large indoor spaces after floor-load and access-route verification.'],
      ['Wall & Facade Panels', 'Extended deck layouts for crew, tools and panel positioning.'],
    ]
  : category.includes('Roll Forming Machines')
    ? [
        ['Roof Profiles', 'Standing seam and trapezoidal profiles matched to approved drawings.'],
        ['Wall Cladding', 'Profile-specific tooling for wall and facade sheets.'],
        ['Ground-Level Production', 'Profile-specific production with a reviewed material and run-out workflow.'],
        ['Lift Integration', 'A compact line configured for a compatible lifting platform.'],
      ]
    : [
        ['Industrial Roofing', 'Form long roof panels close to the installation elevation.'],
        ['Warehouses & Factories', 'Reduce repeated ground handling on large steel-building roofs.'],
        ['Hangars & Workshops', 'Support long-panel projects with constrained crane access.'],
        ['Wall Cladding', 'Adapted workflow for long vertical facade panels where engineered.'],
      ];

function visualAlt(url: string): string {
  const labels: Array<[string, string]> = [
    ['hero-2.webp', 'Editorial roof-level panel-forming workflow in an industrial building'],
    ['truck-site-roll-forming-lift.webp', 'Editorial truck-mounted equipment arrangement at a project site'],
    ['40hq-logistics-checkpoints.svg', 'Editorial diagram of container logistics review checkpoints'],
    ['port-loading-logistics.webp', 'Editorial port handling and logistics planning scene'],
    ['crawler-truck-selection-matrix.svg', 'Editorial crawler and truck configuration selection diagram'],
    ['roof-level-workflow.svg', 'Editorial roof-level roll-forming workflow diagram'],
    ['roll-forming-input-map.svg', 'Editorial roll-forming project input diagram'],
    ['large-deck-steel-structure.webp', 'Editorial large-deck platform arrangement in a steel structure'],
    ['ceiling-platform-underside.webp', 'Editorial underside work context for a large-deck platform'],
    ['ceiling-platform-project-data.svg', 'Editorial ceiling-platform project data checklist'],
  ];
  return labels.find(([suffix]) => url.endsWith(suffix))?.[1]
    || 'Representative editorial equipment-planning visual';
}

type ProductCardSpec = { label: string; value: string };

function getProductCardSpecs(
  productCategory: string,
  productSpecs: Record<string, unknown>,
): ProductCardSpec[] {
  const value = (key: string) => String(productSpecs[key] || 'Project review');

  if (productCategory === 'Crawler Ceiling Platforms') {
    return [
      { label: 'Archived height', value: value('Archived Height Class') },
      { label: 'Load basis', value: value('Load Basis') },
      { label: 'Platform envelope', value: value('Platform Envelope') },
    ];
  }

  if (productCategory === 'Roll Forming Machines') {
    return [
      { label: 'Sheet thickness', value: value('Archived Sheet Thickness') },
      { label: 'Material boundary', value: value('Material Boundary') },
      { label: 'Line interface', value: value('Line Interface') },
    ];
  }

  if (productCategory === 'Truck-Mounted Roll Forming Lifts' && (
    productSpecs['Archived Container Route'] || productSpecs['Container Checks']
  )) {
    return [
      { label: 'Archived height', value: value('Archived Height Class') },
      { label: 'Packing route', value: value('Archived Container Route') },
      { label: 'Container checks', value: value('Container Checks') },
    ];
  }

  return [
    { label: 'Archived height', value: value('Archived Height Class') },
    { label: 'Archived payload', value: value('Archived Payload Class') },
    { label: 'Sheet thickness', value: value('Archived Sheet Thickness') },
  ];
}

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: data.title,
  description: data.description,
  about: {
    '@type': 'Thing',
    name: `${model} archived reference configuration`,
    description: 'Planning reference only. Final configuration requires the signed technical schedule and approved drawings.',
  },
};
---

<BaseLayout title={data.title} description={data.description} ogImage={data.images?.[0]} transparentNav={false}>
  <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />

  {data.faq && data.faq.length > 0 && (
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: data.faq.map(item => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer },
      })),
    })} />
  )}

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: 'Products', item: new URL('/products/', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: data.title },
    ],
  })} />

  <div class="bread">
    <a href="/">Home</a> / <a href="/products/">Products</a> / <span>{model}</span>
  </div>

  <section class="product-hero">
    <div class="product-hero__gallery">
      {data.images?.[0] ? (
        <div class="product-hero__main">
          <img id="product-main-image" src={data.images[0]} alt={visualAlt(data.images[0])} width="640" height="480" />
        </div>
      ) : (
        <div class="product-hero__main">{model}</div>
      )}
      {data.images && data.images.length > 1 && (
        <div class="product-hero__thumbs" aria-label="Product image gallery">
          {data.images.map((img: string, i: number) => (
            <button class:list={['product-hero__thumb', { active: i === 0 }]} type="button" data-src={img} data-alt={visualAlt(img)} aria-label={`Show editorial planning visual ${i + 1}`}>
              <img src={img} alt="" width="144" height="108" loading="lazy" />
            </button>
          ))}
        </div>
      )}
      <p class="field-note">Representative editorial image — not model-specific evidence. Final configuration requires the signed technical schedule and approved drawings.</p>
    </div>

    <div class="product-hero__info">
      <div class="product-hero__tag">{category}</div>
      <h1 class="product-hero__name">{model}</h1>
      <p class="product-hero__sub">{data.title.split(' - ')[1] || category}</p>
      <div class="product-hero__price">Price on Request <span>after configuration review</span></div>
      <p class="verification-note"><strong>Archived reference configuration:</strong> every numeric class and interface remains subject to project-specific confirmation in the signed technical schedule, approved drawings and approved load chart.</p>
      <div class="specs-mini">
        <div class="spec-mini"><div class="spec-mini__label">Archived Height / Material</div><div class="spec-mini__val">{heightVal}</div></div>
        <div class="spec-mini"><div class="spec-mini__label">Archived Load / Boundary</div><div class="spec-mini__val">{loadVal}</div></div>
        <div class="spec-mini"><div class="spec-mini__label">Reference Interface</div><div class="spec-mini__val">{platformVal}</div></div>
        <div class="spec-mini"><div class="spec-mini__label">Confirmation Gate</div><div class="spec-mini__val">{weightVal}</div></div>
      </div>
      <div class="product-hero__btns">
        <a href={quoteUrl} class="btn btn--primary">Get a Quote →</a>
        <a href={datasheetUrl} class="btn btn--outline-blue">Request Datasheet</a>
      </div>
    </div>
  </section>

  <p class="tabs__hint">Swipe horizontally to view all sections on smaller screens.</p>
  <div class="tabs" role="tablist" aria-label="Product reference sections">
    <button class="tab active" data-tab="0">Overview</button>
    <button class="tab" data-tab="1">Specifications</button>
    <button class="tab" data-tab="2">Features</button>
    <button class="tab" data-tab="3">Applications</button>
  </div>

  <div class="tab-content">
    <div class="tab-panel active">
      <div style="font-size:16px;color:#475569;line-height:1.8;"><Content /></div>
    </div>

    <div class="tab-panel">
      <p class="verification-note">Values below are archived or historical website references. Use only the signed technical schedule, approved drawings and approved load chart for procurement, tender submission or lift planning.</p>
      <table class="specs-table">
        <tbody>
          {Object.entries(specs).map(([key, value]) => <tr><td>{key}</td><td>{value}</td></tr>)}
        </tbody>
      </table>
    </div>

    <div class="tab-panel">
      <div class="features-grid">
        {data.features?.map((feature: string) => {
          const parts = feature.split('—');
          return (
            <div class="feature">
              <div class="feature__icon">◆</div>
              <div>
                <div class="feature__title">{parts[0]?.trim() || feature}</div>
                <div class="feature__desc">{parts.slice(1).join('—').trim()}</div>
              </div>
            </div>
          );
        })}
      </div>
    </div>

    <div class="tab-panel">
      <p style="font-size:16px;color:#475569;line-height:1.8;margin-bottom:24px;">Typical applications for the {model}. Every site requires verification of ground or floor bearing, access route, clearance, wind, load, rescue plan and local rules.</p>
      <div class="app-cards">
        {applications.map(([title, description]) => (
          <div class="app-card"><div class="app-card__icon">▦</div><h4>{title}</h4><p>{description}</p></div>
        ))}
      </div>
    </div>
  </div>

  {data.faq && data.faq.length > 0 && (
    <section class="sec sec--gray">
      <div class="sec__header">
        <div class="sec__overline">Buyer Questions</div>
        <h2 class="sec__title">{model} FAQ</h2>
      </div>
      <div class="faq-grid">
        {data.faq.map(item => <div class="faq-item"><h3>{item.question}</h3><p>{item.answer}</p></div>)}
      </div>
    </section>
  )}

  <section class="cta">
    <h2>CONFIGURE THE {model}</h2>
    <p>Send the eave or ceiling height, panel profile, material, site conditions, destination and transport constraints for an engineering review.</p>
    <a href={quoteUrl} class="btn--white">Request a Project Review →</a>
  </section>

  <section class="sec">
    <div class="sec__header reveal">
      <div class="sec__overline">Related Products</div>
      <h2 class="sec__title">OTHER MODELS</h2>
    </div>
    <div class="related">
      {related.map(rp => {
        const rSpecs = rp.data.specifications || {};
        const rModel = rp.data.title.split(' ')[0];
        const relatedSpecs = getProductCardSpecs(
          rp.data.category || 'ARC Equipment',
          rSpecs,
        );
        return (
          <a href={`/products/${rp.id}/`} class="related-card reveal">
            {rp.data.images?.[0] ? (
              <div class="related-card__img" style={`background-image:url('${rp.data.images[0]}');background-size:contain;background-position:center;background-repeat:no-repeat;`}></div>
            ) : (
              <div class="related-card__img">{rModel}</div>
            )}
            <div class="related-card__body">
              <h4>{rModel}</h4>
              <p>{relatedSpecs.map(spec => `${spec.label}: ${spec.value}`).join(' · ')}</p>
              <span style="color:#2563eb;font-weight:600;font-size:14px;">View Details →</span>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <style>
    .product-hero__main img,
    .product-hero__thumb img {
      object-fit: contain;
      background: #f8fafc;
    }
    .tabs__hint {
      display: none;
      max-width: var(--max-w);
      margin: 0 auto;
      padding: 0 var(--section-px) 8px;
      color: #64748b;
      font-size: 12px;
    }
    @media (max-width: 768px) {
      .tabs__hint { display: block; }
    }
  </style>

  <script>
    document.querySelectorAll('.tab').forEach(tab => {
      tab.addEventListener('click', () => {
        const n = Number(tab.getAttribute('data-tab') || 0);
        document.querySelectorAll('.tab').forEach((item, i) => item.classList.toggle('active', i === n));
        document.querySelectorAll('.tab-panel').forEach((panel, i) => panel.classList.toggle('active', i === n));
      });
    });

    const mainImage = document.getElementById('product-main-image') as HTMLImageElement | null;
    document.querySelectorAll<HTMLButtonElement>('.product-hero__thumb').forEach(thumb => {
      thumb.addEventListener('click', () => {
        const src = thumb.dataset.src;
        if (mainImage && src) {
          mainImage.src = src;
          mainImage.alt = thumb.dataset.alt || 'Representative editorial equipment-planning visual';
        }
        document.querySelectorAll('.product-hero__thumb').forEach(item => item.classList.remove('active'));
        thumb.classList.add('active');
      });
    });
  </script>
</BaseLayout>
