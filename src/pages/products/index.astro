---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PRODUCT_FAMILIES, PRODUCT_REFERENCES, buildProductView } from '../../lib/product-selection';
import { getCollection } from 'astro:content';

const allProducts = (await getCollection('products')).filter(product => !product.data.draft);
const productsBySlug = new Map(allProducts.map(product => [product.id, product]));
const familySections = PRODUCT_FAMILIES.map(family => ({
  ...family,
  references: PRODUCT_REFERENCES
    .filter(reference => reference.familyId === family.id)
    .map(reference => {
      const product = productsBySlug.get(reference.slug);
      if (!product) throw new Error(`Missing public product entry: ${reference.slug}`);
      const view = buildProductView(product);
      if (!view) throw new Error(`Missing public product view: ${reference.slug}`);
      return { ...view, product };
    }),
}));
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'ARCLIFT equipment reference index',
  itemListElement: PRODUCT_REFERENCES.map((reference, position) => ({
    '@type': 'ListItem',
    position: position + 1,
    item: {
      '@type': 'WebPage',
      name: `${reference.model} reference page`,
      url: new URL(`/products/${reference.slug}/`, Astro.url).href,
    },
  })),
};
---

<BaseLayout
  title="Products — Project selection for roll-forming and access workflows"
  description="Start an ARCLIFT project review by choosing an equipment family, preparing the relevant site inputs and opening retained reference pages."
  transparentNav={false}
>
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />

  <section class="selector-hero">
    <div class="selector-hero__inner">
      <p class="eyebrow">Product selection</p>
      <h1>Start with the project workflow, then open the right references.</h1>
      <p>Choose the equipment family that matches the work route. These pages organize early discussions; a documented project review confirms the final configuration.</p>
      <a class="btn btn--primary" href="#families">Explore four equipment families</a>
    </div>
  </section>

  <section class="inputs" aria-labelledby="inputs-title">
    <div class="inputs__intro">
      <p class="eyebrow">Before you compare</p>
      <h2 id="inputs-title">Prepare these inputs</h2>
      <p>Bring the project facts that change the work route, interfaces and required documentation.</p>
    </div>
    <div class="inputs__grid">
      {familySections.map(family => (
        <article class="input-card">
          <h3>{family.shortName}</h3>
          <ul>
            {family.projectInputs.map(input => <li>{input}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <nav class="family-nav" aria-label="Equipment families">
    {familySections.map(family => <a href={`#${family.anchor}`}>{family.shortName}</a>)}
  </nav>

  <section id="families" class="families" aria-labelledby="families-title">
    <div class="families__heading">
      <p class="eyebrow">Select a family</p>
      <h2 id="families-title">Four routes for a documented project review</h2>
    </div>

    {familySections.map(family => (
      <section class="family-section" id={family.anchor}>
        <div class="family-card">
          <div class="family-card__image-wrap">
            <img class="family-card__image" src={family.editorialImage} alt={family.editorialAlt} loading="lazy" />
            <p class="image-disclosure">AI-assisted editorial visual. Editorial planning visual — not model-specific evidence</p>
          </div>
          <div class="family-card__content">
            <p class="eyebrow">{family.category}</p>
            <h2>{family.name}</h2>
            <p>{family.workflow}</p>
            <div class="family-card__columns">
              <div>
                <h3>Review these workflows</h3>
                <ul>
                  {family.workflowsToAssess.map(workflow => <li>{workflow}</li>)}
                </ul>
              </div>
              <div>
                <h3>Bring these documents</h3>
                <ul>
                  {family.requiredDocuments.map(document => <li>{document}</li>)}
                </ul>
              </div>
            </div>
          </div>
        </div>

        <div class="reference-heading">
          <div>
            <p class="eyebrow">Retained references</p>
            <h3>{family.references.length} detail {family.references.length === 1 ? 'page' : 'pages'} for this family</h3>
          </div>
          <p>Open an ordinary detail link for the archived or conceptual reference context before adding it to a comparison.</p>
        </div>
        <div class="reference-grid">
          {family.references.map(reference => (
            <article class="reference-card">
              <figure class="reference-card__visual">
                <img src={reference.product.data.images?.[0] ?? reference.family.editorialImage} alt={reference.family.editorialAlt} loading="lazy" />
                <figcaption class="reference-card__disclosure">AI-assisted editorial visual. {reference.imageDisclosure}</figcaption>
              </figure>
              <div class="reference-card__topline">
                <p>{reference.model}</p>
                <span class="status-badge">{reference.status}</span>
              </div>
              <p class="status-note">{reference.statusNote}</p>
              <p>{reference.scopeStatement}</p>
              <p class="reference-orientation"><strong>{reference.orientation.label}:</strong> {reference.orientation.value}</p>
              <p class="reference-gate"><strong>Project confirmation required:</strong> {reference.confirmationGate}</p>
              <p class="buyer-question">{reference.buyerQuestion}</p>
              <a class="detail-link" href={`/products/${reference.slug}/`}>Open {reference.model} reference details <span aria-hidden="true">→</span></a>
              <label class="compare-choice">
                <input type="checkbox" value={reference.slug} data-compare-item />
                <span>Add {reference.model} to comparison</span>
              </label>
            </article>
          ))}
        </div>
      </section>
    ))}
  </section>

  <section class="comparison" aria-labelledby="comparison-title">
    <div>
      <p class="eyebrow">Progressive comparison</p>
      <h2 id="comparison-title">Compare selected references when their project inputs are ready.</h2>
      <p id="compare-summary" aria-live="polite">No references selected. Choose up to four references.</p>
    </div>
    <button type="button" class="compare-button" data-compare-button disabled>Compare selected</button>
  </section>

  <section class="cta">
    <h2>READY TO ORGANIZE A PROJECT REVIEW?</h2>
    <p>Send the work zones, drawings, route conditions and documentation available for the selected workflow.</p>
    <a href="/contact/" class="btn--white">Request a Project Review →</a>
  </section>

  <script>
    const compareItems = Array.from(document.querySelectorAll<HTMLInputElement>('[data-compare-item]'));
    const compareButton = document.querySelector<HTMLButtonElement>('[data-compare-button]');
    const compareSummary = document.querySelector<HTMLElement>('#compare-summary');

    function selectedReferences() {
      return compareItems.filter(item => item.checked).map(item => item.value).slice(0, 4);
    }

    function updateComparison() {
      const selected = selectedReferences();
      for (const item of compareItems) item.disabled = !item.checked && selected.length >= 4;
      if (compareButton) compareButton.disabled = selected.length === 0;
      if (compareSummary) {
        compareSummary.textContent = selected.length
          ? `${selected.length} reference${selected.length === 1 ? '' : 's'} selected. You can compare up to four.`
          : 'No references selected. Choose up to four references.';
      }
    }

    compareItems.forEach(item => item.addEventListener('change', updateComparison));
    compareButton?.addEventListener('click', () => {
      const selected = selectedReferences();
      if (selected.length) window.location.assign(`/compare/?items=${encodeURIComponent(selected.join(','))}`);
    });
    updateComparison();
  </script>

  <style>
    .selector-hero { background: #10233c; color: white; padding: clamp(4rem, 10vw, 7rem) 1.5rem; }
    .selector-hero__inner, .inputs, .families, .comparison { max-width: 1180px; margin: 0 auto; }
    .selector-hero__inner { max-width: 800px; }
    .selector-hero h1 { max-width: 760px; font-size: clamp(2.3rem, 5vw, 4.7rem); line-height: 1.02; margin: .4rem 0 1.2rem; }
    .selector-hero p { max-width: 690px; font-size: 1.12rem; line-height: 1.7; color: #dbeafe; }
    .selector-hero .btn { display: inline-flex; margin-top: 1rem; min-height: 44px; align-items: center; }
    .eyebrow { margin: 0; color: #2563eb; font-size: .77rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
    .selector-hero .eyebrow { color: #93c5fd; }
    .inputs { padding: 4.5rem 1.5rem 2rem; }
    .inputs__intro { max-width: 650px; }
    .inputs h2, .families h2, .comparison h2 { margin: .35rem 0 .8rem; color: #10233c; font-size: clamp(1.7rem, 3vw, 2.5rem); line-height: 1.12; }
    .inputs__intro > p:last-child, .reference-heading > p, .comparison p { color: #526273; line-height: 1.65; }
    .inputs__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; margin-top: 1.5rem; }
    .input-card, .reference-card { border: 1px solid #d9e2ec; border-radius: 14px; background: #fff; }
    .input-card { padding: 1.2rem; }
    .input-card h3 { margin: 0; color: #10233c; font-size: 1rem; }
    .input-card ul, .family-card ul { margin: .8rem 0 0; padding-left: 1.1rem; color: #526273; line-height: 1.55; }
    .family-nav { display: flex; flex-wrap: wrap; gap: .7rem; justify-content: center; padding: 1.5rem; border-block: 1px solid #e2e8f0; }
    .family-nav a { align-items: center; border: 1px solid #cbd5e1; border-radius: 999px; color: #16345a; display: inline-flex; min-height: 44px; padding: 0 .9rem; text-decoration: none; font-weight: 700; }
    .family-nav a:hover { background: #eff6ff; border-color: #2563eb; }
    .families { padding: 4.5rem 1.5rem; }
    .families__heading { max-width: 700px; }
    .family-section { margin-top: 3.75rem; scroll-margin-top: 1rem; }
    .family-card { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); border: 1px solid #d9e2ec; border-radius: 18px; overflow: hidden; background: #fff; }
    .family-card__image-wrap { background: #f1f5f9; }
    .family-card__image { width: 100%; aspect-ratio: 4 / 3; object-fit: contain; display: block; }
    .image-disclosure { margin: 0; padding: .7rem 1rem; background: #e8eef5; color: #334e68; font-size: .82rem; line-height: 1.45; }
    .family-card__content { padding: clamp(1.4rem, 3vw, 2.5rem); }
    .family-card__content > p:not(.eyebrow) { color: #475569; line-height: 1.65; }
    .family-card__columns { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.3rem; margin-top: 1.5rem; }
    .family-card__columns h3 { color: #10233c; font-size: .94rem; margin: 0; }
    .reference-heading { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, .9fr); align-items: end; gap: 1.5rem; margin: 1.7rem 0 1rem; }
    .reference-heading h3 { margin: .3rem 0 0; color: #10233c; }
    .reference-heading > p { margin: 0; }
    .reference-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
    .reference-card { display: flex; flex-direction: column; padding: 1.25rem; }`r`n    .reference-card__visual { margin: 0 0 1rem; background: #f1f5f9; }`r`n    .reference-card__visual img { aspect-ratio: 4 / 3; display: block; object-fit: contain; width: 100%; }`r`n    .reference-card__disclosure { color: #334e68; font-size: .78rem; line-height: 1.45; margin: 0; padding: .6rem .75rem; }`r`n    .reference-orientation, .reference-gate { font-size: .88rem; }
    .reference-card__topline { display: flex; align-items: start; justify-content: space-between; gap: .75rem; }
    .reference-card__topline p { color: #10233c; font-size: 1.15rem; font-weight: 800; margin: 0; }
    .status-badge { border-radius: 999px; background: #e8eef5; color: #294866; font-size: .72rem; font-weight: 800; padding: .35rem .55rem; white-space: nowrap; }
    .status-note { color: #1d4ed8; font-weight: 700; font-size: .84rem; margin: .75rem 0 .4rem; }
    .reference-card > p:not(.status-note) { color: #526273; line-height: 1.55; margin: .35rem 0; }
    .buyer-question { margin-bottom: 1rem !important; }
    .detail-link { color: #174f94; font-weight: 800; line-height: 1.45; margin-top: auto; min-height: 44px; display: flex; align-items: center; text-decoration: none; }
    .detail-link:hover { text-decoration: underline; }
    .compare-choice { display: flex; align-items: center; gap: .6rem; color: #334e68; cursor: pointer; font-size: .9rem; font-weight: 700; min-height: 44px; margin-top: .4rem; }
    .compare-choice input { width: 1.1rem; height: 1.1rem; flex: 0 0 auto; }
    .comparison { align-items: center; background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 18px; display: flex; justify-content: space-between; gap: 1.5rem; margin-bottom: 4.5rem; padding: clamp(1.5rem, 4vw, 2.5rem); }
    .comparison h2 { font-size: clamp(1.4rem, 2.8vw, 2rem); }
    .comparison p { margin-bottom: 0; }
    .compare-button { background: #174f94; border: 0; border-radius: 8px; color: white; cursor: pointer; flex: 0 0 auto; font: inherit; font-weight: 800; min-height: 44px; padding: 0 1.1rem; }
    .compare-button:disabled { background: #94a3b8; cursor: not-allowed; }
    :global(a:focus-visible), :global(button:focus-visible), :global(input:focus-visible) { outline: 3px solid #f59e0b; outline-offset: 3px; }
    @media (max-width: 900px) { .inputs__grid, .reference-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @media (max-width: 720px) { .family-card, .reference-heading, .comparison { grid-template-columns: 1fr; display: grid; } .family-card__columns { grid-template-columns: 1fr; } .inputs__grid, .reference-grid { grid-template-columns: 1fr; } .comparison { align-items: start; } .compare-button { width: 100%; } }
  </style>
</BaseLayout>
