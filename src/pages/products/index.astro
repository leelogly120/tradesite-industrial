---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allProducts = (await getCollection('products'))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const craneProducts = allProducts.filter(p => p.data.category === 'Aerial Work Platforms');
---

<BaseLayout
  title="Products — Crawler Under-Ceiling Platforms"
  description="FDDPT series crawler under-ceiling aerial work platforms: 20m, 25m, 31m, 35m models. Pick & carry, dual power, remote control."
  transparentNav={false}
>

  <!-- HERO BANNER -->
  <section class="hero-banner">
    <div class="overline">Products</div>
    <h1>FDDPT SERIES</h1>
    <p>Pick & carry aerial platforms engineered for maximum productivity on ceiling projects. From 20m compact to 35m flagship.</p>
  </section>

  <!-- PRODUCTS LIST -->
  <section class="sec">
    <div class="products-list">
      {craneProducts.sort((a, b) => {
        const aH = parseInt(a.data.specifications?.['Max Working Height'] || '0');
        const bH = parseInt(b.data.specifications?.['Max Working Height'] || '0');
        return aH - bH;
      }).map(p => {
        const specs = p.data.specifications || {};
        const isFlagship = p.data.title.includes('35M');
        return (
          <a href={`/products/${p.id}/`} class="p-card-list reveal">
            <div class="p-card-list__img">FDDPT-{specs['Max Working Height'] || ''}</div>
            <div class="p-card-list__body">
              <div class="p-card-list__tag">{isFlagship ? 'Flagship' : 'FDDPT'}</div>
              <div class="p-card-list__name">{p.data.title.split(' ')[0]}</div>
              <div class="p-card-list__specs">
                <span class="p-card-list__spec"><b>{specs['Max Working Height'] || '—'}</b> Reach</span>
                <span class="p-card-list__spec"><b>{specs['Safe Working Load'] || '—'}</b> Load</span>
                <span class="p-card-list__spec"><b>{specs['Machine Weight'] || '—'}</b> Weight</span>
                <span class="p-card-list__spec"><b>{specs['Platform Extension'] || specs['Platform Size (L×W)'] || '—'}</b> Platform</span>
              </div>
              <span class="btn btn--primary">View Details →</span>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <!-- CTA -->
  <section class="cta">
    <h2>NEED HELP CHOOSING THE RIGHT MODEL?</h2>
    <p>Our engineering team will recommend the best FDDPT for your project requirements.</p>
    <a href="/contact/" class="btn--white">Get a Free Consultation →</a>
  </section>
</BaseLayout>
