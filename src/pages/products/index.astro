---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PRODUCT_FAMILIES, PRODUCT_REFERENCES, buildProductView } from '../../lib/product-selection';
import { EQUIPMENT_CATALOG, RELATED_FORMING_EQUIPMENT } from '../../lib/equipment-catalog';
import { getCollection } from 'astro:content';

const allProducts = (await getCollection('products')).filter(product => !product.data.draft);
const productsBySlug = new Map(allProducts.map(product => [product.id, product]));
const referencesByFamily = new Map<string, NonNullable<ReturnType<typeof buildProductView>>[]>(PRODUCT_FAMILIES.map(family => [family.id, PRODUCT_REFERENCES
  .filter(reference => reference.familyId === family.id)
  .map(reference => {
    const product = productsBySlug.get(reference.slug);
    if (!product) throw new Error(`Missing public product entry: ${reference.slug}`);
    const view = buildProductView(product);
    if (!view) throw new Error(`Missing public product view: ${reference.slug}`);
    return view;
  })]));
const familySections = [...EQUIPMENT_CATALOG, RELATED_FORMING_EQUIPMENT].map(equipment => ({
  ...equipment,
  references: equipment.referenceFamilyId ? referencesByFamily.get(equipment.referenceFamilyId) ?? [] : [],
  quoteUrl: `/contact/?product=${equipment.id === 'roll-forming-machines' ? 'ARC-RF8' : equipment.id}&request=quote`,
}));
const itemListSchema = {
  '@context': 'https://schema.org', '@type': 'ItemList', name: 'ARCLIFT catalog model index',
  itemListElement: PRODUCT_REFERENCES.map((reference, position) => ({
    '@type': 'ListItem', position: position + 1,
    item: { '@type': 'WebPage', name: `${reference.model} catalog page`, url: new URL(`/products/${reference.slug}/`, Astro.url).href },
  })),
};
---

<BaseLayout title="Roof Panel Roll Former Lift Platforms — Truck & Crawler" description="Compare ARCLIFT truck-mounted and crawler roof-panel roll former lift platforms and large-deck work platforms. Height-class catalog references with an RFQ path." transparentNav={false}>
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  <section class="catalog-intro catalog-shell">
    <div class="catalog-intro__copy">
      <p class="eyebrow">ARCLIFT equipment</p>
      <h1>Roof panel roll former lifts<br />and large work platforms.</h1>
      <p>Raise a compatible roof-panel or standing-seam roll former for roof-level production, or position a large working deck for ceiling and wall installation. Pick a height class below, then request a quote with your site and machine data.</p>
      <a class="catalog-link" href="/contact/?request=quote">Request a quote →</a>
    </div>
    <figure class="catalog-intro__photo" data-catalog-photo>
      <img src="/images/equipment/coil-real-handling.webp" width="593" height="411" alt="Elevated roof-forming equipment beside a steel-frame building, with sheet output extending to the right" fetchpriority="high" />
      <figcaption>Elevated forming-equipment setup beside building steelwork.</figcaption>
    </figure>
  </section>
  <nav id="equipment-routes" class="family-nav catalog-shell" aria-label="Equipment families">
    {EQUIPMENT_CATALOG.map(equipment => <a href={`#${equipment.id}`}>{equipment.shortName}</a>)}
  </nav>
  <section class="comparison" aria-labelledby="comparison-title">
    <div><h2 id="comparison-title">Compare selected references</h2><p id="compare-summary" aria-live="polite">No references selected. Choose up to four references.</p></div>
    <button type="button" class="compare-button" data-compare-button disabled>Compare selected</button>
  </section>
  <div id="families" class="catalog-shell families">
    <aside class="family-reference-boundary">
      <strong>About these catalog models</strong>
      <p>Model codes and height classes below are catalog references for selection and RFQ. They describe equipment families ARCLIFT supplies. Platform load, transport size, and chassis inclusion are confirmed in the quotation package (technical schedule, approved drawings, and applicable load chart). Photographs show equipment families and working contexts, not individual ARC models.</p>
    </aside>
    {familySections.map((family, index) => (
      <section class:list={['family-section', { 'family-section--related': index === 4 }]} id={family.id}>
        <div class="family-card">
          <div class="family-card__content">
            <p class="eyebrow">{index === 4 ? 'Related equipment' : `Equipment ${String(index + 1).padStart(2, '0')}`}</p>
            <h2>{family.name}</h2>
            <p>{family.description}</p>
            <ul class="equipment-features" data-equipment-features>{family.features.map(feature => <li>{feature}</li>)}</ul>
            <a class="catalog-button" href={family.quoteUrl}>Request a quote →</a>
          </div>
          <figure class="family-card__photo" data-equipment-photo>
            <img src={family.image.src} width={family.image.width} height={family.image.height} alt={family.image.alt} loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'auto'} />
            <figcaption>{family.image.caption}</figcaption>
          </figure>
        </div>
        {family.references.length > 0 ? (
          <div class="reference-grid" aria-label={`${family.name} model references`}>
            {family.references.map(reference => (
              <article class="reference-card">
                <div class="reference-card__topline"><strong>{reference.model}</strong><span class="status-badge">{reference.status}</span></div>
                <p class="reference-orientation"><span>{reference.orientation.label}:</span> {reference.orientation.value}</p>
                {reference.confirmationGate.includes('packing plan') && <p class="reference-gate">40HQ route requires project-specific packing confirmation.</p>}
                <a class="detail-link" href={`/products/${reference.slug}/`}>View {reference.model} details <span aria-hidden="true">→</span></a>
                <label class="compare-choice"><input type="checkbox" value={reference.slug} data-compare-item /><span>Compare {reference.model}</span></label>
              </article>
            ))}
          </div>
        ) : (
          <p class="configuration-note">Discuss deck layout, truck chassis, and the installation task together. Quoted per project. This route has no separate ARC model reference in the catalogue.</p>
        )}
      </section>
    ))}
  </div>
  <section id="product-inputs" class="catalog-shell inputs">
    <div><p class="eyebrow">Start a useful conversation</p><h2>Prepare these inputs</h2><p>Send the eight RFQ inputs: building or work height, panel profile, machine mass, coil data, site access, chassis included yes or no, destination, and timeline. We use these details to define the equipment and supply scope.</p></div>
    <a class="catalog-button" href="/contact/?request=quote">Request a quote →</a>
  </section>
  <script>
    const compareItems = Array.from(document.querySelectorAll<HTMLInputElement>('[data-compare-item]'));
    const compareButton = document.querySelector<HTMLButtonElement>('[data-compare-button]');
    const compareSummary = document.querySelector<HTMLElement>('#compare-summary');
    const comparison = document.querySelector<HTMLElement>('.comparison');
    function measureComparison() {
      const height = comparison && getComputedStyle(comparison).position === 'sticky' ? comparison.getBoundingClientRect().height : 0;
      document.documentElement.style.setProperty('--comparison-offset', `${height}px`);
    }
    function selectedReferences() { return compareItems.filter(item => item.checked).map(item => item.value).slice(0, 4); }
    function updateComparison() {
      const selected = selectedReferences();
      comparison?.classList.toggle('comparison--active', selected.length > 0);
      for (const item of compareItems) item.disabled = !item.checked && selected.length >= 4;
      if (compareButton) compareButton.disabled = selected.length === 0;
      if (compareSummary) compareSummary.textContent = selected.length ? `${selected.length} reference${selected.length === 1 ? '' : 's'} selected. You can compare up to four.` : 'No references selected. Choose up to four references.';
      measureComparison();
    }
    if (comparison && 'ResizeObserver' in window) new ResizeObserver(measureComparison).observe(comparison);
    window.addEventListener('resize', measureComparison, { passive: true });
    compareItems.forEach(item => item.addEventListener('change', updateComparison));
    compareButton?.addEventListener('click', () => {
      const selected = selectedReferences();
      if (selected.length) window.location.assign(`/compare/?items=${encodeURIComponent(selected.join(','))}`);
    });
    updateComparison();
  </script>
  <style>
    .catalog-shell { width: min(1180px, calc(100% - 64px)); margin-inline: auto; }
    .catalog-intro { display: grid; grid-template-columns: 1.1fr 1fr; gap: 40px; align-items: center; padding-block: calc(var(--nav-height) + 40px) 30px; }
    .catalog-intro__copy { min-width: 0; }
    .catalog-intro__photo { min-width: 0; margin: 0; background: #eaf0f3; }
    .catalog-intro__photo img { display: block; width: 100%; height: auto; max-height: 370px; object-fit: contain; }
    .catalog-intro__photo figcaption { padding: 10px 14px; color: #526570; font-size: 13px; line-height: 1.5; }
    .eyebrow { margin: 0 0 10px; color: #a4411c; font-size: 13px; font-weight: 700; letter-spacing: .09em; text-transform: uppercase; }
    h1 { margin: 0 0 18px; color: #123b50; font-size: clamp(36px, 4.1vw, 58px); line-height: 1.04; letter-spacing: -.035em; }
    .catalog-intro__copy > p:not(.eyebrow) { margin-bottom: 14px; color: #526570; font-size: 18px; line-height: 1.6; }
    .catalog-link { color: #123b50; font-size: 16px; font-weight: 700; display: inline-flex; min-height: 44px; align-items: center; }
    .family-nav { display: flex; flex-wrap: wrap; gap: 10px; padding-block: 20px; border-block: 1px solid #c8d5dc; }
    .family-nav a { display: inline-flex; align-items: center; min-height: 46px; padding: 10px 16px; background: #eaf0f3; color: #123b50; text-decoration: none; font-weight: 650; }
    .family-nav a:hover { background: #dce7ed; }
    .comparison { max-width: 1180px; width: calc(100% - 64px); margin: 22px auto 0; padding: 16px 20px; display: flex; gap: 20px; align-items: center; justify-content: space-between; background: #f3f6f8; border: 1px solid #d2dde3; position: sticky; top: calc(var(--nav-height) + 8px); z-index: 8; }
    .comparison h2 { margin: 0 0 5px; color: #123b50; font-size: 18px; }
    .comparison p { margin: 0; font-size: 14px; color: #526570; line-height: 1.5; }
    .compare-button { min-height: 44px; flex-shrink: 0; padding: 10px 18px; background: #123b50; color: #fff; border: 0; font: inherit; font-weight: 700; cursor: pointer; }
    .compare-button:disabled { background: #d2dce2; color: #475966; cursor: not-allowed; }
    .family-reference-boundary { margin: 26px 0 0; padding: 0 0 0 16px; border-left: 3px solid #b4c7d1; color: #526570; font-size: 14px; line-height: 1.6; }
    .family-reference-boundary strong { color: #123b50; }
    .family-reference-boundary p { margin: 4px 0 0; }
    .family-section { padding-block: 48px; border-bottom: 1px solid #ccd8df; scroll-margin-top: calc(var(--nav-height) + 150px); }
    .family-card { display: grid; grid-template-columns: 1.12fr 1fr; gap: 40px; align-items: center; }
    .family-card__content, .family-card__photo { min-width: 0; }
    .family-card h2 { margin: 0 0 16px; color: #123b50; font-size: clamp(28px, 3vw, 40px); line-height: 1.12; letter-spacing: -.025em; }
    .family-card__content > p:not(.eyebrow) { color: #526570; font-size: 17px; line-height: 1.65; }
    .equipment-features { display: grid; grid-template-columns: 1fr 1fr; gap: 10px 20px; margin: 22px 0; padding: 0; list-style: none; }
    .equipment-features li { padding-left: 14px; border-left: 2px solid #b04b26; color: #123b50; font-size: 15px; line-height: 1.5; }
    .catalog-button { display: inline-flex; align-items: center; min-height: 48px; padding: 12px 20px; background: #123b50; color: #fff; text-decoration: none; font-weight: 700; }
    .catalog-button:hover { background: #20536b; }
    .family-card__photo { margin: 0; background: #eaf0f3; }
    .family-card__photo img { display: block; width: 100%; height: auto; max-height: 370px; object-fit: contain; }
    .family-card__photo figcaption { padding: 12px 16px; color: #526570; background: #f3f6f8; font-size: 13px; line-height: 1.5; }
    .reference-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin-top: 26px; }
    .reference-card { min-width: 0; overflow-wrap: anywhere; display: flex; flex-direction: column; padding: 16px 18px; background: #f7f9fa; border: 1px solid #d7e0e5; }
    .reference-card__topline { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; justify-content: space-between; color: #123b50; }
    .reference-card__topline strong { font-size: 18px; }
    .status-badge { color: #526570; font-size: 12px; }
    .reference-orientation, .reference-gate { color: #526570; font-size: 13px; line-height: 1.5; margin: 10px 0; }
    .reference-orientation span { font-weight: 700; }
    .detail-link { display: flex; gap: 10px; align-items: center; min-height: 44px; margin-top: auto; color: #123b50; font-weight: 700; text-decoration: none; }
    .detail-link:hover { text-decoration: underline; }
    .compare-choice { display: flex; align-items: center; gap: 9px; min-height: 44px; color: #526570; font-size: 14px; cursor: pointer; }
    .compare-choice input { width: 18px; height: 18px; accent-color: #123b50; }
    .configuration-note { max-width: 760px; margin: 20px 0 0; padding: 16px 20px; background: #f3f6f8; color: #526570; font-size: 15px; line-height: 1.6; }
    .family-section--related .family-card__photo img { max-height: 300px; }
    .inputs { display: flex; align-items: center; justify-content: space-between; gap: 40px; padding-block: 54px 64px; }
    .inputs > div { max-width: 760px; }
    .inputs h2 { margin: 0 0 12px; color: #123b50; font-size: 34px; }
    .inputs p:last-child { color: #526570; line-height: 1.65; }
    .inputs > a { flex-shrink: 0; }
    a:focus-visible, button:focus-visible, input:focus-visible { outline: 3px solid #c7592e; outline-offset: 4px; }
    @media (max-width: 850px) { .family-card { gap: 24px; } .equipment-features { grid-template-columns: 1fr; } .reference-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @media (max-width: 720px) {
      .catalog-shell { width: calc(100% - 40px); }
      .catalog-intro { grid-template-columns: 1fr; gap: 20px; padding-block: calc(var(--nav-height) + 24px) 20px; }
      .catalog-intro__copy > p:not(.eyebrow) { font-size: 16px; }
      .catalog-intro__photo img { max-height: 240px; }
      .family-nav { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
      .family-nav a { font-size: 14px; padding: 10px 12px; line-height: 1.4; }
      .family-card { grid-template-columns: 1fr; }
      .family-card__photo { order: 2; }
      .family-section { padding-block: 34px; scroll-margin-top: calc(var(--nav-height) + 20px); }
      .reference-grid { grid-template-columns: 1fr; margin-top: 16px; }
      .reference-card { padding: 14px 16px; }
      .reference-orientation { margin-block: 7px; }
      .reference-card__topline { gap: 6px; }
      .family-reference-boundary { font-size: 13px; }
      .comparison { position: static; width: calc(100% - 40px); padding: 12px; gap: 12px; }
      .comparison h2 { font-size: 15px; }
      .comparison p { font-size: 12px; }
      .compare-button { font-size: 13px; padding-inline: 12px; }
      .comparison--active { position: fixed; inset-inline: 12px; top: auto; bottom: 6rem; width: auto; margin: 0; z-index: 20; box-shadow: 0 12px 32px rgb(15 23 42 / 20%); }
      .inputs { display: block; padding-block: 38px 48px; }
      .inputs > a { margin-top: 18px; }
    }
  </style>
</BaseLayout>
