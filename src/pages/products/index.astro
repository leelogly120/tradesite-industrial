---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { buildProductView } from '../../lib/product-selection';
import { getCollection } from 'astro:content';

const allProducts = (await getCollection('products')).filter(p => !p.data.draft);

const CATEGORIES = [
  {
    id: 'crawler-roll-forming-lifts',
    name: 'Crawler Roll Forming Lifts',
    tagline: 'Crawler platforms configured to raise a complete roll forming line toward roof level. Archived source material covers reference lift heights from 17m to 32m; final power and chassis are project-specific.',
    banner: '/images/banners/category-crawler.webp',
  },
  {
    id: 'truck-mounted-roll-forming-lifts',
    name: 'Truck-Mounted Roll Forming Lifts',
    tagline: 'Truck-mounted forming systems with archived 12m–31m reference classes. Road registration, chassis, transport envelope and any 40HQ packing route require project review and approved data.',
    banner: '/images/banners/category-truck.webp',
  },
  {
    id: 'crawler-ceiling-platforms',
    name: 'Crawler Ceiling Platforms',
    tagline: 'Large-deck crawler platform concepts for under-ceiling and wall-panel crews. ARC-F pages are reference configurations pending model-specific engineering, approval photos and compliance documents.',
    banner: '/images/banners/category-ceiling.webp',
  },
  {
    id: 'roll-forming-machines',
    name: 'Roll Forming Machines',
    tagline: 'Compact standing-seam and trapezoidal panel lines matched to approved profile drawings, sheet thickness and the selected lift platform.',
    banner: '/images/banners/category-roll-former.webp',
  },
];

function productSortValue(value: unknown): number {
  const match = String(value ?? '').match(/(\d+(?:\.\d+)?)/);
  return match ? parseFloat(match[1]) : Number.POSITIVE_INFINITY;
}

function heightOf(p: any): number {
  return productSortValue(buildProductView(p)?.orientation.value);
}


const grouped = CATEGORIES.map(cat => ({
  ...cat,
  items: allProducts
    .filter(p => p.data.category === cat.name)
    .sort((a, b) => heightOf(a) - heightOf(b)),
}));
---

<BaseLayout
  title="Products — Roll Forming Lifts & Aerial Platforms"
  description="ARCLIFT archived reference configurations for crawler and truck roll-forming lifts, large-deck platforms and profile-specific roll-forming lines."
  transparentNav={false}
>

  <!-- HERO BANNER -->
  <section class="hero-banner" style="--banner-image:url('/images/banners/products.webp');--banner-position:center 58%;">
    <div class="overline">Products</div>
    <h1>ARC EQUIPMENT RANGE</h1>
    <p>Four equipment families for forming long panels near the installation elevation and supporting specialized ceiling or wall work.</p>
  </section>

  <!-- CATEGORY NAV -->
  <nav class="cat-nav" aria-label="Product categories">
    {CATEGORIES.map(cat => (
      <a href={`#${cat.id}`} class="cat-nav__link">{cat.name}</a>
    ))}
  </nav>

  <!-- CATEGORY SECTIONS -->
  {grouped.map(cat => (
    <section class="sec" id={cat.id}>
      <div class="sec__header reveal">
        <div class="sec__overline">{cat.items.length} {cat.items.length === 1 ? 'Model' : 'Models'}</div>
        <h2 class="sec__title">{cat.name.toUpperCase()}</h2>
        <p class="sec__desc">{cat.tagline}</p>
      </div>
      <div class="category-banner reveal" style={`background-image:url('${cat.banner}');`} role="img" aria-label={`${cat.name} operating scene`}></div>
      <div class="products-list">
        {cat.items.map(p => {
          const view = buildProductView(p);
          if (!view) throw new Error(`Unknown product reference: ${p.id}`);
          const model = view.model;
          return (
            <a href={`/products/${p.id}/`} class="p-card-list reveal">
              {p.data.images?.[0] ? (
                <div class="p-card-list__img" style={`background-image:url('${p.data.images[0]}');background-size:contain;background-position:center;background-repeat:no-repeat;`}>
                  <span class="sr-only">{model}</span>
                </div>
              ) : (
                <div class="p-card-list__img">{model}</div>
              )}
              <div class="p-card-list__body">
                <div class="p-card-list__tag">{cat.name}</div>
                <div class="p-card-list__name">{model}</div>
                <div class="p-card-list__specs">
                  <span class="p-card-list__spec"><b>{view.orientation.value ?? view.statusNote}</b> {view.orientation.label}</span>
                </div>
                <span class="btn btn--primary">View Details →</span>
              </div>
            </a>
          );
        })}
      </div>
    </section>
  ))}

  <!-- CTA -->
  <section class="cta">
    <h2>NEED HELP CHOOSING THE RIGHT MODEL?</h2>
    <p>Send the work zones, panel or task data, site conditions, destination and transport constraints for a documented configuration review.</p>
    <a href="/contact/" class="btn--white">Request a Project Review →</a>
  </section>

  <style>
    .cat-nav {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 12px;
      padding: 24px 20px;
      position: sticky;
      top: 0;
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(8px);
      z-index: 50;
      border-bottom: 1px solid #e2e8f0;
    }
    .cat-nav__link {
      padding: 8px 18px;
      border-radius: 999px;
      border: 1.5px solid #e2e8f0;
      font-size: 14px;
      font-weight: 600;
      color: #475569;
      text-decoration: none;
      transition: all 0.2s;
    }
    .cat-nav__link:hover {
      border-color: #2563eb;
      color: #2563eb;
      background: #eff6ff;
    }
    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
    section[id] {
      scroll-margin-top: 90px;
    }
  </style>
</BaseLayout>
