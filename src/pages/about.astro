---
import BaseLayout from '../layouts/BaseLayout.astro';
import { EQUIPMENT_CATALOG } from '../lib/equipment-catalog';
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://www.arclifteq.com';
---
<BaseLayout title="About ARCLIFT — Equipment Selection & Supply Partner"
  description="ARCLIFT supports equipment selection and supply for roof-panel forming lifts and ceiling and wall work platforms. Based in Xinxiang, Henan, China."
  ogImage="/images/equipment/transport-real-cover.webp" transparentNav={false}>
  <section class="a2-page-head a2-shell"><p class="a2-eyebrow">About ARCLIFT</p><h1>Specialized equipment.<br />Selected around your job.</h1><p class="a2-lead">Equipment selection and supply for roof-panel forming, ceiling installation and wall-panel access.</p></section>
  <section class="a2-shell about-intro" aria-labelledby="about-title">
    <figure><img src="/images/equipment/transport-real-cover.webp" width="744" height="419" alt="Folded red crawler lifting equipment carried on a low-bed trailer" fetchpriority="high" /><figcaption>Crawler equipment on a low-bed carrier. A reference scene for equipment and transport planning.</figcaption></figure>
    <div><p class="a2-eyebrow">Xinxiang, Henan, China</p><h2 id="about-title">Your equipment selection and supply partner.</h2><p>ARCLIFT is an integrated equipment supplier and technical selection and supply partner. We help contractors, distributors and importers turn a work requirement into a clear equipment proposal.</p><p>Our focus is lifting systems for compatible roof-panel roll formers and large work platforms for ceiling and wall installation. We connect the equipment arrangement with the building, site access and delivery requirements.</p><a class="a2-text-link" href="/contact/?request=advice">Discuss your project →</a></div>
  </section>
  <section class="about-band" aria-labelledby="scope-title"><div class="a2-shell"><div class="about-heading"><p class="a2-eyebrow">Equipment scope</p><h2 id="scope-title">Four application groups.<br />One clear starting point.</h2></div><div class="about-families">{EQUIPMENT_CATALOG.map((family,index)=><article><span>0{index+1}</span><h3><a href={`/products/#${family.id}`}>{family.name}</a></h3><p>{family.description}</p></article>)}</div><p class="about-related">The forming-machine interface is part of system selection. Explore <a href="/products/#roll-forming-machines">related forming-equipment references</a>.</p></div></section>
  <section class="a2-shell about-process" aria-labelledby="process-title"><div class="about-heading"><p class="a2-eyebrow">Working with ARCLIFT</p><h2 id="process-title">From the task to the supply scope.</h2><p>Begin with the job you need to do. Detailed documents can follow as the arrangement takes shape.</p></div><ol>
    <li><span class="step">01</span><h3>Tell us about the work</h3><p>Share the roof-panel profile or installation task, target work area, project location and any equipment you already have.</p><p class="result"><strong>Starting point:</strong> a shared description of the application.</p></li>
    <li><span class="step">02</span><h3>Match the configuration</h3><p>Bring the lift, forming machine or work deck together with the site route, setup footprint, power and transport requirements.</p><p class="result"><strong>Selection:</strong> the proposed equipment arrangement and its interfaces.</p></li>
    <li><span class="step">03</span><h3>Define what is included</h3><p>Separate supplied equipment, agreed options, locally sourced items and assembly responsibilities. Identify the drawings and technical documents available for that proposal.</p><p class="result"><strong>Proposal:</strong> an equipment schedule and a clearly stated supply scope.</p></li>
  </ol></section>
  <section class="a2-shell about-details" aria-labelledby="proposal-title"><div><h2 id="proposal-title">Useful detail for a purchasing decision.</h2><p>A project proposal should identify the exact height datum, loads and load distribution, machine or deck dimensions, support footprint, transport envelope and power/control arrangement.</p><p>Historical model references remain available on this site for orientation. The technical schedule, drawings and load information for the proposed configuration establish its specifications. Destination requirements and site approval are addressed with the responsible parties for the project.</p></div><aside><h3>Contact ARCLIFT</h3><p>Xinxiang, Henan, China</p><a href="mailto:leelogly120@gmail.com">leelogly120@gmail.com</a><a href="https://wa.me/8615617687185">WhatsApp: +86 15617687185</a><a class="a2-button" href="/contact/">Get a quote</a></aside></section>
  <script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'Organization',name:'ARCLIFT Equipment Co., Ltd.',url:siteUrl,description:'Integrated equipment supplier and technical selection and supply partner for roof-panel forming lifts and ceiling or wall work platforms.',contactPoint:{'@type':'ContactPoint',telephone:'+86 15617687185',contactType:'sales',availableLanguage:['English','Chinese']}})} />
  <style>
    .about-intro{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center;padding-bottom:64px}.about-intro figure{margin:0}.about-intro img{width:100%;height:auto;display:block;object-fit:contain}.about-intro figcaption{font-size:13px;color:#526570;line-height:1.5;padding-top:12px}.about-intro h2,.about-heading h2,.about-details h2{font-size:38px;color:#123b50;margin:0}.about-intro p,.about-details p{margin:20px 0;line-height:1.65}.about-band{padding-block:60px;background:#eaf0f3}.about-heading{max-width:760px;margin-bottom:36px}.about-heading p:not(.a2-eyebrow){margin-top:20px}.about-families{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:30px}.about-families article{border-top:1px solid #b3c5cf;padding-top:18px}.about-families span,.step{font-size:14px;color:#a94808;letter-spacing:.08em}.about-families h3{font-size:25px;margin:14px 0}.about-families h3 a{color:#123b50}.about-families h3 a:hover{text-decoration:underline}.about-families p{font-size:16px;line-height:1.6}.about-related{font-size:16px;margin:30px 0 0}.about-related a{color:#123b50;text-decoration:underline}.about-process{padding-block:64px}.about-process ol{list-style:none;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:38px;margin:0;padding:0}.about-process li{border-top:1px solid #c4d0d7;padding-top:20px}.about-process h3{font-size:27px;color:#123b50;margin:16px 0}.about-process p{font-size:17px;line-height:1.65}.about-process .result{font-size:15px;background:#f4f7f8;padding:15px;margin-top:20px}.about-details{border-top:1px solid #c4d0d7;padding-block:50px 70px;display:grid;grid-template-columns:1.4fr 1fr;gap:80px}.about-details aside{background:#eaf0f3;padding:30px;align-self:start}.about-details aside h3{font-size:26px;color:#123b50}.about-details aside a{display:block;color:#123b50;overflow-wrap:anywhere;margin:12px 0}.about-details aside .a2-button{color:#fff;display:inline-flex;margin-top:20px}
    @media(max-width:1000px){.about-families{grid-template-columns:1fr 1fr}.about-intro{gap:35px}.about-details{gap:35px}}
    @media(max-width:768px){.about-intro,.about-process ol,.about-details{grid-template-columns:1fr}.about-intro{gap:28px}.about-intro>div{order:-1}.about-intro h2,.about-heading h2,.about-details h2{font-size:32px}.about-band,.about-process{padding-block:42px}.about-process ol{gap:26px}.about-details{padding-bottom:48px}.about-details aside{padding:24px}}
    @media(max-width:480px){.about-families{grid-template-columns:1fr;gap:24px}}
  </style>
</BaseLayout>
