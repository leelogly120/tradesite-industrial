---
import BaseLayout from '../layouts/BaseLayout.astro';

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://arclifteq.com';
---

<BaseLayout
  title="About ARCLIFT — Project-Engineered Roll Forming & Access Systems"
  description="ARCLIFT is an integrated equipment supplier coordinating technical selection, configuration review and international supply for roll forming lift and large-deck platform projects."
  transparentNav={false}
>

  <!-- HERO BANNER -->
  <section class="hero-banner" style="--banner-image:url('/images/banners/about.webp');--banner-position:center 60%;">
    <div class="overline">About Us</div>
    <h1>BUILDING THE FUTURE OF<br>WORKING AT HEIGHT</h1>
    <p>An equipment solutions supplier connecting project requirements, available evidence and configuration-by-configuration technical review.</p>
  </section>

  <!-- COMPANY STORY -->
  <section class="sec">
    <div class="story reveal">
      <div class="story__visual"><img src="/images/home/roll-forming-line.webp" alt="Roll forming line and project support equipment" width="1200" height="800" loading="lazy" /></div>
      <div class="story__text">
        <h2>How ARCLIFT Works</h2>
        <p>ARCLIFT is an integrated equipment supplier for specialized roll forming lift systems, truck-mounted configurations, large-deck crawler platforms and profile-specific roll forming lines. We organize product evidence and buyer requirements into a traceable project brief before a configuration is discussed.</p>
        <p>As a technical selection and supply partner, ARCLIFT starts with the building and the job sequence: eave or ceiling height, panel profile, sheet material, access route, bearing conditions, transport limits and destination rules. A model page is a reference starting point, not a substitute for an approved technical schedule.</p>
        <p>Evidence depth varies by equipment family and model. Buyers should verify model-specific drawings, field imagery, safety functions, transport arrangements and destination-market documentation before an order is finalized.</p>
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section class="sec sec--dark">
    <div class="stats reveal">
      <div class="stat"><div class="stat__num">4</div><div class="stat__label">Equipment Families</div></div>
      <div class="stat"><div class="stat__num">2</div><div class="stat__label">Mobility Architectures</div></div>
      <div class="stat"><div class="stat__num">1</div><div class="stat__label">Project Data Brief</div></div>
      <div class="stat"><div class="stat__num">DATA</div><div class="stat__label">Project-Specific Review</div></div>
    </div>
  </section>

  <!-- ORDER VERIFICATION -->
  <section class="sec">
    <div class="sec__header reveal">
      <div class="sec__overline">Before You Order</div>
      <h2 class="sec__title">VERIFY THE PROJECT CONFIGURATION</h2>
    </div>
    <div class="certs">
      <div class="cert reveal"><div class="icon">01</div><h3>Technical Schedule</h3><p>Confirm height, payload, platform, power, controls and safety functions in writing.</p></div>
      <div class="cert reveal"><div class="icon">02</div><h3>Destination Rules</h3><p>Identify the applicable machine, road, electrical and work-at-height requirements.</p></div>
      <div class="cert reveal"><div class="icon">03</div><h3>Configuration Documents</h3><p>Review drawings, component lists, test records and the exact documentation offered for the selected unit.</p></div>
      <div class="cert reveal"><div class="icon">04</div><h3>Visual Confirmation</h3><p>Match approval photos and videos to the chassis, deck and accessories in the quotation.</p></div>
    </div>
  </section>

  <!-- VALUES -->
  <section class="sec sec--gray">
    <div class="sec__header reveal">
      <div class="sec__overline">Our Values</div>
      <h2 class="sec__title">WHAT DRIVES US</h2>
    </div>
    <div class="values">
      <div class="value reveal"><div class="icon">01</div><h3>Evidence Before Claims</h3><p>Published parameters are tied to available evidence, and important gaps are disclosed. Final safety functions and compliance remain unit- and market-specific.</p></div>
      <div class="value reveal"><div class="icon">02</div><h3>Workflow Engineering</h3><p>The equipment is configured around how panels, crews and materials move through the site—not around a generic aerial-lift specification alone.</p></div>
      <div class="value reveal"><div class="icon">03</div><h3>Supply Partnership</h3><p>We coordinate project information, configuration review and supply communication so buyers can confirm requirements before commercial decisions are made.</p></div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta">
    <h2>JOIN OUR GLOBAL NETWORK</h2>
    <p>Share your market, application and project requirements to start a focused supply discussion.</p>
    <a href="/contact/" class="btn--white">Contact Us →</a>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'ARCLIFT Equipment Co., Ltd.',
    url: siteUrl,
    description: 'Integrated equipment supplier and technical selection partner for roll forming lift systems and large-deck crawler platform projects.',
    contactPoint: { '@type': 'ContactPoint', contactType: 'sales', availableLanguage: ['English', 'Chinese'] },
  })} />
</BaseLayout>
