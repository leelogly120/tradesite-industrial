---
import BaseLayout from '../layouts/BaseLayout.astro';

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://arclifteq.com';
---

<BaseLayout
  title="About ARCLIFT — Professional Crawler Under-Ceiling Platform Manufacturer"
  description="ARCLIFT is a professional manufacturer of crawler under-ceiling aerial work platforms. ARC series: roll forming lifts 12-32m and ceiling platforms 20-35m, remote control, dual power."
  transparentNav={false}
>

  <!-- HERO BANNER -->
  <section class="hero-banner">
    <div class="overline">About Us</div>
    <h1>BUILDING THE FUTURE OF<br>WORKING AT HEIGHT</h1>
    <p>Professional manufacturer of crawler under-ceiling aerial work platforms. Innovation, safety, and reliability since 2019.</p>
  </section>

  <!-- COMPANY STORY -->
  <section class="sec">
    <div class="story reveal">
      <div class="story__visual">Factory / Team Image</div>
      <div class="story__text">
        <h2>Our Story</h2>
        <p>Founded in 2019, ARCLIFT set out to solve a problem that the aerial access industry had been ignoring: how do you efficiently work on ceilings that sit 20–35 meters above the floor? Spider lifts have tiny baskets. Scaffolding takes days to build. Boom lifts can't reach the ceiling plane from below.</p>
        <p>Our founder spent two years working with construction contractors on stadium and airport projects, watching them struggle with these constraints. The answer was obvious — build a platform that goes directly to the ceiling and moves along it. The ARC series was born from that insight.</p>
        <p>Today, we've delivered over 1,000 units to contractors in 40+ countries. Our factory in Henan — China's heavy machinery heartland — operates a dedicated production line exclusively for crawler under-ceiling platforms.</p>
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section class="sec sec--dark">
    <div class="stats reveal">
      <div class="stat"><div class="stat__num">15+</div><div class="stat__label">Years Experience</div></div>
      <div class="stat"><div class="stat__num">1,000+</div><div class="stat__label">Units Delivered</div></div>
      <div class="stat"><div class="stat__num">40+</div><div class="stat__label">Countries Served</div></div>
      <div class="stat"><div class="stat__num">50+</div><div class="stat__label">Patents</div></div>
    </div>
  </section>

  <!-- CERTIFICATIONS -->
  <section class="sec">
    <div class="sec__header reveal">
      <div class="sec__overline">Certifications</div>
      <h2 class="sec__title">QUALITY ASSURED</h2>
    </div>
    <div class="certs">
      <div class="cert reveal"><div class="icon">🇪🇺</div><h3>CE Certified</h3><p>EN 280 compliant for European market access</p></div>
      <div class="cert reveal"><div class="icon">🇺🇸</div><h3>ANSI A92.20</h3><p>Meets US safety standards for MEWPs</p></div>
      <div class="cert reveal"><div class="icon">🌐</div><h3>ISO 9001</h3><p>Quality management system certified</p></div>
      <div class="cert reveal"><div class="icon">🛡️</div><h3>ISO 16368</h3><p>International safety standard for mobile platforms</p></div>
    </div>
  </section>

  <!-- VALUES -->
  <section class="sec sec--gray">
    <div class="sec__header reveal">
      <div class="sec__overline">Our Values</div>
      <h2 class="sec__title">WHAT DRIVES US</h2>
    </div>
    <div class="values">
      <div class="value reveal"><div class="icon">🛡️</div><h3>Safety First</h3><p>Every product meets the highest international safety standards. Worker safety is non-negotiable — that's why our platforms include load sensing, anti-collision, and full remote control as standard.</p></div>
      <div class="value reveal"><div class="icon">💡</div><h3>Innovation</h3><p>We continuously improve with dual power systems, smart remote control, and automated features. Our R&D team works directly with contractors to solve real problems on real job sites.</p></div>
      <div class="value reveal"><div class="icon">🤝</div><h3>Partnership</h3><p>We build long-term relationships with customers and distributors through reliability, transparent communication, and responsive support. When you call, we answer.</p></div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta">
    <h2>JOIN OUR GLOBAL NETWORK</h2>
    <p>Become a distributor or partner. We're expanding our presence worldwide.</p>
    <a href="/contact/" class="btn--white">Contact Us →</a>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'ARCLIFT Equipment Co., Ltd.',
    url: siteUrl,
    description: 'Professional manufacturer of aerial roll forming lifts and ceiling platforms — ARC series, 12m–35m reach.',
    foundingDate: '2019',
    contactPoint: { '@type': 'ContactPoint', contactType: 'sales', availableLanguage: ['English', 'Chinese'] },
  })} />
</BaseLayout>
