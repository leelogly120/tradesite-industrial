---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import {
  DEFAULT_COMPARE_SLUGS,
  PRODUCT_REFERENCES,
  buildCompareView,
} from '../lib/product-selection';
import { renderCompareRegion } from '../lib/product-compare';
import EquipmentDiagram from '../components/EquipmentDiagram.astro';

const familyOrientations = [
  {
    family: 'crawler',
    heading: 'Crawler raised forming line',
    description: 'Frame the review around the site route and the raised forming-line workflow.',
    input: 'Bring the roof plan, route constraints and work-zone information.',
    href: '/products/#crawler-roll-forming-lifts',
    link: 'Crawler lift family',
  },
  {
    family: 'truck',
    heading: 'Truck-mounted raised forming line',
    description: 'Frame the review around the chassis, road access, setup area and outrigger interface.',
    input: 'Bring route, site-access, chassis and support-condition information.',
    href: '/products/#truck-mounted-roll-forming-lifts',
    link: 'Truck-mounted lift family',
  },
  {
    family: 'ceiling',
    heading: 'Separate ceiling work-deck concept',
    description: 'Treat this as a separate work-deck concept for the workface, not as a forming-line variant.',
    input: 'Bring the workface geometry and documented load-approval inputs.',
    href: '/products/#crawler-ceiling-platforms',
    link: 'Ceiling platform family',
  },
  {
    family: 'former',
    heading: 'Panel-forming line',
    description: 'Frame the review around panel shaping and the profile, material and interface requirements.',
    input: 'Bring the target profile, material definition and line-interface information.',
    href: '/products/#roll-forming-machines',
    link: 'Roll-forming line family',
  },
] as const;

const publicProducts = (await getCollection('products')).filter(product => !product.data.draft);
const productsBySlug = new Map(publicProducts.map(product => [product.id, product]));
const allCompareViews = PRODUCT_REFERENCES.flatMap((reference) => {
  const product = productsBySlug.get(reference.slug);
  if (!product) return [];
  const view = buildCompareView(product);
  return view ? [view] : [];
});
const compareViewsBySlug = new Map(allCompareViews.map(view => [view.slug, view]));
const defaultCompareViews = DEFAULT_COMPARE_SLUGS.flatMap((slug) => {
  const view = compareViewsBySlug.get(slug);
  return view ? [view] : [];
});
const compareDataJson = JSON.stringify(allCompareViews).replaceAll('<', '\\u003c');
const defaultCompareHtml = renderCompareRegion(defaultCompareViews);
---

<BaseLayout
  title="Compare Archived Equipment References"
  description="Compare ARCLIFT archived references by family, status, project-review scope and confirmation requirements."
  canonical="https://www.arclifteq.com/compare/"
  noindex={true}
  follow={true}
  transparentNav={false}
>
  <section class="hero-banner" style="--banner-image:url('/images/banners/compare.webp');--banner-position:center 58%;">
    <div class="overline">Compare</div>
    <h1>COMPARE ARCHIVED REFERENCES</h1>
    <p>Use the shared project-review boundaries to prepare questions. Final configuration still depends on signed documents.</p>
    <p class="hero-disclosure">AI-assisted editorial composite. Editorial planning visual — not model-specific evidence</p>
  </section>

  <section class="compare-section">
    <div class="compare-intro">
      <p class="eyebrow">Reference comparison</p>
      <h2>Start with scope, not a performance ranking</h2>
      <p>
        The default view keeps ARC-C25, ARC-T25, ARC-F20 and ARC-RF8 available without JavaScript.
        Selections from the product list replace only the comparison below when browser scripting is available.
      </p>
      <a href="/products/" class="selector-link">Change selected references</a>
    </div>

    <nav class="family-orientation-nav" aria-label="Compare equipment families">
      {familyOrientations.map(item => <a href={item.href}>{item.link}</a>)}
    </nav>
    <div class="family-orientation-grid">
      {familyOrientations.map(item => (
        <article>
          <EquipmentDiagram family={item.family} compact />
          <div>
            <h3>{item.heading}</h3>
            <p>{item.description}</p>
            <p><strong>Input orientation:</strong> {item.input}</p>
            <a href={item.href}>{item.link} →</a>
          </div>
        </article>
      ))}
    </div>

    <div
      class="comparison-region"
      data-compare-region
      aria-live="polite"
      set:html={defaultCompareHtml}
    ></div>
    <script id="compare-reference-data" type="application/json" set:html={compareDataJson}></script>

    <p class="comparison-boundary">
      Archived labels are orientation points only. They do not establish current-model performance,
      project suitability or procurement authorization.
    </p>
  </section>

  <section class="cta">
    <h2>READY FOR A PROJECT-SPECIFIC REVIEW?</h2>
    <p>Send the site inputs and request the available reference documents before a configuration is quoted.</p>
    <a href="/contact/" class="btn--white">Prepare an enquiry →</a>
  </section>
</BaseLayout>

<script>
  import {
    renderCompareQuery,
    type CompareView,
  } from '../lib/product-compare';

  const region = document.querySelector<HTMLElement>('[data-compare-region]');
  const dataElement = document.querySelector<HTMLScriptElement>('#compare-reference-data');
  const params = new URLSearchParams(window.location.search);

  if (region && dataElement && params.has('items')) {
    const availableViews = JSON.parse(dataElement.textContent ?? '[]') as CompareView[];
    const queryHtml = renderCompareQuery(params.get('items'), availableViews);
    if (queryHtml) region.innerHTML = queryHtml;
  }
</script>

<style>
  .compare-section {
    background: #f8fafc;
    padding: clamp(3.5rem, 7vw, 6.5rem) 5%;
  }

  .compare-intro,
  .family-orientation-nav,
  .family-orientation-grid,
  .comparison-region,
  .comparison-boundary {
    margin-inline: auto;
    max-width: 1180px;
  }

  .compare-intro {
    margin-bottom: 2rem;
    max-width: 780px;
    text-align: center;
  }

  .hero-banner .hero-disclosure {
    background: rgb(15 23 42 / 82%);
    border-left: 3px solid #93c5fd;
    color: #f8fafc;
    font-size: .82rem;
    font-weight: 650;
    line-height: 1.45;
    margin: 1.25rem 0 0;
    max-width: max-content;
    padding: .65rem .8rem;
  }

  .eyebrow {
    color: #174f94;
    font-size: .78rem;
    font-weight: 800;
    letter-spacing: .14em;
    margin-bottom: .65rem;
    text-transform: uppercase;
  }

  .compare-intro h2 {
    color: #102a43;
    font-size: clamp(1.65rem, 3vw, 2.5rem);
    margin-bottom: .85rem;
  }

  .compare-intro p,
  .comparison-boundary {
    color: #52657a;
    line-height: 1.75;
  }

  .selector-link {
    color: #174f94;
    display: inline-block;
    font-weight: 800;
    margin-top: 1rem;
    min-height: 44px;
    padding: .7rem .9rem;
    text-underline-offset: .2em;
  }

  .family-orientation-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: .55rem;
    margin-bottom: 1.25rem;
  }

  .family-orientation-nav a {
    min-height: 44px;
    padding: .7rem .9rem;
    border: 1px solid #bfd2e8;
    border-radius: 999px;
    color: #174f94;
    font-weight: 750;
    text-decoration: none;
  }

  .family-orientation-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .family-orientation-grid article {
    display: grid;
    grid-template-columns: minmax(150px, .75fr) minmax(0, 1.25fr);
    gap: 1rem;
    align-items: center;
    padding: 1rem;
    border: 1px solid #d9e2ec;
    border-radius: 12px;
    background: white;
  }

  .family-orientation-grid article > * {
    min-width: 0;
  }

  .family-orientation-grid h3 {
    margin: 0 0 .55rem;
    color: #102a43;
    font-size: 1.15rem;
  }

  .family-orientation-grid p {
    margin: .35rem 0;
    color: #52657a;
    line-height: 1.55;
  }

  .family-orientation-grid a {
    display: inline-block;
    margin-top: .4rem;
    color: #174f94;
    font-weight: 800;
  }

  .selector-link:focus-visible,
  :global(.comparison-table a:focus-visible),
  :global(.comparison-notice a:focus-visible) {
    outline: 3px solid #f59e0b;
    outline-offset: 3px;
  }

  :global(.comparison-notice) {
    background: #eaf2fb;
    border-left: 4px solid #174f94;
    color: #243b53;
    line-height: 1.65;
    margin: 0 0 1rem;
    padding: 1rem 1.15rem;
  }

  :global(.comparison-notice h2) {
    color: #102a43;
    font-size: 1.25rem;
    margin-bottom: .35rem;
  }

  :global(.comparison-notice a) {
    color: #174f94;
    display: inline-block;
    font-weight: 800;
    margin-top: .65rem;
    min-height: 44px;
    padding-block: .65rem;
  }

  :global(.comparison-table-wrap) {
    background: white;
    border: 1px solid #d9e2ec;
    border-radius: 12px;
    box-shadow: 0 16px 42px rgb(15 23 42 / 7%);
    overflow-x: auto;
  }

  :global(.comparison-table) {
    border-collapse: collapse;
    color: #243b53;
    min-width: 760px;
    width: 100%;
  }

  :global(.comparison-table caption) {
    color: #102a43;
    font-size: 1.05rem;
    font-weight: 800;
    padding: 1.15rem;
    text-align: left;
  }

  :global(.comparison-table th),
  :global(.comparison-table td) {
    border-top: 1px solid #d9e2ec;
    line-height: 1.55;
    padding: 1rem;
    text-align: left;
    vertical-align: top;
  }

  :global(.comparison-table thead th) {
    background: #102a43;
    color: white;
  }

  :global(.comparison-table thead a) {
    color: white;
    text-decoration-thickness: 2px;
    text-underline-offset: .2em;
  }

  :global(.comparison-table tbody th) {
    background: #eef4fa;
    color: #102a43;
    min-width: 180px;
  }

  .comparison-boundary {
    font-size: .9rem;
    margin-top: 1.25rem;
    text-align: center;
  }

  @media (max-width: 720px) {
    .compare-section {
      padding-inline: 1rem;
    }

    :global(.comparison-table th),
    :global(.comparison-table td) {
      padding: .8rem;
    }

    .family-orientation-grid {
      grid-template-columns: 1fr;
    }

    .family-orientation-grid article {
      grid-template-columns: 1fr;
    }
  }
</style>
