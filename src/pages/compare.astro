---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const craneProducts = (await getCollection('products'))
  .filter(p => !p.data.draft && p.data.category === 'Aerial Work Platforms')
  .sort((a, b) => {
    const aH = parseInt(a.data.specifications?.['Max Working Height'] || '0');
    const bH = parseInt(b.data.specifications?.['Max Working Height'] || '0');
    return aH - bH;
  });

const compareKeys = [
  'Max Working Height', 'Safe Working Load', 'Platform Extension',
  'Machine Weight', 'Diesel Engine', 'Electric Motor',
  'Gradeability', 'Travel Speed (stowed)', 'Min Ground Clearance',
];
---

<BaseLayout
  title="Compare FDDPT Models — Side-by-Side Specs"
  description="Compare all 4 FDDPT crawler under-ceiling aerial work platforms: 20m, 25m, 31m, 35m. Height, load, platform size, power — side by side."
  transparentNav={false}
>

  <section class="hero-banner">
    <div class="overline">Compare</div>
    <h1>COMPARE FDDPT MODELS</h1>
    <p>Side-by-side specifications for all four crawler under-ceiling platforms.</p>
  </section>

  <section class="sec">
    <div class="comp reveal">
      <table>
        <thead>
          <tr>
            <th>Specification</th>
            {craneProducts.map(p => (
              <th>
                <a href={`/products/${p.id}/`} style="color:#2563eb;font-size:0.95rem;">
                  {p.data.title.split(' ')[0]}
                </a>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {compareKeys.map(key => (
            <tr>
              <td>{key}</td>
              {craneProducts.map(p => (
                <td>{p.data.specifications?.[key] || '—'}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p style="text-align:center;color:#64748b;font-size:0.85rem;margin-top:1rem;">
      For complete specifications, visit each model's product detail page.
    </p>
  </section>

  <section class="cta">
    <h2>NEED HELP CHOOSING THE RIGHT MODEL?</h2>
    <p>Our engineering team can recommend the best FDDPT for your ceiling height, load, and site conditions.</p>
    <a href="/contact/" class="btn--white">Get a Recommendation →</a>
  </section>
</BaseLayout>
