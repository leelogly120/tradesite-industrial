---
import BaseLayout from '../layouts/BaseLayout.astro';
import InquiryForm from '../components/InquiryForm.astro';
const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://www.arclifteq.com';
---

<BaseLayout
  title="Get a Quote — Roof Panel Roll Former Lift Platforms"
  description="Request a quote for ARCLIFT truck-mounted or crawler roof-panel roll former lifts and large-deck platforms. Share height class, site access, and panel profile."
  transparentNav={false}
>

  <!-- ORGANIZATION SCHEMA -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'ARCLIFT Equipment Co., Ltd.',
    description: 'Integrated equipment supplier providing technical selection and supply coordination for roll forming lift systems and large-deck crawler platforms.',
    url: siteUrl,
    telephone: '+86 15515922444',
    email: 'leelogly120@gmail.com',
    contactPoint: {
      '@type': 'ContactPoint',
      telephone: '+86 15515922444',
      email: 'leelogly120@gmail.com',
      contactType: 'sales',
      availableLanguage: ['English', 'Chinese'],
    },
  })} />

  <!-- BREADCRUMB SCHEMA -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
      { '@type': 'ListItem', position: 2, name: 'Contact' },
    ],
  })} />

  <section class="contact-intro">
    <div class="contact-shell">
      <p class="contact-eyebrow">CONTACT ARCLIFT</p>
      <h1>Request a quote for the right lift or platform.</h1>
      <p>Tell us the job, the height class you are targeting, and how we can reach you. A short message is enough to start — use the eight fields below if you already have project data.</p>
    </div>
  </section>

  <div class="contact-shell contact-layout">
    <section class="inquiry-card" aria-labelledby="inquiry-heading">
      <h2 id="inquiry-heading">How can we help?</h2>
      <p class="inquiry-intro">Your name and one contact method are required. Add project details when you have them. The eight fields below are the RFQ inputs we use for a first quote.</p>
      <InquiryForm variant="contact" />
      <noscript><p>Please enable JavaScript to use this form, or email leelogly120@gmail.com or WhatsApp +86 15515922444.</p></noscript>
    </section>

    <aside class="contact-sidebar" aria-label="Direct contact and next steps">
      <section class="direct-contact">
        <h2>Speak with us directly</h2>
        <a href="https://wa.me/8615515922444"><span>WhatsApp</span><strong>+86 15515922444</strong><span aria-hidden="true">↗</span></a>
        <a href="mailto:leelogly120@gmail.com"><span>Email</span><strong>leelogly120@gmail.com</strong><span aria-hidden="true">↗</span></a>
        <p>English &amp; Chinese<br />Mon–Sat, 9:00–18:00 (UTC+8 / Asia/Shanghai)</p>
      </section>
      <section class="next-steps">
        <h2>What happens next</h2>
        <ol>
          <li><strong>Understand the application.</strong> Roof-panel forming, ceiling installation, or wall work.</li>
          <li><strong>Narrow the equipment.</strong> Truck or crawler, height class, machine or deck, access and destination.</li>
          <li><strong>Confirm the configuration.</strong> Review the available documents and quotation details before ordering.</li>
        </ol>
        <p>Documents depend on the model and proposed configuration; this form sends a request rather than starting an automatic download.</p>
        <a href="/products/">Browse equipment families →</a>
      </section>
    </aside>
  </div>
</BaseLayout>


<style>
  .contact-shell { width: min(1160px, calc(100% - 48px)); margin-inline: auto; }
  .contact-intro { padding: calc(var(--nav-height) + 48px) 0 42px; background: #eaf0f3; color: #273c47; border-bottom: 1px solid #c4d0d7; }
  .contact-eyebrow { font-size: .8rem; font-weight: 700; letter-spacing: .12em; color: #123b50; margin-bottom: 15px; }
  .contact-intro h1 { max-width: 850px; font-size: clamp(36px, 4.2vw, 58px); }
  .contact-intro h1 + p { max-width: 780px; font-size: 1.1rem; margin-top: 18px; color: #526570; }
  .contact-layout { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, .85fr); gap: 64px; padding-block: 50px 76px; color: #273c47; }
  .inquiry-card { min-width: 0; }
  .inquiry-card h2, .contact-sidebar h2 { font-size: 1.6rem; margin-bottom: 14px; }
  .inquiry-intro { color: #526570; margin: 0 0 25px; max-width: 50ch; font-size: 1rem; }
  .contact-sidebar { min-width: 0; }
  .direct-contact { background: #eaf0f3; padding: 28px; border: 1px solid #c4d0d7; }
  .direct-contact a { display: grid; grid-template-columns: 1fr auto; gap: 2px 12px; padding: 17px 0; border-bottom: 1px solid #c4d0d7; min-height: 60px; }
  .direct-contact a > span:first-child { grid-column: 1; color: #526570; font-size: .85rem; }
  .direct-contact a strong { grid-column: 1; font-size: 1rem; overflow-wrap: anywhere; }
  .direct-contact a > span:last-child { grid-column: 2; grid-row: 1 / 3; align-self: center; color: #123b50; }
  .direct-contact a:hover strong { text-decoration: underline; text-underline-offset: 4px; }
  .direct-contact p { margin-top: 20px; font-size: .9rem; color: #526570; }
  .next-steps { margin-top: 36px; }
  .next-steps ol { padding-left: 24px; }
  .next-steps li { padding-left: 4px; margin-bottom: 18px; color: #526570; font-size: 1rem; }
  .next-steps li strong { color: #273c47; }
  .next-steps > p { margin-top: 25px; font-size: .85rem; color: #526570; }
  .next-steps > a { display: inline-flex; align-items: center; min-height: 48px; margin-top: 18px; color: #123b50; font-weight: 600; }
  .next-steps > a:hover { text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 800px) {
    .contact-intro { padding-top: calc(var(--nav-height) + 30px); padding-bottom: 32px; }
    .contact-layout { grid-template-columns: minmax(0, 1fr); gap: 40px; padding-top: 32px; }
    .direct-contact { padding: 24px; }
  }
</style>
