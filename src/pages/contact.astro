---
import BaseLayout from '../layouts/BaseLayout.astro';
import InquiryForm from '../components/InquiryForm.astro';
const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://www.arclifteq.com';
---

<BaseLayout
  title="Get a Quote — ARCLIFT"
  description="Share your project height, panel profile, site conditions and destination for an engineering configuration review."
  transparentNav={false}
>

  <!-- ORGANIZATION SCHEMA -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'ARCLIFT Equipment Co., Ltd.',
    description: 'Integrated equipment supplier providing technical selection and supply coordination for roll forming lift systems and large-deck crawler platforms.',
    url: siteUrl,
    telephone: '+86 15617687185',
    email: 'leelogly120@gmail.com',
    contactPoint: {
      '@type': 'ContactPoint',
      telephone: '+86 15617687185',
      contactType: 'sales',
      availableLanguage: ['English', 'Chinese'],
    },
  })} />

  <!-- BREADCRUMB SCHEMA -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
      { '@type': 'ListItem', position: 2, name: 'Contact' },
    ],
  })} />

  <!-- HERO BANNER -->
  <section class="hero-banner" style="--banner-image:url('/images/banners/contact.webp');--banner-position:center 58%;">
    <div class="overline">Contact</div>
    <h1>GET A QUOTE</h1>
    <p>Share your project height, panel profile, site conditions and destination for an engineering configuration review.</p>
  </section>

  <!-- SPLIT LAYOUT -->
  <div style="display:grid;grid-template-columns:1.2fr 1fr;gap:64px;max-width:1200px;margin:0 auto;padding:clamp(60px,8vw,100px) var(--section-px);align-items:start;">
    <!-- FORM -->
    <div class="form-card">
      <h2>Tell Us About Your Project</h2>
      <p class="sub">Share the project conditions our engineering team needs to review the configuration.</p>
      <InquiryForm variant="contact" />
    </div>

    <!-- SIDEBAR -->
    <div style="padding-top:8px;">
      <div class="contact-card">
        <h3>Contact Us Directly</h3>
        <div class="ci">
          <div class="ci__icon">📱</div>
          <div class="ci__text"><b>WhatsApp</b>+86 15617687185</div>
        </div>
        <div class="ci">
          <div class="ci__icon">✉️</div>
          <div class="ci__text"><b>Email</b>leelogly120@gmail.com</div>
        </div>
        <div class="ci">
          <div class="ci__icon">🕐</div>
          <div class="ci__text"><b>Working Hours</b>Mon–Sat, 9:00–18:00 (GMT+8)</div>
        </div>
      </div>
      <div class="contact-card">
        <h3>Why ARCLIFT</h3>
        <div class="trust-badges">
          <div class="trust-badge">✓ Engineering Review</div>
          <div class="trust-badge">✓ Configuration Confirmed</div>
          <div class="trust-badge">✓ Configuration Documentation</div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>


<style>
  @media (max-width: 768px) {
    div[style*="grid-template-columns:1.2fr"] {
      grid-template-columns: 1fr !important;
      gap: 40px !important;
    }
  }
</style>
