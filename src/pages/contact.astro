---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import InquiryForm from '../components/InquiryForm.astro';
---

<BaseLayout
  title="Contact ARCLIFT — Request a Quote"
  description="Contact ARCLIFT (ARCLIFT) for crawler under-ceiling platform pricing, specifications, and project consultation. Reply within 24 hours."
>

  <HeroSection
    variant="inner"
    title="Request a Quote / Contact Us"
    subtitle="Tell us about your ceiling project — our engineering team responds within 24 hours."
    breadcrumb={[
      { name: 'Home', url: '/' },
      { name: 'Contact', url: '' },
    ]}
  />

  <section class="section">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-8">
        <div style="grid-column:span 3;">
          <InquiryForm />
        </div>

        <div style="grid-column:span 2;">
          <div style="padding:1.5rem;background:var(--color-bg-alt);border-radius:0.75rem;border:1px solid var(--color-border);">
            <h3 style="font-weight:700;font-size:1.1rem;margin-bottom:1rem;">Company Information</h3>
            <div style="line-height:2;font-size:0.95rem;">
              <p><strong>ARCLIFT</strong></p>
              <p style="color:var(--color-text-light);">ARCLIFT Equipment Co., Ltd.</p>
              <hr style="margin:0.75rem 0;border-color:var(--color-border);" />
              <p><strong>WhatsApp:</strong><br/><a href="https://wa.me/8615617687185">+86 15617687185</a></p>
              <p><strong>Phone:</strong><br/>+86 15617687185</p>
              <p><strong>Email:</strong><br/><a href="mailto:leelogly120@gmail.com">leelogly120@gmail.com</a></p>
              <p><strong>Address:</strong><br/>Xinxiang, Henan Province, China</p>
              <p><strong>Business Hours:</strong><br/>Mon–Sat, 8:00–18:00 (GMT+8)</p>
              <hr style="margin:0.75rem 0;border-color:var(--color-border);" />
              <p style="font-size:0.85rem;color:var(--color-success);font-weight:600;">We reply within 24 hours</p>
            </div>
          </div>

          <div style="margin-top:1.5rem;padding:1.5rem;background:var(--color-bg-alt);border-radius:0.75rem;border:1px solid var(--color-border);">
            <h3 style="font-weight:700;font-size:1.1rem;margin-bottom:0.75rem;">Quick Links</h3>
            <ul style="line-height:2;font-size:0.95rem;">
              <li><a href="/products/">View FDDPT Product Line</a></li>
              <li><a href="/applications/stadium/">Stadium Ceiling Solutions</a></li>
              <li><a href="/applications/airport/">Airport Terminal Access</a></li>
              <li><a href="/applications/warehouse/">Warehouse Ceiling Work</a></li>
              <li><a href="/blog/pick-and-carry-vs-spider-lift-vs-scaffolding/">Comparison Guide</a></li>
              <li><a href="/about/">About ARCLIFT</a></li>
            </ul>
          </div>

          <div style="margin-top:1.5rem;">
            <h4 style="font-weight:600;font-size:0.9rem;margin-bottom:0.5rem;color:var(--color-text-light);">Target Markets</h4>
            <div style="display:flex;flex-wrap:wrap;gap:0.375rem;">
              <span class="spec-chip">USA</span><span class="spec-chip">Canada</span><span class="spec-chip">EU</span>
              <span class="spec-chip">UK</span><span class="spec-chip">Australia</span><span class="spec-chip">UAE</span>
              <span class="spec-chip">Saudi Arabia</span><span class="spec-chip">SEA</span><span class="spec-chip">India</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
