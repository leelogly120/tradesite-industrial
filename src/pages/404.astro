---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found" description="The page you're looking for doesn't exist." transparentNav={false} noindex={true}>
  <section style="min-height:80vh;display:flex;align-items:center;justify-content:center;padding:var(--section-px);">
    <div style="text-align:center;">
      <p style="font-size:8rem;font-weight:900;color:#f1f5f9;line-height:1;letter-spacing:-0.04em;">404</p>
      <h1 style="font-size:2rem;font-weight:800;margin-bottom:0.5rem;">Page Not Found</h1>
      <p style="color:#64748b;margin-bottom:2rem;">
        The page you're looking for may have been moved or doesn't exist.
      </p>
      <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
        <a href="/" class="btn btn--primary">Back to Home</a>
        <a href="/products/" class="btn btn--outline-blue">View Products</a>
      </div>
    </div>
  </section>
</BaseLayout>
