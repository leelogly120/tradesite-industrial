---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="Blog — ARCLIFT" description="Industry insights, product guides, and technical comparisons for crawler under-ceiling aerial work platforms." transparentNav={false}>

  <!-- HERO BANNER -->
  <section class="hero-banner">
    <div class="overline">Blog</div>
    <h1>BLOG & INSIGHTS</h1>
    <p>Industry knowledge, technical guides, and comparison articles for ceiling access professionals.</p>
  </section>

  <!-- POSTS -->
  <section class="sec">
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:28px;max-width:1400px;margin:0 auto;">
      {posts.map(post => (
        <a href={`/blog/${post.id}/`} class="case-card reveal">
          <div class="case-card__img">
            {post.data.tags && post.data.tags.length > 0 ? post.data.tags[0] : 'Blog'}
          </div>
          <div class="case-card__body">
            {post.data.tags && post.data.tags.length > 0 && (
              <span style="display:inline-block;padding:4px 12px;background:#eff6ff;color:#2563eb;border-radius:20px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:12px;">{post.data.tags[0]}</span>
            )}
            <div class="case-card__title">{post.data.title}</div>
            <div class="case-card__desc">{post.data.description}</div>
            <time style="font-size:13px;color:#64748b;display:block;margin-top:12px;">
              {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
            </time>
          </div>
        </a>
      ))}
    </div>

    {posts.length === 0 && (
      <div style="text-align:center;padding:4rem 0;color:#64748b;">
        <p style="font-size:1.25rem;">No blog posts yet.</p>
      </div>
    )}
  </section>
</BaseLayout>

<style>
  @media (max-width: 1024px) {
    div[style*="grid-template-columns:repeat(3"] { grid-template-columns: repeat(2, 1fr) !important; }
  }
  @media (max-width: 768px) {
    div[style*="grid-template-columns:repeat(3"] { grid-template-columns: 1fr !important; }
  }
</style>
