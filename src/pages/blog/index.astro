---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="Blog" description="Industry insights, product guides, and company news.">
  <section class="section">
    <div class="container">
      <h1 class="text-3xl font-bold mb-2">Blog & Insights</h1>
      <p class="text-gray-600 mb-8">
        Industry knowledge, product guides, and tips for industrial buyers.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.map(post => (
          <a href={`/blog/${post.slug}/`} class="card">
            {post.data.coverImage ? (
              <div class="aspect-video overflow-hidden bg-gray-100">
                <img src={post.data.coverImage} alt={post.data.title}
                  loading="lazy" class="w-full h-full object-cover" />
              </div>
            ) : (
              <div class="aspect-video bg-gradient-to-br from-blue-50 to-indigo-100"></div>
            )}
            <div class="card-body">
              {post.data.tags && post.data.tags.length > 0 && (
                <span class="text-xs font-medium text-blue-600 uppercase">{post.data.tags[0]}</span>
              )}
              <h3 class="mt-1">{post.data.title}</h3>
              <p class="line-clamp-2">{post.data.description}</p>
              <time class="text-xs text-gray-400 mt-2 block">
                {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
              </time>
            </div>
          </a>
        ))}
      </div>

      {posts.length === 0 && (
        <div class="text-center py-16 text-gray-400">
          <p class="text-xl">No blog posts yet.</p>
          <p class="mt-2">Add blog Markdown files to src/content/blog/</p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
