---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import GuideLinks from '../../components/GuideLinks.astro';
import { getGuideLinks } from '../../lib/guide-navigation';
const stadiumGuides = getGuideLinks(['stadium-ceiling-access-platform-planning', 'ceiling-platform-overhead-clearance-survey', 'large-deck-crawler-platform-work-zone-layout'], await getCollection('blog'));
---

<BaseLayout
  title="Stadium Ceiling Maintenance & Construction — ARCLIFT"
  description="Project screening for crawler platforms used in stadium acoustic-panel, lighting and overhead service work, with bearing, access, exclusion-zone and rescue checks."
  transparentNav={false}
>

  <section class="hero-banner" style="--banner-image:url('/images/banners/stadium.webp');--banner-position:center 58%;">
    <div class="overline">Stadium & Arena</div>
    <h1>STADIUM CEILING SOLUTIONS</h1>
    <p>Large-span steel structures, acoustic panel installation, rigging access, and lighting maintenance.</p>
  </section>

  <section class="sec">
    <div style="max-width:800px;margin:0 auto;">
      <h2 style="font-size:28px;font-weight:800;margin-bottom:20px;">Stadium Project Screening</h2>
      <p style="font-size:16px;color:#475569;line-height:1.8;margin-bottom:16px;">Stadium work may involve acoustic panels, lighting grids, services and periodic inspection across a large plan area. The available route, field or concourse bearing, roof geometry, event calendar and safe recovery method determine whether a large-deck crawler is practical.</p>
      <p style="font-size:16px;color:#475569;line-height:1.8;margin-bottom:16px;">ARC-F pages describe reference concepts rather than a guaranteed one-machine solution. A project study must confirm reachable work zones, deck load, stabilizing method, floor protection, exclusion zones and local work-at-height requirements.</p>
    </div>
  </section>

  <section class="sec sec--gray">
    <div class="sec__header reveal">
      <div class="sec__overline">Reference concepts</div>
      <h2 class="sec__title">REVIEW THE WORK ZONES AND EVIDENCE</h2>
    </div>
    <div class="application-reference-grid">
      <div style="padding:32px;background:#fff;border-radius:16px;border:1px solid #f1f5f9;">
        <h3 style="font-size:20px;font-weight:700;margin-bottom:12px;">ARC-F35 — Reference concept</h3>
        <p style="font-size:15px;color:#64748b;line-height:1.7;margin-bottom:20px;">Review the recorded evidence limits before discussing a configuration. The concept does not demonstrate stadium suitability, reach, platform geometry or transport capability.</p>
        <a href="/products/arc-f35-crawler-ceiling-platform/" class="btn btn--outline-blue">View Reference →</a>
      </div>
      <div style="padding:32px;background:#fff;border-radius:16px;border:1px solid #f1f5f9;">
        <h3 style="font-size:20px;font-weight:700;margin-bottom:12px;">ARC-F31 — Reference concept</h3>
        <p style="font-size:15px;color:#64748b;line-height:1.7;margin-bottom:20px;">This is a separate reference entry, not a proven smaller substitute for another concept. Compare configuration-specific documents before making an access or support decision.</p>
        <a href="/products/arc-f31-crawler-ceiling-platform/" class="btn btn--outline-blue">View Reference →</a>
      </div>
    </div>
  </section>

  <div class="application-guides"><GuideLinks id="stadium-guides" title="Connect the event window to the work area" introduction="Start with stadium access planning, then examine overhead clearance and the proposed work-zone layout." links={stadiumGuides} /></div>

  <section class="cta">
    <h2>PLANNING STADIUM CEILING WORK?</h2>
    <p>Share a non-sensitive outline of the ceiling task and access constraints. ARCLIFT can help organize the questions for configuration review as a technical selection and supply partner.</p>
    <a href="/contact/" class="btn--white">Get a Project Assessment →</a>
  </section>
  <style>
    .application-reference-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; max-width: 1000px; margin: 0 auto; }
    .application-guides { max-width: 1000px; margin: 0 auto; padding: 1rem 24px; }
    @media (max-width: 680px) { .application-reference-grid { grid-template-columns: 1fr; } }
  </style>
</BaseLayout>
