---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import GuideLinks from '../../components/GuideLinks.astro';
import { getGuideLinks } from '../../lib/guide-navigation';
const airportGuides = getGuideLinks(['airport-terminal-maintenance-access-planning', 'airport-terminal-ceiling-access-route-survey-guide', 'crawler-under-ceiling-platform-buyers-guide'], await getCollection('blog'));
---

<BaseLayout
  title="Airport Terminal Ceiling Access — ARCLIFT"
  description="Project screening for crawler platforms used in airport terminal ceiling, lighting and HVAC work, including floor-load, route, power and occupied-space checks."
  transparentNav={false}
>

  <section class="hero-banner" style="--banner-image:url('/images/banners/airport.webp');--banner-position:center 58%;">
    <div class="overline">Airport Terminal</div>
    <h1>AIRPORT CEILING MAINTENANCE</h1>
    <p>Ceiling panels, lighting and HVAC access—subject to floor-load, route, power, security and occupied-space verification.</p>
  </section>

  <section class="sec">
    <div style="max-width:800px;margin:0 auto;">
      <h2 style="font-size:28px;font-weight:800;margin-bottom:20px;">Airport Project Screening</h2>
      <p style="font-size:16px;color:#475569;line-height:1.8;margin-bottom:16px;">Airport terminals combine high clearances, security-controlled routes, passenger flow, sensitive finishes and strict work windows. Equipment selection starts with measured height, doorway and turning envelope, slab capacity, exclusion-zone plan and emergency recovery method.</p>
      <p style="font-size:16px;color:#475569;line-height:1.8;margin-bottom:16px;">The ARC-F family is presented as a reference platform concept. Electric operation, noise, crawler contact pressure and travel-at-height capability must be demonstrated for the exact quoted machine before it is accepted for an occupied terminal.</p>
    </div>
  </section>

  <section class="sec sec--gray">
    <div class="sec__header reveal">
      <div class="sec__overline">Reference concepts</div>
      <h2 class="sec__title">REVIEW THE EVIDENCE BEFORE SELECTION</h2>
    </div>
    <div class="application-reference-grid">
      <div style="padding:32px;background:#fff;border-radius:16px;border:1px solid #f1f5f9;">
        <h3 style="font-size:20px;font-weight:700;margin-bottom:12px;">ARC-F25 — Reference concept</h3>
        <p style="font-size:15px;color:#64748b;line-height:1.7;margin-bottom:20px;">This page records a concept for discussion, not a verified configuration for an airport. Review its evidence status before requesting configuration-specific drawings or floor-load data.</p>
        <a href="/products/arc-f25-crawler-ceiling-platform/" class="btn btn--outline-blue">View Reference →</a>
      </div>
      <div style="padding:32px;background:#fff;border-radius:16px;border:1px solid #f1f5f9;">
        <h3 style="font-size:20px;font-weight:700;margin-bottom:12px;">ARC-F31 — Reference concept</h3>
        <p style="font-size:15px;color:#64748b;line-height:1.7;margin-bottom:20px;">The reference label does not establish reach, power mode or an approved working envelope. The selected configuration and terminal conditions require their own documented review.</p>
        <a href="/products/arc-f31-crawler-ceiling-platform/" class="btn btn--outline-blue">View Reference →</a>
      </div>
    </div>
  </section>

  <div class="application-guides"><GuideLinks id="airport-guides" title="Plan the work window, then survey the route" introduction="The phasing guide addresses when work can take place; the route guide addresses how the equipment reaches the work face. Keep both decisions separate from model approval." links={airportGuides} /></div>

  <section class="cta">
    <h2>AIRPORT CEILING PROJECT ON THE HORIZON?</h2>
    <p>Share a non-sensitive summary of the task, work windows and route constraints. ARCLIFT can organize the open selection questions as a technical selection and supply partner.</p>
    <a href="/contact/" class="btn--white">Request a Project Review →</a>
  </section>
  <style>
    .application-reference-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; max-width: 1000px; margin: 0 auto; }
    .application-guides { max-width: 1000px; margin: 0 auto; padding: 1rem 24px; }
    @media (max-width: 680px) { .application-reference-grid { grid-template-columns: 1fr; } }
  </style>
</BaseLayout>
