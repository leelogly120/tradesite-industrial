---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Applications — Crawler Under-Ceiling Platform Use Cases"
  description="ARC lifts and platforms for stadium ceiling construction, airport terminal maintenance, and warehouse steel structure ceiling work."
  transparentNav={false}
>

  <!-- HERO BANNER -->
  <section class="hero-banner">
    <div class="overline">Solutions</div>
    <h1>BUILT FOR THESE CEILINGS</h1>
    <p>Specialized aerial access solutions for tall indoor spaces. From stadiums to airports to warehouses.</p>
  </section>

  <!-- STADIUM -->
  <section class="sec">
    <div class="scenario reveal">
      <div class="scenario__visual">
        <div style="font-size:14px;color:#94a3b8;">[Stadium Ceiling Image]</div>
      </div>
      <div class="scenario__text">
        <div class="scenario__tag">Stadium & Arena</div>
        <h3>Stadium Ceiling Solutions</h3>
        <p>Large-span steel structures, acoustic panel installation, rigging access, and lighting maintenance. Our pick & carry platforms eliminate scaffolding entirely for faster, safer ceiling work.</p>
        <div class="scenario__features">
          <span class="scenario__feature"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>35m+ Reach</span>
          <span class="scenario__feature"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>3T Load Capacity</span>
          <span class="scenario__feature"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>Floor Protection</span>
          <span class="scenario__feature"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>Remote Control</span>
        </div>
        <div class="scenario__btns">
          <a href="/applications/stadium/" class="btn btn--primary">View Details →</a>
          <a href="/contact/" class="btn btn--outline-blue">Get a Quote</a>
        </div>
      </div>
    </div>
  </section>

  <!-- AIRPORT -->
  <section class="sec sec--gray">
    <div class="scenario scenario--reverse reveal">
      <div class="scenario__visual">
        <div style="font-size:14px;color:#94a3b8;">[Airport Terminal Image]</div>
      </div>
      <div class="scenario__text">
        <div class="scenario__tag">Airport Terminal</div>
        <h3>Airport Ceiling Maintenance</h3>
        <p>Ceiling panel installation and maintenance, lighting system upgrades, HVAC access, and emergency repair. Dual power system enables zero-emission indoor operation in occupied terminals.</p>
        <div class="scenario__features">
          <span class="scenario__feature"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>Zero Emissions</span>
          <span class="scenario__feature"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>24/7 Operation</span>
          <span class="scenario__feature"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>Low Noise</span>
          <span class="scenario__feature"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>Compact Access</span>
        </div>
        <div class="scenario__btns">
          <a href="/applications/airport/" class="btn btn--primary">View Details →</a>
          <a href="/contact/" class="btn btn--outline-blue">Get a Quote</a>
        </div>
      </div>
    </div>
  </section>

  <!-- WAREHOUSE -->
  <section class="sec">
    <div class="scenario reveal">
      <div class="scenario__visual">
        <div style="font-size:14px;color:#94a3b8;">[Warehouse Ceiling Image]</div>
      </div>
      <div class="scenario__text">
        <div class="scenario__tag">Warehouse & Factory</div>
        <h3>Industrial Ceiling Construction</h3>
        <p>High-bay ceiling construction, overhead crane rail installation, mezzanine work, and routine maintenance. Pick & carry eliminates scaffolding for massive efficiency gains.</p>
        <div class="scenario__features">
          <span class="scenario__feature"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>30% Faster</span>
          <span class="scenario__feature"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>12m×8m Platform</span>
          <span class="scenario__feature"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>Pick & Carry</span>
          <span class="scenario__feature"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>All-Terrain Tracks</span>
        </div>
        <div class="scenario__btns">
          <a href="/applications/warehouse/" class="btn btn--primary">View Details →</a>
          <a href="/contact/" class="btn btn--outline-blue">Get a Quote</a>
        </div>
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section class="sec sec--dark">
    <div class="stats reveal">
      <div class="stat"><div class="stat__num">30%</div><div class="stat__label">Faster Than Scaffolding</div></div>
      <div class="stat"><div class="stat__num">12m×8m</div><div class="stat__label">Maximum Platform</div></div>
      <div class="stat"><div class="stat__num">360°</div><div class="stat__label">Full Rotation</div></div>
      <div class="stat"><div class="stat__num">24/7</div><div class="stat__label">Global Support</div></div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta">
    <h2>NOT SURE WHICH SOLUTION FITS YOUR PROJECT?</h2>
    <p>Tell us about your ceiling project and our engineering team will recommend the right model.</p>
    <a href="/contact/" class="btn--white">Get a Free Consultation →</a>
  </section>
</BaseLayout>
