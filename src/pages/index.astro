---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const products = (await getCollection('products'))
  .filter(p => !p.data.draft && p.data.category === 'Aerial Work Platforms')
  .sort((a, b) => {
    const aH = parseInt(a.data.specifications?.['Max Working Height'] || '0');
    const bH = parseInt(b.data.specifications?.['Max Working Height'] || '0');
    return aH - bH;
  });

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://arclifteq.com';
---

<BaseLayout
  title="Crawler Under-Ceiling Aerial Work Platform — FDDPT Series"
  description="20m–35m crawler under-ceiling aerial work platforms with pick & carry mega-platform capability. Ideal for stadium, airport & warehouse ceiling work."
  ogImage="/images/og-home.jpg"
>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'ARCLIFT Equipment Co., Ltd.',
    url: siteUrl,
    logo: `${siteUrl}/images/logo.png`,
    description: 'Professional manufacturer of crawler under-ceiling aerial work platforms — FDDPT series, 20m–35m reach.',
    contactPoint: {
      '@type': 'ContactPoint',
      telephone: '+86 15617687185',
      contactType: 'sales',
      availableLanguage: ['English', 'Chinese'],
    },
    areaServed: 'Worldwide',
  })} />

  <!-- HERO -->
  <section class="hero">
    <div class="hero__bg" style="background-image: url('https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=1920&q=80');"></div>
    <div class="hero__content">
      <div class="hero__overline">Pick & Carry Technology</div>
      <h1 class="hero__title">THE WORLD'S CEILING<br>DOESN'T BUILD <em>ITSELF</em></h1>
      <p class="hero__desc">Revolutionary pick & carry aerial platforms. 30% faster than scaffolding. Built for stadium, airport & warehouse ceilings.</p>
      <div class="hero__actions">
        <a href="/contact/" class="btn btn--primary">Get a Quote →</a>
        <a href="/products/" class="btn btn--outline">Explore Products</a>
      </div>
    </div>
    <div class="hero__scroll">
      <div class="hero__scroll-line"></div>
      <span>Scroll</span>
    </div>
  </section>

  <!-- TRUST BAR -->
  <div class="trust">
    <span class="trust__text">Trusted by contractors in 40+ countries</span>
    <div class="trust__items">
      <div class="trust__item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg> CE Certified</div>
      <div class="trust__item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg> ISO 9001</div>
      <div class="trust__item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg> ISO 16368</div>
      <div class="trust__item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg> 24h Response</div>
    </div>
  </div>

  <!-- PRODUCTS -->
  <section class="sec sec--white">
    <div class="sec__header reveal">
      <div class="sec__overline">Our Products</div>
      <h2 class="sec__title">FDDPT SERIES</h2>
      <p class="sec__desc">Pick & carry aerial platforms engineered for maximum productivity</p>
    </div>
    <div class="products">
      {products.map((p, i) => {
        const specs = p.data.specifications || {};
        const height = specs['Max Working Height'] || '—';
        const load = specs['Safe Working Load'] || '—';
        const isFlagship = p.data.title.includes('35M');
        return (
          <a href={`/products/${p.id}/`} class:list={['p-card', 'reveal', `reveal-d${i + 1}`]}>
            <div class="p-card__img">FDDPT-{height}</div>
            <div class="p-card__body">
              <div class="p-card__tag">{isFlagship ? 'Flagship' : 'FDDPT'}</div>
              <div class="p-card__name">{p.data.title.split(' ')[0]}</div>
              <div class="p-card__specs">
                <span class="p-card__spec"><b>{height}</b> Reach</span>
                <span class="p-card__spec"><b>{load}</b> Load</span>
              </div>
              <span class="p-card__link">View Details →</span>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <!-- FEATURE 1: Pick & Carry -->
  <section class="sec sec--gray">
    <div class="split reveal">
      <div class="split__visual" style="background: linear-gradient(135deg, #e0e7ff, #c7d2fe); border-radius: 20px; height: 480px; display: flex; align-items: center; justify-content: center; font-size: 14px; color: #6366f1;">[Pick & Carry Demo]</div>
      <div class="split__text">
        <div class="sec__overline" style="text-align:left;">Core Technology</div>
        <h3>PICK & CARRY</h3>
        <p>Unlike spider lifts that must stop to reposition, our FDDPT series keeps working while moving. The platform travels while elevated with a full load — 3× faster cycle time per ceiling panel.</p>
        <a href="/products/" class="link">Learn More →</a>
      </div>
    </div>
  </section>

  <!-- FEATURE 2: Dual Power -->
  <section class="sec sec--white">
    <div class="split split--reverse reveal">
      <div class="split__visual" style="background: linear-gradient(135deg, #dbeafe, #bfdbfe); border-radius: 20px; height: 480px; display: flex; align-items: center; justify-content: center; font-size: 14px; color: #3b82f6;">[Dual Power System]</div>
      <div class="split__text">
        <div class="sec__overline" style="text-align:left;">Power System</div>
        <h3>DUAL POWER</h3>
        <p>150hp diesel engine for outdoor travel + twin electric motors for enclosed spaces. Zero emissions, zero noise restrictions indoors.</p>
        <a href="/about/" class="link">Learn More →</a>
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section class="sec sec--dark">
    <div class="stats reveal">
      <div class="stat"><div class="stat__num">30%</div><div class="stat__label">Faster Than Scaffolding</div></div>
      <div class="stat"><div class="stat__num">12m×8m</div><div class="stat__label">Maximum Platform</div></div>
      <div class="stat"><div class="stat__num">360°</div><div class="stat__label">Full Rotation</div></div>
      <div class="stat"><div class="stat__num">24/7</div><div class="stat__label">Global Support</div></div>
    </div>
  </section>

  <!-- APPLICATIONS -->
  <section class="sec sec--white">
    <div class="sec__header reveal">
      <div class="sec__overline">Applications</div>
      <h2 class="sec__title">BUILT FOR THESE CEILINGS</h2>
      <p class="sec__desc">Specialized aerial access for tall indoor spaces</p>
    </div>
    <div class="apps">
      <a href="/applications/stadium/" class="app reveal reveal-d1">
        <div class="app__arrow">→</div>
        <div class="app__body"><h3>Stadium & Arena</h3><p>Large-span steel structures, acoustic panel installation</p></div>
      </a>
      <a href="/applications/airport/" class="app reveal reveal-d2">
        <div class="app__arrow">→</div>
        <div class="app__body"><h3>Airport Terminal</h3><p>Ceiling panel maintenance, lighting upgrade, HVAC access</p></div>
      </a>
      <a href="/applications/warehouse/" class="app reveal reveal-d3">
        <div class="app__arrow">→</div>
        <div class="app__body"><h3>Warehouse & Factory</h3><p>High-bay ceiling construction, overhead crane rail</p></div>
      </a>
    </div>
  </section>

  <!-- COMPARISON -->
  <section class="sec sec--gray">
    <div class="sec__header reveal">
      <div class="sec__overline">Why ARCLIFT</div>
      <h2 class="sec__title">PICK & CARRY vs THE REST</h2>
    </div>
    <div class="comp reveal">
      <table>
        <thead><tr><th>Feature</th><th class="hl">FDDPT Pick & Carry</th><th>Spider Lift</th><th>Scaffolding</th></tr></thead>
        <tbody>
          <tr><td>Platform Size</td><td class="hl">12m×3m → 12m×8m</td><td>~2m×1m basket</td><td>1m-wide planks</td></tr>
          <tr><td>Load While Moving</td><td class="hl yes">✓ 0.3–3T</td><td class="no">✗ Must stow</td><td class="no">✗ Static only</td></tr>
          <tr><td>Setup Time</td><td class="hl yes">✓ Minutes</td><td>15–30 min</td><td>Days per bay</td></tr>
          <tr><td>Indoor Operation</td><td class="hl yes">✓ Dual Power</td><td>Diesel/Electric</td><td>N/A</td></tr>
          <tr><td>Remote Control</td><td class="hl yes">✓ Full Remote</td><td>Platform controls</td><td class="no">✗ Manual</td></tr>
        </tbody>
      </table>
    </div>
    <div style="text-align:center;margin-top:2rem;">
      <a href="/compare/" class="btn btn--primary">View Full Comparison →</a>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta">
    <h2>READY TO IMPROVE YOUR EFFICIENCY?</h2>
    <p>Get a free quote within 24 hours. Our engineering team will recommend the right model.</p>
    <a href="/contact/" class="btn--white">Get a Free Quote →</a>
    <div class="cta__contacts">
      <a href="https://wa.me/8615617687185">WhatsApp: +86 15617687185</a>
      <a href="mailto:leelogly120@gmail.com">leelogly120@gmail.com</a>
    </div>
  </section>
</BaseLayout>
