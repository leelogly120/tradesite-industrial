---
import BaseLayout from '../layouts/BaseLayout.astro';
import EquipmentDiagram from '../components/EquipmentDiagram.astro';
import { getCollection } from 'astro:content';

const allProducts = (await getCollection('products')).filter((product) => !product.data.draft);
const HOME_CATEGORIES = [
  {
    id: 'crawler-roll-forming-lifts',
    family: 'crawler',
    name: 'Crawler Roll Forming Lifts',
    range: 'Archived model references',
    desc: 'Self-propelled crawler base concepts for positioning a compatible forming line near roof level.',
  },
  {
    id: 'truck-mounted-roll-forming-lifts',
    family: 'truck',
    name: 'Truck-Mounted Roll Forming Lifts',
    range: 'Route review required',
    desc: 'Truck-mounted concepts where road transfer, chassis, stabilizer space and working position drive selection.',
  },
  {
    id: 'crawler-ceiling-platforms',
    family: 'ceiling',
    name: 'Crawler Ceiling Platforms',
    range: 'Working envelope by model',
    desc: 'Large-deck crawler concepts for under-ceiling and wall-panel work, separate from the roof-forming workflow.',
  },
  {
    id: 'roll-forming-machines',
    family: 'former',
    name: 'Roll Forming Machines',
    range: 'Profile-led selection',
    desc: 'Compatible forming lines selected from the profile drawing, material, thickness, coil and electrical inputs.',
  },
] as const;

const homeCats = HOME_CATEGORIES.map((category) => ({
  ...category,
  items: allProducts.filter((product) => product.data.category === category.name),
}));
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://arclifteq.com';
const editorialDisclosure = 'AI-assisted editorial visual — representative only; not model-specific evidence.';
---

<BaseLayout
  title="Roof-Level Roll Forming Lifts & Crawler Ceiling Platforms"
  description="Technical selection and supply support for crawler and truck-mounted roof-level roll-forming systems, plus large-deck crawler ceiling-platform concepts."
  ogImage="/images/og-home.jpg"
>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'ARCLIFT Equipment Co., Ltd.',
    url: siteUrl,
    logo: `${siteUrl}/images/logo.png`,
    description: 'Integrated equipment supplier supporting technical selection for roof-level roll forming lifts and large-deck crawler platform concepts.',
    contactPoint: {
      '@type': 'ContactPoint',
      telephone: '+86 15617687185',
      contactType: 'sales',
      availableLanguage: ['English', 'Chinese'],
    },
  })} />

  <section class="hero hero--product-first">
    <div class="hero__inner">
      <div class="hero__content">
        <div class="hero__overline">Specialized roof-level forming equipment</div>
        <h1 class="hero__title" id="hero-title">Roll-forming lifts for roof-level panel production</h1>
        <p class="hero__desc">ARCLIFT is an integrated equipment supplier for crawler and truck-mounted roof-level roll-forming lifts, plus separate large-deck crawler ceiling platforms.</p>
        <div class="hero__actions">
          <a href="/products/" class="btn btn--primary">Explore Products</a>
          <a href="/contact/" class="btn btn--outline">Get a Quote →</a>
        </div>
      </div>
      <div class="hero__diagram">
        <EquipmentDiagram family="crawler" />
      </div>
    </div>
  </section>

  <div class="trust">
    <span class="trust__text">Technical selection and supply support</span>
    <div class="trust__items">
      <div class="trust__item">✓ 12–32m Historical Reference</div>
      <div class="trust__item">✓ Crawler & Truck Options</div>
      <div class="trust__item">✓ Destination Requirement Review</div>
      <div class="trust__item">✓ Quote After Input Review</div>
    </div>
  </div>

  <section class="sec sec--white" aria-labelledby="product-families-title">
    <div class="sec__header reveal">
      <div class="sec__overline">Choose an equipment architecture</div>
      <h2 class="sec__title" id="product-families-title">FOUR PRODUCT FAMILIES</h2>
      <p class="sec__desc">Start with the work task and system architecture, then review the {allProducts.length} retained references and their evidence limits.</p>
    </div>
    <div class="family-paths">
      {homeCats.map((category) => (
        <a href={`/products/#${category.id}`} class="family-path reveal">
          <EquipmentDiagram family={category.family} compact />
          <div class="family-path__body">
            <div class="p-card__tag">{category.items.length} retained {category.items.length === 1 ? 'reference' : 'references'}</div>
            <h3>{category.name}</h3>
            <strong>{category.range}</strong>
            <p>{category.desc}</p>
            <span class="p-card__link">Review this family →</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="sec sec--gray">
    <div class="split split--reverse reveal">
      <figure class="split__visual">
        <img src="/images/home/roof-panel-output.webp" alt="Long standing-seam roof panels fed from a roll forming line at roof level" width="1200" height="800" loading="lazy" />
        <figcaption>{editorialDisclosure}</figcaption>
      </figure>
      <div class="split__text">
        <div class="sec__overline" style="text-align:left;">Primary workflow</div>
        <h2>FORM PANELS NEAR ROOF LEVEL</h2>
        <p>A compatible forming line may be positioned near eave level so long panels move toward the roof crew with fewer handling steps. Selection still depends on profile, material, panel length, line mass, feed direction and the site wind plan.</p>
        <a href="/products/#crawler-roll-forming-lifts" class="link">See Roll Forming Lifts →</a>
      </div>
    </div>
  </section>

  <section class="sec sec--white">
    <div class="split reveal">
      <figure class="split__visual">
        <img src="/images/home/under-ceiling-field-v2.webp" srcset="/images/home/under-ceiling-field-v2-800.webp 800w, /images/home/under-ceiling-field-v2.webp 1200w" sizes="(max-width: 1024px) calc(100vw - 48px), 50vw" alt="ARCLIFT-branded large crawler under-ceiling platform working inside a steel structure" width="1200" height="800" loading="lazy" />
        <figcaption>{editorialDisclosure}</figcaption>
      </figure>
      <div class="split__text">
        <div class="sec__overline" style="text-align:left;">Separate access family</div>
        <h2>LARGE-DECK UNDER-CEILING ACCESS</h2>
        <p>For selected ARC-F references, review deck use, travel state, allowable load, floor pressure and route clearance against the chosen equipment data and actual site conditions.</p>
        <a href="/products/#crawler-ceiling-platforms" class="link">Review Ceiling Platforms →</a>
      </div>
    </div>
  </section>

  <section class="sec sec--dark spec-band" id="key-specifications">
    <div class="stats reveal">
      <div class="stat"><div class="stat__num"><span>12–32</span><small class="stat__unit">m</small></div><div class="stat__label"><span>Historical lift-height reference</span><small>Archived range; verify the selected model</small></div></div>
      <div class="stat"><div class="stat__num"><span>8 / 11 / 20</span><small class="stat__unit">t</small></div><div class="stat__label"><span>Historical equipment classes</span><small>Not platform or personnel payload</small></div></div>
      <div class="stat"><div class="stat__num"><span>0.3–1.0</span><small class="stat__unit">mm</small></div><div class="stat__label"><span>Historical sheet-thickness reference</span><small>Material and profile dependent</small></div></div>
      <div class="stat"><div class="stat__num"><span>380</span><small class="stat__unit">V</small></div><div class="stat__label"><span>Common line-voltage reference</span><small>Destination and project specific</small></div></div>
    </div>
  </section>

  <section class="sec sec--white">
    <div class="sec__header reveal">
      <div class="sec__overline">Applications</div>
      <h2 class="sec__title">START WITH THE SITE AND WORK TASK</h2>
      <p class="sec__desc">Application routes organize the inputs to review; they do not establish model suitability.</p>
    </div>
    <div class="apps">
      {[
        { href: '/applications/stadium/', image: '/images/home/wall-panel-platform.webp', alt: 'Representative wall-panel platform visual in a steel structure', title: 'Stadium & Arena', text: 'Review span, floor loading, work zone and panel handling.' },
        { href: '/applications/airport/', image: '/images/home/under-ceiling-field-v2.webp', small: '/images/home/under-ceiling-field-v2-800.webp', alt: 'Representative under-ceiling platform visual in a steel structure', title: 'Airport Terminal', text: 'Review access windows, ceiling services and public-area controls.' },
        { href: '/applications/warehouse/', image: '/images/home/roof-panel-output.webp', alt: 'Representative roof-panel forming visual in an industrial structure', title: 'Warehouse & Industrial Building', text: 'Review aisle width, floor condition, overhead services and work sequence.' },
      ].map((application) => (
        <a href={application.href} class="app reveal" aria-label={`${application.title} planning route. ${editorialDisclosure}`}>
          <div class="app__media"><img class="app__image" src={application.image} srcset={application.small ? `${application.small} 800w, ${application.image} 1200w` : undefined} sizes={application.small ? '(max-width: 1024px) calc(100vw - 48px), 33vw' : undefined} alt={application.alt} width="1200" height="800" loading="lazy" /></div>
          <div class="app__arrow">→</div>
          <div class="app__body"><span class="app__caption">{editorialDisclosure}</span><h3>{application.title}</h3><p>{application.text}</p></div>
        </a>
      ))}
    </div>
  </section>

  <section class="sec sec--gray">
    <div class="sec__header reveal">
      <div class="sec__overline">Selection map</div>
      <h2 class="sec__title">COMPARE THE ARCHITECTURE FIRST</h2>
    </div>
    <div class="comp reveal">
      <table>
        <thead><tr><th>Family</th><th>Primary task</th><th>Decision-driving inputs</th><th>Evidence boundary</th></tr></thead>
        <tbody>
          <tr><td>Crawler roll-forming lift</td><td>Position a compatible forming line near the roof work face</td><td>Ground, height, line mass, feed path</td><td>Archived model data; verify configuration</td></tr>
          <tr><td>Truck-mounted roll-forming lift</td><td>Combine road-transfer concept with roof-level forming</td><td>Chassis, road limits, stabilizer space, site access</td><td>Destination and local chassis review required</td></tr>
          <tr><td>Crawler ceiling platform</td><td>Large-deck under-ceiling or wall-panel access</td><td>Envelope, load, floor pressure, travel route</td><td>Model and site review required</td></tr>
          <tr><td>Roll-forming machine</td><td>Form the specified panel profile</td><td>Drawing, material, thickness, coil, electrical supply</td><td>Profile-led configuration; no universal line</td></tr>
        </tbody>
      </table>
    </div>
    <div style="text-align:center;margin-top:2rem;"><a href="/compare/" class="btn btn--primary">Open the Comparison Workspace →</a></div>
  </section>

  <section class="cta">
    <h2>READY TO REVIEW YOUR PROJECT INPUTS?</h2>
    <p>Send the building height, panel profile, coil and former mass, site layout and destination market. ARCLIFT will review relevant references, outline open engineering inputs and identify items requiring local confirmation.</p>
    <a href="/contact/" class="btn--white">Send Project Details →</a>
    <div class="cta__contacts">
      <a href="https://wa.me/8615617687185">WhatsApp: +86 15617687185</a>
      <a href="mailto:leelogly120@gmail.com">leelogly120@gmail.com</a>
    </div>
  </section>
</BaseLayout>
