---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allProducts = (await getCollection('products')).filter(p => !p.data.draft);

const HOME_CATEGORIES = [
  {
    id: 'crawler-roll-forming-lifts',
    name: 'Crawler Roll Forming Lifts',
    range: '17m – 32m',
    desc: 'Crawler platforms configured to lift a compatible roll forming line toward roof level. 5 reference models.',
  },
  {
    id: 'truck-mounted-roll-forming-lifts',
    name: 'Truck-Mounted Roll Forming Lifts',
    range: '12m – 31m',
    desc: 'Truck-mounted forming systems, including a 40HQ-oriented split configuration. 5 reference models.',
  },
  {
    id: 'crawler-ceiling-platforms',
    name: 'Crawler Ceiling Platforms',
    range: '20m – 35m',
    desc: 'Large-deck under-ceiling platform concepts pending model-specific verification. 4 reference models.',
  },
  {
    id: 'roll-forming-machines',
    name: 'Roll Forming Machines',
    range: 'Standing seam',
    desc: 'Panel-forming lines matched to the profile drawing and selected lifting platform. 1 reference model.',
  },
];

function heightNum(p: any): number {
  const specs = p.data.specifications || {};
  const h = specs['Lift Height (to shear exit)'] || specs['Max Working Height'] || '';
  const m = String(h).match(/(\d+(?:\.\d+)?)/);
  return m ? parseFloat(m[1]) : 0;
}

const homeCats = HOME_CATEGORIES.map(cat => ({
  ...cat,
  items: allProducts
    .filter(p => p.data.category === cat.name)
    .sort((a, b) => heightNum(a) - heightNum(b)),
}));

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://arclifteq.com';
---

<BaseLayout
  title="High-Altitude Roll Forming Lifts & Crawler Ceiling Platforms"
  description="Crawler and truck-mounted lifting systems for roll forming at roof level, plus engineered crawler platforms for under-ceiling and wall-panel work."
  ogImage="/images/og-home.jpg"
>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'ARCLIFT Equipment Co., Ltd.',
    url: siteUrl,
    logo: `${siteUrl}/images/logo.png`,
    description: 'Export-facing project engineering and product presentation for high-altitude roll forming lifts and large-deck crawler platforms.',
    contactPoint: {
      '@type': 'ContactPoint',
      telephone: '+86 15617687185',
      contactType: 'sales',
      availableLanguage: ['English', 'Chinese'],
    },
  })} />

  <!-- HERO WITH CAROUSEL -->
  <section class="hero">
    <div class="hero__carousel">
      <div class="hero__slide hero__slide--brand hero__slide--active" style="background-image: url('/images/hero/hero-1-arclift.webp');" data-overline="Under-Ceiling Work Platform" data-title="A LARGE WORK DECK AT HEIGHT" data-desc="Purpose-built platforms for steel-building ceilings, installation crews and material handling. Final load, travel mode and deck geometry are engineered for the project."></div>
      <div class="hero__slide" style="background-image: url('/images/hero/hero-2.webp');" data-overline="Aerial Roll Forming" data-title="FORM PANELS AT ROOF LEVEL" data-desc="Move the forming line to eave height and feed long roof panels directly toward the installation area. This can reduce repeated ground handling and reliance on crane lifts."></div>
      <div class="hero__slide" style="background-image: url('/images/hero/hero-3.webp');" data-overline="Export-Oriented Configuration" data-title="DESIGNED AROUND THE ROUTE" data-desc="Transport envelope, split points, local chassis and commissioning plan are confirmed before production. 40HQ-compatible configurations are available for selected projects."></div>
      <div class="hero__slide" style="background-image: url('/images/hero/hero-4.webp');" data-overline="Matched Roll Forming Line" data-title="PROFILE-SPECIFIC TOOLING" data-desc="Roll tooling, material thickness, drive power, hydraulic shear and controls are matched to your drawing and project workflow."></div>
      <div class="hero__slide" style="background-image: url('/images/hero/hero-5.webp');" data-overline="Wall & Facade Installation" data-title="POSITION CREWS AND PANELS" data-desc="Special platform layouts support vertical wall-panel and facade work where conventional baskets provide too little working area."></div>
    </div>
    <div class="hero__overlay"></div>
    <div class="hero__content">
      <div class="hero__overline" id="hero-overline">Under-Ceiling Work Platform</div>
      <h1 class="hero__title" id="hero-title">A LARGE WORK<br>DECK AT <em>HEIGHT</em></h1>
      <p class="hero__desc" id="hero-desc">Purpose-built platforms for steel-building ceilings, installation crews and material handling. Final load, travel mode and deck geometry are engineered for the project.</p>
      <div class="hero__actions">
        <a href="/contact/" class="btn btn--primary">Get a Quote →</a>
        <a href="/products/" class="btn btn--outline">Explore Products</a>
      </div>
    </div>
    <div class="hero__dots">
      <button class="hero__dot hero__dot--active" data-index="0"></button>
      <button class="hero__dot" data-index="1"></button>
      <button class="hero__dot" data-index="2"></button>
      <button class="hero__dot" data-index="3"></button>
      <button class="hero__dot" data-index="4"></button>
    </div>
    <div class="hero__scroll">
      <div class="hero__scroll-line"></div>
      <span>Scroll</span>
    </div>
  </section>

  <script>
    // Hero Carousel
    const slides = document.querySelectorAll('.hero__slide');
    const dots = document.querySelectorAll('.hero__dot');
    const heroOverline = document.getElementById('hero-overline');
    const heroTitle = document.getElementById('hero-title');
    const heroDesc = document.getElementById('hero-desc');
    let currentSlide = 0;
    const slideInterval = 6000; // 6 seconds

    function goToSlide(index) {
      // Fade out current content
      heroOverline.style.opacity = '0';
      heroTitle.style.opacity = '0';
      heroDesc.style.opacity = '0';

      setTimeout(() => {
        // Update slide
        slides[currentSlide].classList.remove('hero__slide--active');
        dots[currentSlide].classList.remove('hero__dot--active');
        currentSlide = index;
        slides[currentSlide].classList.add('hero__slide--active');
        dots[currentSlide].classList.add('hero__dot--active');

        // Update content
        const slide = slides[currentSlide];
        heroOverline.textContent = slide.dataset.overline;
        heroTitle.innerHTML = slide.dataset.title.replace('<em>', '<em>').replace('</em>', '</em>');
        heroDesc.textContent = slide.dataset.desc;

        // Fade in new content
        heroOverline.style.opacity = '1';
        heroTitle.style.opacity = '1';
        heroDesc.style.opacity = '1';
      }, 300);
    }

    function nextSlide() {
      goToSlide((currentSlide + 1) % slides.length);
    }

    // Auto-rotate
    let carouselTimer = setInterval(nextSlide, slideInterval);

    // Dot click
    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        clearInterval(carouselTimer);
        goToSlide(i);
        carouselTimer = setInterval(nextSlide, slideInterval);
      });
    });

    // Pause on hover
    const heroSection = document.querySelector('.hero');
    heroSection.addEventListener('mouseenter', () => clearInterval(carouselTimer));
    heroSection.addEventListener('mouseleave', () => {
      carouselTimer = setInterval(nextSlide, slideInterval);
    });
  </script>

  <!-- TRUST BAR -->
  <div class="trust">
    <span class="trust__text">Project-engineered lifting and forming systems</span>
    <div class="trust__items">
      <div class="trust__item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg> 12–32m Reference Range</div>
      <div class="trust__item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg> Crawler & Truck Options</div>
      <div class="trust__item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg> Project-Specific Compliance</div>
      <div class="trust__item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg> Configuration Before Quote</div>
    </div>
  </div>

  <!-- PRODUCTS BY CATEGORY -->
  <section class="sec sec--white">
    <div class="sec__header reveal">
      <div class="sec__overline">Our Products</div>
      <h2 class="sec__title">FOUR PRODUCT LINES</h2>
      <p class="sec__desc">Roll forming lifts, large-deck platform concepts and forming machines — {allProducts.length} reference models organized by project workflow</p>
    </div>
    <div class="products">
      {homeCats.map((cat, i) => (
        <a href={`/products/#${cat.id}`} class:list={['p-card', 'reveal', `reveal-d${i + 1}`]}>
          {cat.items[0]?.data.images?.[0] ? (
            <div class="p-card__img" style={`background-image:url('${cat.items[0].data.images[0]}');background-size:cover;background-position:center;`}></div>
          ) : (
            <div class="p-card__img">{cat.name}</div>
          )}
          <div class="p-card__body">
            <div class="p-card__tag">{cat.items.length} {cat.items.length === 1 ? 'Model' : 'Models'}</div>
            <div class="p-card__name">{cat.name}</div>
            <div class="p-card__specs">
              <span class="p-card__spec"><b>{cat.range}</b></span>
            </div>
            <p style="font-size:13px;color:#64748b;margin:8px 0 12px;line-height:1.5;">{cat.desc}</p>
            <span class="p-card__link">View Models →</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- FEATURE 1: Pick & Carry -->
  <section class="sec sec--gray">
    <div class="split reveal">
      <div class="split__visual"><img src="/images/home/under-ceiling-field-v2.webp" alt="ARCLIFT-branded large crawler under-ceiling platform working inside a steel structure" width="1200" height="800" loading="lazy" /></div>
      <div class="split__text">
        <div class="sec__overline" style="text-align:left;">Core Technology</div>
        <h3>PICK & CARRY</h3>
        <p>Selected ARC-F reference configurations are designed around a large work deck and controlled repositioning. Travel-at-height, allowable load and floor pressure are engineering values that must be confirmed for the final machine and site.</p>
        <a href="/products/" class="link">Learn More →</a>
      </div>
    </div>
  </section>

  <!-- FEATURE 2: Dual Power -->
  <section class="sec sec--white">
    <div class="split split--reverse reveal">
      <div class="split__visual"><img src="/images/home/roof-panel-output.webp" alt="Long standing-seam roof panels fed from a roll forming line at roof level" width="1200" height="800" loading="lazy" /></div>
      <div class="split__text">
        <div class="sec__overline" style="text-align:left;">Roofing Workflow</div>
        <h3>FORM AT ROOF LEVEL</h3>
        <p>A complete forming line can be raised close to the eave so panels move directly toward the roof crew. The method reduces repeated handling; profile, material, panel length and site wind plan remain project-specific.</p>
        <a href="/products/#crawler-roll-forming-lifts" class="link">See Roll Forming Lifts →</a>
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section class="sec sec--dark spec-band" id="key-specifications">
    <div class="stats reveal">
      <div class="stat"><div class="stat__num"><span>12–32</span><small class="stat__unit">m</small></div><div class="stat__label">Documented Lift Heights</div></div>
      <div class="stat"><div class="stat__num"><span>8 / 11 / 20</span><small class="stat__unit">t</small></div><div class="stat__label">Archived Lift Classes</div></div>
      <div class="stat"><div class="stat__num"><span>0.3–1.0</span><small class="stat__unit">mm</small></div><div class="stat__label">Documented Sheet Range</div></div>
      <div class="stat"><div class="stat__num"><span>380</span><small class="stat__unit">V</small></div><div class="stat__label">Common Line Supply</div></div>
    </div>
  </section>

  <!-- APPLICATIONS -->
  <section class="sec sec--white">
    <div class="sec__header reveal">
      <div class="sec__overline">Applications</div>
      <h2 class="sec__title">PLATFORMS FOR HIGH-BAY INTERIORS</h2>
      <p class="sec__desc">Reference applications for large-span indoor installation and maintenance work</p>
    </div>
    <div class="apps">
      <a href="/applications/stadium/" class="app reveal reveal-d1" style="background-image:url('/images/home/wall-panel-platform.webp');background-size:cover;background-position:center;">
        <div class="app__arrow">→</div>
        <div class="app__body"><h3>Stadium & Arena</h3><p>Large-span steel structures, acoustic panel installation</p></div>
      </a>
      <a href="/applications/airport/" class="app reveal reveal-d2" style="background-image:url('/images/home/under-ceiling-field-v2.webp');background-size:cover;background-position:center;">
        <div class="app__arrow">→</div>
        <div class="app__body"><h3>Airport Terminal</h3><p>Ceiling panel maintenance, lighting upgrade, HVAC access</p></div>
      </a>
      <a href="/applications/warehouse/" class="app reveal reveal-d3" style="background-image:url('/images/home/roof-panel-output.webp');background-size:cover;background-position:center;">
        <div class="app__arrow">→</div>
        <div class="app__body"><h3>Warehouse & Factory</h3><p>High-bay ceiling construction, overhead crane rail</p></div>
      </a>
    </div>
  </section>

  <!-- COMPARISON -->
  <section class="sec sec--gray">
    <div class="sec__header reveal">
      <div class="sec__overline">Why ARCLIFT</div>
      <h2 class="sec__title">CHOOSE BY PROJECT FIT</h2>
    </div>
    <div class="comp reveal">
      <table>
        <thead><tr><th>Planning Factor</th><th class="hl">ARC Large-Deck Concept</th><th>Spider Lift</th><th>Scaffolding</th></tr></thead>
        <tbody>
          <tr><td>Working Area</td><td class="hl">Large deck, project-defined</td><td>Compact personnel basket</td><td>Site-built working bays</td></tr>
          <tr><td>Load While Moving</td><td class="hl">Configuration-dependent</td><td>Model-dependent</td><td class="no">✗ Static only</td></tr>
          <tr><td>Setup Method</td><td class="hl yes">✓ Integrated platform</td><td>Outrigger cycle</td><td>Bay-by-bay erection</td></tr>
          <tr><td>Indoor Operation</td><td class="hl">Electric option by project</td><td>Model-dependent</td><td>N/A</td></tr>
          <tr><td>Control Arrangement</td><td class="hl">Remote option by configuration</td><td>Model-dependent controls</td><td class="no">Manual access system</td></tr>
        </tbody>
      </table>
    </div>
    <div style="text-align:center;margin-top:2rem;">
      <a href="/compare/" class="btn btn--primary">View Full Comparison →</a>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta">
    <h2>READY TO DEFINE YOUR CONFIGURATION?</h2>
    <p>Send the building height, panel profile, coil/former weight, site layout and destination market. We will confirm the suitable reference configuration and compliance path.</p>
    <a href="/contact/" class="btn--white">Send Project Details →</a>
    <div class="cta__contacts">
      <a href="https://wa.me/8615617687185">WhatsApp: +86 15617687185</a>
      <a href="mailto:leelogly120@gmail.com">leelogly120@gmail.com</a>
    </div>
  </section>
</BaseLayout>
