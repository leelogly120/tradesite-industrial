---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allProducts = (await getCollection('products')).filter(p => !p.data.draft);

const HOME_CATEGORIES = [
  {
    id: 'crawler-roll-forming-lifts',
    name: 'Crawler Roll Forming Lifts',
    range: '17m – 32m',
    desc: 'Self-propelled crawler platforms lifting a complete roll forming line to roof level. 5 models.',
  },
  {
    id: 'truck-mounted-roll-forming-lifts',
    name: 'Truck-Mounted Roll Forming Lifts',
    range: '12m – 31m',
    desc: 'Highway-mobile forming lifts, incl. 40HQ container-shippable ARC-T25HQ. 5 models.',
  },
  {
    id: 'crawler-ceiling-platforms',
    name: 'Crawler Ceiling Platforms',
    range: '20m – 35m',
    desc: 'ARC-F pick & carry under-ceiling platforms with oversized extending decks. 4 models.',
  },
  {
    id: 'roll-forming-machines',
    name: 'Roll Forming Machines',
    range: 'Standing seam',
    desc: 'Aerial-ready panel lines controlled from the same remote as the lift. 1 model.',
  },
];

function heightNum(p: any): number {
  const specs = p.data.specifications || {};
  const h = specs['Lift Height (to shear exit)'] || specs['Max Working Height'] || '';
  const m = String(h).match(/(\d+(?:\.\d+)?)/);
  return m ? parseFloat(m[1]) : 0;
}

const homeCats = HOME_CATEGORIES.map(cat => ({
  ...cat,
  items: allProducts
    .filter(p => p.data.category === cat.name)
    .sort((a, b) => heightNum(a) - heightNum(b)),
}));

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://arclifteq.com';
---

<BaseLayout
  title="Aerial Roll Forming Lifts & Crawler Ceiling Platforms — ARC Series"
  description="Crawler & truck-mounted roll forming lifts (12-32m) that form roofing panels at height, plus 20-35m pick & carry ceiling platforms. Remote control, dual power."
  ogImage="/images/og-home.jpg"
>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'ARCLIFT Equipment Co., Ltd.',
    url: siteUrl,
    logo: `${siteUrl}/images/logo.png`,
    description: 'Professional manufacturer of aerial roll forming lifts and crawler ceiling platforms — ARC series, 12m–35m reach.',
    contactPoint: {
      '@type': 'ContactPoint',
      telephone: '+86 15617687185',
      contactType: 'sales',
      availableLanguage: ['English', 'Chinese'],
    },
    areaServed: 'Worldwide',
  })} />

  <!-- HERO WITH CAROUSEL -->
  <section class="hero">
    <div class="hero__carousel">
      <!-- Slide 1: Pick & Carry -->
      <div class="hero__slide hero__slide--active" style="background-image: url('/images/hero-1.jpg');" data-overline="Pick & Carry Technology" data-title="WORK WHILE YOU MOVE" data-desc="Unlike traditional lifts that must stop to reposition, ARC platforms travel at full height with load — 3× faster cycle time per ceiling panel."></div>
      <!-- Slide 2: Aerial Roll Forming / Remote Control -->
      <div class="hero__slide" style="background-image: url('/images/hero-2.jpg');" data-overline="Full Remote Control" data-title="OPERATE FROM THE GROUND" data-desc="Complete platform control from ground level. Safer operation, precise positioning, one-person setup in minutes."></div>
      <!-- Slide 3: Export Delivery -->
      <div class="hero__slide" style="background-image: url('/images/hero-3.jpg');" data-overline="Export Ready" data-title="DELIVERED WORLDWIDE" data-desc="Modular designs ship in standard 40HQ containers or via RoRo vessel. Full export documentation, reassembly support and worldwide delivery."></div>
    </div>
    <div class="hero__overlay"></div>
    <div class="hero__content">
      <div class="hero__overline" id="hero-overline">Pick & Carry Technology</div>
      <h1 class="hero__title" id="hero-title">WORK WHILE<br>YOU <em>MOVE</em></h1>
      <p class="hero__desc" id="hero-desc">Unlike traditional lifts that must stop to reposition, ARC platforms travel at full height with load — 3× faster cycle time per ceiling panel.</p>
      <div class="hero__actions">
        <a href="/contact/" class="btn btn--primary">Get a Quote →</a>
        <a href="/products/" class="btn btn--outline">Explore Products</a>
      </div>
    </div>
    <div class="hero__dots">
      <button class="hero__dot hero__dot--active" data-index="0"></button>
      <button class="hero__dot" data-index="1"></button>
      <button class="hero__dot" data-index="2"></button>
    </div>
    <div class="hero__scroll">
      <div class="hero__scroll-line"></div>
      <span>Scroll</span>
    </div>
  </section>

  <script>
    // Hero Carousel
    const slides = document.querySelectorAll('.hero__slide');
    const dots = document.querySelectorAll('.hero__dot');
    const heroOverline = document.getElementById('hero-overline');
    const heroTitle = document.getElementById('hero-title');
    const heroDesc = document.getElementById('hero-desc');
    let currentSlide = 0;
    const slideInterval = 6000; // 6 seconds

    function goToSlide(index) {
      // Fade out current content
      heroOverline.style.opacity = '0';
      heroTitle.style.opacity = '0';
      heroDesc.style.opacity = '0';

      setTimeout(() => {
        // Update slide
        slides[currentSlide].classList.remove('hero__slide--active');
        dots[currentSlide].classList.remove('hero__dot--active');
        currentSlide = index;
        slides[currentSlide].classList.add('hero__slide--active');
        dots[currentSlide].classList.add('hero__dot--active');

        // Update content
        const slide = slides[currentSlide];
        heroOverline.textContent = slide.dataset.overline;
        heroTitle.innerHTML = slide.dataset.title.replace('<em>', '<em>').replace('</em>', '</em>');
        heroDesc.textContent = slide.dataset.desc;

        // Fade in new content
        heroOverline.style.opacity = '1';
        heroTitle.style.opacity = '1';
        heroDesc.style.opacity = '1';
      }, 300);
    }

    function nextSlide() {
      goToSlide((currentSlide + 1) % slides.length);
    }

    // Auto-rotate
    let carouselTimer = setInterval(nextSlide, slideInterval);

    // Dot click
    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        clearInterval(carouselTimer);
        goToSlide(i);
        carouselTimer = setInterval(nextSlide, slideInterval);
      });
    });

    // Pause on hover
    const heroSection = document.querySelector('.hero');
    heroSection.addEventListener('mouseenter', () => clearInterval(carouselTimer));
    heroSection.addEventListener('mouseleave', () => {
      carouselTimer = setInterval(nextSlide, slideInterval);
    });
  </script>

  <!-- TRUST BAR -->
  <div class="trust">
    <span class="trust__text">Trusted by contractors in 40+ countries</span>
    <div class="trust__items">
      <div class="trust__item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg> CE Certified</div>
      <div class="trust__item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg> ISO 9001</div>
      <div class="trust__item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg> ISO 16368</div>
      <div class="trust__item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg> 24h Response</div>
    </div>
  </div>

  <!-- PRODUCTS BY CATEGORY -->
  <section class="sec sec--white">
    <div class="sec__header reveal">
      <div class="sec__overline">Our Products</div>
      <h2 class="sec__title">FOUR PRODUCT LINES</h2>
      <p class="sec__desc">Aerial roll forming lifts, ceiling platforms and forming machines — 15 models, one remote-controlled workflow</p>
    </div>
    <div class="products">
      {homeCats.map((cat, i) => (
        <a href={`/products/#${cat.id}`} class:list={['p-card', 'reveal', `reveal-d${i + 1}`]}>
          {cat.items[0]?.data.images?.[0] ? (
            <div class="p-card__img" style={`background-image:url('${cat.items[0].data.images[0]}');background-size:cover;background-position:center;`}></div>
          ) : (
            <div class="p-card__img">{cat.name}</div>
          )}
          <div class="p-card__body">
            <div class="p-card__tag">{cat.items.length} {cat.items.length === 1 ? 'Model' : 'Models'}</div>
            <div class="p-card__name">{cat.name}</div>
            <div class="p-card__specs">
              <span class="p-card__spec"><b>{cat.range}</b></span>
            </div>
            <p style="font-size:13px;color:#64748b;margin:8px 0 12px;line-height:1.5;">{cat.desc}</p>
            <span class="p-card__link">View Models →</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- FEATURE 1: Pick & Carry -->
  <section class="sec sec--gray">
    <div class="split reveal">
      <div class="split__visual" style="background: linear-gradient(135deg, #e0e7ff, #c7d2fe); border-radius: 20px; height: 480px; display: flex; align-items: center; justify-content: center; font-size: 14px; color: #6366f1;">[Pick & Carry Demo]</div>
      <div class="split__text">
        <div class="sec__overline" style="text-align:left;">Core Technology</div>
        <h3>PICK & CARRY</h3>
        <p>Unlike spider lifts that must stop to reposition, our ARC-F series keeps working while moving. The platform travels while elevated with a full load — 3× faster cycle time per ceiling panel.</p>
        <a href="/products/" class="link">Learn More →</a>
      </div>
    </div>
  </section>

  <!-- FEATURE 2: Dual Power -->
  <section class="sec sec--white">
    <div class="split split--reverse reveal">
      <div class="split__visual" style="background: linear-gradient(135deg, #dbeafe, #bfdbfe); border-radius: 20px; height: 480px; display: flex; align-items: center; justify-content: center; font-size: 14px; color: #3b82f6;">[Dual Power System]</div>
      <div class="split__text">
        <div class="sec__overline" style="text-align:left;">Power System</div>
        <h3>DUAL POWER</h3>
        <p>150hp diesel engine for outdoor travel + twin electric motors for enclosed spaces. Zero emissions, zero noise restrictions indoors.</p>
        <a href="/about/" class="link">Learn More →</a>
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section class="sec sec--dark">
    <div class="stats reveal">
      <div class="stat"><div class="stat__num">30%</div><div class="stat__label">Faster Than Scaffolding</div></div>
      <div class="stat"><div class="stat__num">12m×8m</div><div class="stat__label">Maximum Platform</div></div>
      <div class="stat"><div class="stat__num">360°</div><div class="stat__label">Full Rotation</div></div>
      <div class="stat"><div class="stat__num">24/7</div><div class="stat__label">Global Support</div></div>
    </div>
  </section>

  <!-- APPLICATIONS -->
  <section class="sec sec--white">
    <div class="sec__header reveal">
      <div class="sec__overline">Applications</div>
      <h2 class="sec__title">BUILT FOR THESE CEILINGS</h2>
      <p class="sec__desc">Specialized aerial access for tall indoor spaces</p>
    </div>
    <div class="apps">
      <a href="/applications/stadium/" class="app reveal reveal-d1">
        <div class="app__arrow">→</div>
        <div class="app__body"><h3>Stadium & Arena</h3><p>Large-span steel structures, acoustic panel installation</p></div>
      </a>
      <a href="/applications/airport/" class="app reveal reveal-d2">
        <div class="app__arrow">→</div>
        <div class="app__body"><h3>Airport Terminal</h3><p>Ceiling panel maintenance, lighting upgrade, HVAC access</p></div>
      </a>
      <a href="/applications/warehouse/" class="app reveal reveal-d3">
        <div class="app__arrow">→</div>
        <div class="app__body"><h3>Warehouse & Factory</h3><p>High-bay ceiling construction, overhead crane rail</p></div>
      </a>
    </div>
  </section>

  <!-- COMPARISON -->
  <section class="sec sec--gray">
    <div class="sec__header reveal">
      <div class="sec__overline">Why ARCLIFT</div>
      <h2 class="sec__title">PICK & CARRY vs THE REST</h2>
    </div>
    <div class="comp reveal">
      <table>
        <thead><tr><th>Feature</th><th class="hl">ARC Pick & Carry</th><th>Spider Lift</th><th>Scaffolding</th></tr></thead>
        <tbody>
          <tr><td>Platform Size</td><td class="hl">12m×3m → 12m×8m</td><td>~2m×1m basket</td><td>1m-wide planks</td></tr>
          <tr><td>Load While Moving</td><td class="hl yes">✓ 0.3–3T</td><td class="no">✗ Must stow</td><td class="no">✗ Static only</td></tr>
          <tr><td>Setup Time</td><td class="hl yes">✓ Minutes</td><td>15–30 min</td><td>Days per bay</td></tr>
          <tr><td>Indoor Operation</td><td class="hl yes">✓ Dual Power</td><td>Diesel/Electric</td><td>N/A</td></tr>
          <tr><td>Remote Control</td><td class="hl yes">✓ Full Remote</td><td>Platform controls</td><td class="no">✗ Manual</td></tr>
        </tbody>
      </table>
    </div>
    <div style="text-align:center;margin-top:2rem;">
      <a href="/compare/" class="btn btn--primary">View Full Comparison →</a>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta">
    <h2>READY TO IMPROVE YOUR EFFICIENCY?</h2>
    <p>Get a free quote within 24 hours. Our engineering team will recommend the right model.</p>
    <a href="/contact/" class="btn--white">Get a Free Quote →</a>
    <div class="cta__contacts">
      <a href="https://wa.me/8615617687185">WhatsApp: +86 15617687185</a>
      <a href="mailto:leelogly120@gmail.com">leelogly120@gmail.com</a>
    </div>
  </section>
</BaseLayout>
Layout>
