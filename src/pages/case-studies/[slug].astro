---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const cases = await getCollection('caseStudies');
  return cases
    .filter(p => !p.data.draft)
    .map(p => ({
      params: { slug: p.id.replace(/\.md$/, '') },
      props: { caseStudy: p },
    }));
}

const { caseStudy } = Astro.props;
const data = caseStudy.data;
const { Content } = await render(caseStudy);
---

<BaseLayout
  title={data.title}
  description={data.description}
  transparentNav={false}
>

  <!-- CASE STUDY SCHEMA -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: data.title,
    description: data.description,
    author: { '@type': 'Organization', name: 'ARCLIFT' },
    publisher: {
      '@type': 'Organization',
      name: 'ARCLIFT',
      logo: { '@type': 'ImageObject', url: new URL('/favicon.svg', Astro.site).href },
    },
    datePublished: data.date ? new Date(data.date).toISOString() : new Date().toISOString(),
    mainEntityOfPage: { '@type': 'WebPage', '@id': Astro.url.href },
    about: { '@type': 'Thing', name: data.category || 'Aerial Work Platform' },
  })} />

  <!-- BREADCRUMB SCHEMA -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: 'Case Studies', item: new URL('/case-studies/', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: data.title },
    ],
  })} />

  <!-- HERO -->
  <section class="hero-full" style="background-image:linear-gradient(90deg,rgba(10,10,10,.92),rgba(10,10,10,.4)),url('/images/banners/case-studies.webp');background-size:cover;background-position:center;">
    <div class="hero-full__content">
      <span class="hero-full__tag">{data.category} Planning Scenario</span>
      <h1>{data.title.toUpperCase()}</h1>
      <p>{data.description}</p>
    </div>
  </section>

  <!-- BREADCRUMB -->
  <div class="breadcrumb">
    <a href="/case-studies/">Case Studies</a> / <span>{data.title}</span>
  </div>

  <!-- CONTENT -->
  <div class="case-content">
    <p class="verification-note"><strong>Scenario status:</strong> this page is a planning example unless named customer evidence, dated field photos and approved project records are supplied. Do not treat forecast results as delivered performance.</p>

    <!-- ARTICLE -->
    <div class="article">
      <Content />
    </div>

  </div>

  <!-- CTA -->
  <section class="cta" style="margin-top:64px;">
    <h2>HAVE A SIMILAR PROJECT?</h2>
    <p>Let us help you find the right solution for your ceiling project.</p>
    <a href="/contact/" class="btn--white">Get a Free Consultation →</a>
  </section>
</BaseLayout>
