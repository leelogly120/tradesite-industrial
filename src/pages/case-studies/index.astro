---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const cases = (await getCollection('caseStudies'))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout
  title="Application Scenarios — ARCLIFT"
  description="Explore project-planning scenarios for roll forming lifts and large-deck crawler platforms. Confirm every result and configuration against project evidence."
  transparentNav={false}
>

  <!-- HERO BANNER -->
  <section class="hero-banner" style="--banner-image:url('/images/banners/case-studies.webp');--banner-position:center 58%;">
    <div class="overline">Application Scenarios</div>
    <h1>PROJECT PLANNING LIBRARY</h1>
    <p>Use these scenarios to structure discovery questions. They are not verified customer references unless a page explicitly provides project evidence.</p>
  </section>

  <!-- CASES GRID -->
  <section class="sec">
    <div class="filter-bar">
      <button class="filter-btn active" data-filter="all">All Projects</button>
      <button class="filter-btn" data-filter="Stadium">Stadium</button>
      <button class="filter-btn" data-filter="Airport">Airport</button>
      <button class="filter-btn" data-filter="Warehouse">Warehouse</button>
    </div>
    <div class="cases">
      {cases.map(c => (
        <a href={`/case-studies/${c.id}/`} class="case-card reveal" data-category={c.data.category}>
          <div class="case-card__img" style={`background-image:url('${c.data.coverImage || '/images/home/under-ceiling-field-v2.webp'}');background-size:cover;background-position:center;`}>
            <span class="case-card__tag">{c.data.category}</span>
          </div>
          <div class="case-card__body">
            <div class="case-card__title">{c.data.title}</div>
            <div class="case-card__desc">{c.data.description}</div>
            <span class="case-card__link">Review Scenario →</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="cta">
    <h2>HAVE A SIMILAR PROJECT?</h2>
    <p>Tell us about your ceiling project and we'll recommend the right solution.</p>
    <a href="/contact/" class="btn--white">Get a Free Consultation →</a>
  </section>

  <script>
    document.querySelectorAll('.filter-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const filter = btn.getAttribute('data-filter');
        document.querySelectorAll('.case-card').forEach(card => {
          const cat = card.getAttribute('data-category');
          (card as HTMLElement).style.display = (filter === 'all' || cat === filter) ? '' : 'none';
        });
      });
    });
  </script>
</BaseLayout>
