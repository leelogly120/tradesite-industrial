---
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'blog'>[];
  pageNum: number;
  totalPages: number;
  totalPosts: number;
  prev?: string;
  next?: string;
}

const { posts, pageNum, totalPages, totalPosts, prev, next } = Astro.props;

function readingMinutes(body: string) {
  const words = body.match(/[A-Za-z0-9]+(?:[-'][A-Za-z0-9]+)*/g)?.length ?? 0;
  return Math.max(1, Math.ceil(words / 200));
}
---

<section class="hero-banner">
  <div class="overline">Project Decision Guides</div>
  <h1>ROLL-FORMING LIFT & PLATFORM GUIDES</h1>
  <p>Practical guidance for roll-forming lift, transport, line-integration, and large-deck platform project decisions.</p>
</section>

<section class="sec">
  <p class="sec__count">Page {pageNum} of {totalPages} — {totalPosts} articles</p>

  <div class="blog-grid">
    {posts.map(post => (
      <a href={`/blog/${post.id}/`} class="blog-card">
        <div class="blog-card__img">
          <img src={post.data.coverImage || '/images/home/roof-panel-output.webp'} alt={post.data.coverAlt} loading="lazy" />
          {post.data.tags?.[0] && <span class="blog-card__tag">{post.data.tags[0]}</span>}
          <span class="blog-card__date">
            {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
          </span>
        </div>
        <div class="blog-card__body">
          <h2>{post.data.title}</h2>
          <p>{post.data.description}</p>
          <div class="blog-card__meta">
            <span>ARCLIFT Technical Editorial</span>
            <span>{readingMinutes(post.body)} min read</span>
          </div>
          <span class="blog-card__link">Read the guide →</span>
        </div>
      </a>
    ))}
  </div>

  {(prev || next) && (
    <nav class="pagination" aria-label="Blog pagination">
      {prev ? <a href={prev}>← Newer guides</a> : <span></span>}
      <span>Page {pageNum} of {totalPages}</span>
      {next ? <a href={next}>Older guides →</a> : <span></span>}
    </nav>
  )}
</section>

<section class="project-cta">
  <p class="overline">Project Data Review</p>
  <h2>TURN YOUR SITE DATA INTO A REVIEWABLE BRIEF</h2>
  <p>Send the work zones, panel or platform task, access and ground conditions, transport route, destination, and required interfaces. ARCLIFT will organize the questions that must be confirmed before a project-specific quotation.</p>
  <a href="/contact/" class="btn">Send Project Data →</a>
</section>

<style>
  .hero-banner {
    padding: 160px clamp(24px, 5vw, 80px) 80px;
    background:
      linear-gradient(90deg, rgba(10, 10, 10, .94), rgba(10, 10, 10, .45)),
      url('/images/banners/blog.webp') center / cover;
  }
  .overline {
    margin: 0 0 14px;
    color: #60a5fa;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .16em;
    text-transform: uppercase;
  }
  .hero-banner h1,
  .project-cta h2 {
    margin: 0 0 16px;
    color: #fff;
    font-size: clamp(30px, 5vw, 54px);
    line-height: 1.08;
    letter-spacing: -.03em;
  }
  .hero-banner p,
  .project-cta > p:not(.overline) {
    max-width: 760px;
    margin: 0;
    color: rgba(255, 255, 255, .72);
    font-size: 17px;
    line-height: 1.7;
  }
  .sec {
    padding: clamp(56px, 8vw, 96px) clamp(24px, 5vw, 80px);
  }
  .sec__count {
    max-width: 1400px;
    margin: 0 auto 26px;
    color: #64748b;
    font-size: 14px;
  }
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
    max-width: 1400px;
    margin: 0 auto;
  }
  .blog-card {
    overflow: hidden;
    border: 1px solid #e2e8f0;
    border-radius: 18px;
    background: #fff;
    color: inherit;
    text-decoration: none;
    transition: transform .25s ease, box-shadow .25s ease;
  }
  .blog-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 44px rgba(15, 23, 42, .1);
  }
  .blog-card__img {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #e2e8f0;
  }
  .blog-card__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .blog-card__tag,
  .blog-card__date {
    position: absolute;
    top: 14px;
    padding: 5px 9px;
    border-radius: 6px;
    color: #fff;
    font-size: 11px;
    font-weight: 700;
  }
  .blog-card__tag { left: 14px; background: #2563eb; }
  .blog-card__date { right: 14px; background: rgba(10, 10, 10, .72); }
  .blog-card__body { padding: 25px; }
  .blog-card__body h2 {
    margin: 0 0 12px;
    color: #0f172a;
    font-size: 20px;
    line-height: 1.35;
  }
  .blog-card__body p {
    margin: 0 0 20px;
    color: #64748b;
    font-size: 14px;
    line-height: 1.7;
  }
  .blog-card__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 16px;
    margin-bottom: 17px;
    color: #94a3b8;
    font-size: 12px;
  }
  .blog-card__link { color: #2563eb; font-size: 14px; font-weight: 700; }
  .pagination {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    max-width: 1400px;
    margin: 40px auto 0;
    color: #64748b;
  }
  .pagination a { color: #2563eb; font-weight: 700; text-decoration: none; }
  .project-cta {
    padding: 76px clamp(24px, 5vw, 80px);
    background: linear-gradient(135deg, #0f172a, #1e3a8a);
    text-align: center;
  }
  .project-cta > * { margin-right: auto; margin-left: auto; }
  .project-cta h2 { max-width: 900px; font-size: clamp(28px, 4vw, 42px); }
  .project-cta > p:not(.overline) { margin-bottom: 28px; }
  .btn {
    display: inline-flex;
    padding: 15px 26px;
    border-radius: 9px;
    background: #fff;
    color: #1d4ed8;
    font-weight: 750;
    text-decoration: none;
  }
  @media (max-width: 980px) {
    .blog-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 680px) {
    .hero-banner { padding-top: 132px; }
    .blog-grid { grid-template-columns: 1fr; }
    .pagination { align-items: center; flex-direction: column; }
  }
</style>
