---
interface Item {
  label: string;
  icon?: string;
  achieved?: boolean;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<div class="trust-bar">
  {items.map(item => (
    <div class="trust-item">
      {item.icon && <span class="trust-icon" aria-hidden="true">{item.icon}</span>}
      {item.achieved !== undefined ? (
        item.achieved ? (
          <span class="badge badge-cert">{item.label}</span>
        ) : (
          <span class="badge badge-pending" title="In progress">{item.label}</span>
        )
      ) : (
        <span>{item.label}</span>
      )}
    </div>
  ))}
</div>
