---
interface Props {
  title: string;
  slug: string;
  description: string;
  image?: string;
  priceMin?: number;
  priceMax?: number;
  currency?: string;
  category?: string;
}

const { title, slug, description, image, priceMin, priceMax, currency = 'USD', category } = Astro.props;
---

<a href={`/products/${slug}/`} class="card">
  {image ? (
    <div class="aspect-[4/3] overflow-hidden bg-gray-100">
      <img src={image} alt={title} loading="lazy" class="w-full h-full object-cover" />
    </div>
  ) : (
    <div class="aspect-[4/3] bg-gradient-to-br from-blue-50 to-blue-100 flex items-center justify-center">
      <span class="text-blue-300 text-4xl">&#128247;</span>
    </div>
  )}
  <div class="card-body">
    {category && <span class="text-xs font-medium text-blue-600 uppercase tracking-wide">{category}</span>}
    <h3 class="mt-1">{title}</h3>
    <p class="line-clamp-2">{description}</p>
    {priceMin && priceMax && (
      <p class="mt-2 font-bold text-blue-700">
        ${currency === 'USD' ? '$' : currency} {priceMin.toFixed(2)} - {priceMax.toFixed(2)}
      </p>
    )}
  </div>
</a>
