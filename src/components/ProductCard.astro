---
interface Props {
  title: string;
  slug: string;
  description?: string;
  image?: string;
  priceMin?: number;
  priceMax?: number;
  currency?: string;
  category?: string;
  isFlagship?: boolean;
  specs?: { label: string; value: string }[];
  priceEstimate?: boolean;
}

const {
  title, slug, description, image, priceMin, priceMax,
  currency = 'USD', category, isFlagship, specs = [], priceEstimate,
} = Astro.props;

const currencySymbol = currency === 'USD' ? '$' : currency;
function formatPrice(v: number) { return v >= 1000 ? `${Math.round(v / 1000)}K` : String(v); }
---

<a href={`/products/${slug}/`} class="card" style="position:relative;display:block;color:inherit;">
  {isFlagship && <span class="ribbon">Flagship</span>}

  {image ? (
    <div style="aspect-ratio:16/10;overflow:hidden;background:#f1f5f9;">
      <img src={image} alt={title} loading="lazy" width="640" height="400"
        style="width:100%;height:100%;object-fit:cover;" />
    </div>
  ) : (
    <div style="aspect-ratio:16/10;background:linear-gradient(135deg,#1E3A8A,#3B82F6);display:flex;align-items:center;justify-content:center;">
      <span style="color:rgba(255,255,255,.3);font-size:3rem;font-weight:800;">FDDPT</span>
    </div>
  )}

  <div class="card-body">
    {category && <span class="text-xs font-medium uppercase tracking-wide" style="color:var(--color-primary-light);">{category}</span>}
    <h3 style="margin-top:0.25rem;">{title}</h3>

    {specs.length > 0 && (
      <div style="display:flex;flex-wrap:wrap;gap:0.375rem;margin:0.5rem 0;">
        {specs.map(s => <span class="spec-chip">{s.label}: {s.value}</span>)}
      </div>
    )}

    {description && <p class="line-clamp-2" style="margin-bottom:0.5rem;">{description}</p>}

    {priceMin && priceMax ? (
      <p style="font-weight:700;color:var(--color-primary);margin-top:0.5rem;">
        From {currencySymbol}{formatPrice(priceMin)}–{formatPrice(priceMax)}
        {priceEstimate && <span style="font-weight:400;font-size:0.75rem;color:var(--color-text-light);"> (est.)</span>}
      </p>
    ) : (
      <p style="font-weight:600;color:var(--color-accent);margin-top:0.5rem;">RFQ</p>
    )}

    <div style="display:flex;gap:0.5rem;margin-top:0.75rem;">
      <span class="btn btn-outline-dark btn-sm" style="flex:1;text-align:center;">View Details</span>
    </div>
  </div>
</a>
