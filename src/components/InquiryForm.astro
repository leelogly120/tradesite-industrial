---
interface Props {
  productName?: string;
  productSlug?: string;
  variant?: 'product' | 'contact';
}

const { productName = '', productSlug = '', variant = 'product' } = Astro.props;
const formAction =
  import.meta.env.PUBLIC_FORM_ENDPOINT ||
  'https://arclift-form.leelogly120.workers.dev/inquiry';

const models = [
  'Not sure',
  'ARC-C17',
  'ARC-C21',
  'ARC-C25',
  'ARC-C28',
  'ARC-C32',
  'ARC-T12',
  'ARC-T18',
  'ARC-T25',
  'ARC-T25HQ',
  'ARC-T31',
  'ARC-F20',
  'ARC-F25',
  'ARC-F31',
  'ARC-F35',
  'ARC-RF8',
];
const defaultModel =
  models.find((model) => model !== 'Not sure' && productName.startsWith(model)) || 'Not sure';
const families = [
  ['truck-mounted-roll-forming-lifts', 'Truck-Mounted Roll Forming Lifts'],
  ['crawler-roll-forming-lifts', 'Crawler Roll Forming Lifts'],
  ['crawler-ceiling-platforms', 'Crawler Ceiling & Wall Platforms'],
  ['truck-mounted-work-platforms', 'Truck-Mounted Work Platforms'],
];
const countries = [
  'Select...',
  'United States',
  'Canada',
  'United Kingdom',
  'Germany',
  'France',
  'Australia',
  'UAE',
  'Saudi Arabia',
  'Singapore',
  'Malaysia',
  'India',
  'Other',
];
---

<form
  id="inquiry-form"
  action={formAction}
  data-form-variant={variant}
  data-product={productName}
  data-product-slug={productSlug}
  novalidate
>
  <input
    type="text"
    name="_gotcha"
    class="honeypot"
    tabindex="-1"
    autocomplete="off"
    aria-hidden="true"
  />

  <div class:list={variant === 'contact' ? ['fg'] : ['form-group']}>
    <label for="requestType">I need</label>
    <select id="requestType" name="requestType" aria-describedby="request-help">
      <option value="quote">A quote</option>
      <option value="datasheet">Technical documents</option>
      <option value="advice">Help choosing equipment</option>
    </select>
    <p id="request-help" class="field-help" data-request-help>Start with the equipment or application you have in mind.</p>
    <span class="field-error" data-error-for="requestType"></span>
  </div>

  {
    variant === 'contact' ? (
      <div class="contact-fields">
        <div class="fg">
          <label for="model">Product / Model</label>
          <select id="model" name="model">
            <option value="Not sure">Not sure — help me choose</option>
            <optgroup label="Equipment families">
              {families.map(([value, name]) => <option value={value}>{name}</option>)}
            </optgroup>
            <optgroup label="Model references">
              {models.filter(model => model !== 'Not sure').map(model => <option value={model}>{model}</option>)}
            </optgroup>
          </select>
        </div>
        <div class="fg">
          <label for="name">Name <span class="req" aria-hidden="true">*</span></label>
          <input id="name" name="name" maxlength="120" autocomplete="name" placeholder="Your full name" required />
          <span class="field-error" data-error-for="name"></span>
        </div>
        <div class="fg">
          <p id="contact-help" class="field-help contact-help">Provide an email address or a WhatsApp / phone number so we can reply.</p>
          <label for="email">Email</label>
          <input
            id="email"
            name="email"
            type="email"
            maxlength="254"
            autocomplete="email"
            placeholder="your@email.com"
            aria-describedby="contact-help"
          />
          <span class="field-error" data-error-for="email"></span>
        </div>
        <div class="fg">
          <label for="phone">
            WhatsApp / Phone
          </label>
          <input
            id="phone"
            name="phone"
            type="tel"
            maxlength="50"
            autocomplete="tel"
            placeholder="Include country code"
            aria-describedby="contact-help"
          />
          <span class="field-error" data-error-for="phone"></span>
        </div>
        <p class="field-error contact-error" data-error-for="contact"></p>
        <div class="fg">
          <label for="company">Company</label>
          <input id="company" name="company" maxlength="160" autocomplete="organization" placeholder="Your company name" />
          <span class="field-error" data-error-for="company"></span>
        </div>
        <fieldset class="rfq-fields">
          <legend>Eight RFQ inputs</legend>
          <div class="fg">
            <label for="work_height_m">Building / work height &amp; roof outlet datum</label>
            <input id="work_height_m" name="work_height_m" maxlength="200" placeholder="Eave height, outlet height, or datum" />
          </div>
          <div class="fg">
            <label for="panel_profile">Panel profile &amp; former (if known)</label>
            <input id="panel_profile" name="panel_profile" maxlength="200" placeholder="Standing seam, trapezoidal, or drawing ref" />
          </div>
          <div class="fg">
            <label for="machine_mass">Machine mass &amp; mounting preference</label>
            <input id="machine_mass" name="machine_mass" maxlength="200" placeholder="Tons or kg if known; otherwise unknown" />
          </div>
          <div class="fg">
            <label for="coil_data">Coil weight / width (if needed)</label>
            <input id="coil_data" name="coil_data" maxlength="200" placeholder="Skip if no coil handling" />
          </div>
          <div class="fg">
            <label for="site_access">Site access (gate, turning, setup space)</label>
            <textarea id="site_access" name="site_access" maxlength="2000" placeholder="Gate height, turning, and setup space"></textarea>
          </div>
          <div class="fg">
            <label for="chassis_included">Chassis / carrier included?</label>
            <select id="chassis_included" name="chassis_included">
              <option value="">Select...</option>
              <option value="yes">Yes</option>
              <option value="no">No</option>
              <option value="unsure">Unsure</option>
            </select>
          </div>
          <div class="fg">
            <label for="destination">Destination country / port</label>
            <input id="destination" name="destination" maxlength="200" placeholder="Country and port" />
          </div>
          <div class="fg">
            <label for="timeline_qty">Timeline &amp; quantity</label>
            <input id="timeline_qty" name="timeline_qty" maxlength="200" placeholder="When and how many" />
          </div>
        </fieldset>
        <div class="fg">
          <label for="message">Message</label>
          <textarea id="message" name="message" maxlength="5000" placeholder="Anything else that should travel with the eight inputs."></textarea>
          <span class="field-error" data-error-for="message"></span>
        </div>
      </div>
    ) : (
      <>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-4">
          <div class="form-group">
            <label for="name">
              Full Name <span class="required" aria-hidden="true">*</span>
            </label>
            <input id="name" name="name" maxlength="120" autocomplete="name" required />
            <span class="field-error" data-error-for="name"></span>
          </div>
          <div class="form-group">
            <label for="company">
              Company <span class="required" aria-hidden="true">*</span>
            </label>
            <input
              id="company"
              name="company"
              maxlength="160"
              autocomplete="organization"
              required
            />
            <span class="field-error" data-error-for="company"></span>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-4">
          <div class="form-group">
            <label for="country">
              Country / Region <span class="required" aria-hidden="true">*</span>
            </label>
            <select id="country" name="country" required>
              {countries.map((country) => <option value={country}>{country}</option>)}
            </select>
            <span class="field-error" data-error-for="country"></span>
          </div>
          <div class="form-group">
            <label for="model">Product / Model</label>
            <select id="model" name="model">
              {models.map((model) => (
                <option value={model} selected={model === defaultModel}>
                  {model}
                </option>
              ))}
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-4">
          <div class="form-group">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" maxlength="254" autocomplete="email" />
            <span class="field-error" data-error-for="email"></span>
          </div>
          <div class="form-group">
            <label for="phone">WhatsApp / Phone</label>
            <input id="phone" name="phone" type="tel" maxlength="50" autocomplete="tel" />
            <span class="field-error" data-error-for="phone"></span>
          </div>
        </div>
        <p class="field-error contact-error" data-error-for="contact"></p>

        <div class="form-group">
          <label for="application">Application</label>
          <input
            id="application"
            name="application"
            maxlength="160"
            placeholder="Roofing, ceiling, warehouse, airport..."
          />
        </div>

        <div class="form-group">
          <label for="message">
            Project Requirements <span class="required" aria-hidden="true">*</span>
          </label>
          <textarea
            id="message"
            name="message"
            maxlength="5000"
            required
            placeholder="Share the working height, panel profile, material, site conditions, destination and transport constraints."></textarea>
          <span class="field-error" data-error-for="message"></span>
        </div>
      </>
    )
  }

  <button
    type="submit"
    class:list={variant === 'contact' ? ['submit'] : ['btn', 'btn-primary', 'w-full']}
    style="width:100%;"
  >
    <span data-submit-label>
      {variant === 'contact' ? 'Send Request →' : 'Submit Inquiry'}
    </span>
    <span data-submit-progress hidden>Submitting…</span>
  </button>
  <p class="form-status" data-form-status aria-live="polite"></p>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('#inquiry-form');
  const status = form?.querySelector<HTMLElement>('[data-form-status]');
  const submit = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const label = form?.querySelector<HTMLElement>('[data-submit-label]');
  const progress = form?.querySelector<HTMLElement>('[data-submit-progress]');
  const formVariant = form?.dataset.formVariant === 'contact' ? 'contact' : 'product';

  const showError = (field: string, message = '') => {
    const node = form?.querySelector<HTMLElement>(`[data-error-for="${field}"]`);
    if (node) node.textContent = message;
  };

  const clearErrors = () => {
    form?.querySelectorAll<HTMLElement>('[data-error-for]').forEach((node) => {
      node.textContent = '';
    });
    if (status) {
      status.textContent = '';
      status.removeAttribute('role');
    }
  };

  const query = new URLSearchParams(window.location.search);
  const model = form?.querySelector<HTMLSelectElement>('#model');
  const pageModel = model?.value || '';
  const queryProduct = query.get('model') || query.get('product') || query.get('family') || '';
  const matchingModel = model && [...model.options].find(option => option.value.toLowerCase() === queryProduct.toLowerCase());
  if (matchingModel && model) {
    model.value = matchingModel.value;
  }
  const requestType = form?.querySelector<HTMLSelectElement>('#requestType');
  const queryRequest = (query.get('request') || '').toLowerCase();
  if (requestType && ['quote', 'datasheet', 'advice'].includes(queryRequest)) requestType.value = queryRequest;
  const updateRequestHelp = () => {
    const help = form?.querySelector<HTMLElement>('[data-request-help]');
    if (help) help.textContent = requestType?.value === 'datasheet'
      ? 'Tell us which equipment interests you. We will confirm the available technical documents for that configuration.'
      : requestType?.value === 'advice'
        ? 'Tell us what you need to do. We can help narrow down the equipment and the next details to check.'
        : 'Start with the equipment or application you have in mind.';
  };
  requestType?.addEventListener('change', updateRequestHelp);
  updateRequestHelp();

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (submit?.disabled) return;
    clearErrors();

    const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
    const value = (field: string) => String(data[field] || '').trim();
    const errors: Record<string, string> = {};
    const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    const phonePattern = /^[+()\d\s.-]{7,50}$/;

    if (formVariant === 'contact') {
      if (!value('name')) errors.name = 'Please enter your name.';
      if (!value('email') && !value('phone')) errors.contact = 'Enter an email address or WhatsApp/phone number.';
      if (value('email') && !emailPattern.test(value('email'))) errors.email = 'Enter a valid email address.';
      if (value('phone') && (!phonePattern.test(value('phone')) || value('phone').replace(/\D/g, '').length < 7)) {
        errors.phone = 'Enter a valid WhatsApp/phone number.';
      }
    } else {
      if (!value('name')) errors.name = 'Please enter your full name.';
      if (!value('company')) errors.company = 'Please enter your company name.';
      if (!value('country') || value('country') === 'Select...') {
        errors.country = 'Please select your country.';
      }
      if (!value('message')) errors.message = 'Please describe your project requirements.';
      if (!value('email') && !value('phone')) {
        errors.contact = 'Enter an email address or WhatsApp/phone number.';
      }
      if (value('email') && !emailPattern.test(value('email'))) {
        errors.email = 'Enter a valid email address.';
      }
    }

    if (Object.keys(errors).length) {
      Object.entries(errors).forEach(([field, message]) => showError(field, message));
      if (status) {
        status.setAttribute('role', 'alert');
        status.textContent = 'Please correct the highlighted fields.';
      }
      return;
    }

    const payload = {
      ...data,
      formVariant,
      product: formVariant === 'contact'
        ? (value('model') === 'Not sure' ? '' : value('model'))
        : (value('model') !== pageModel ? value('model') : form.dataset.product || ''),
      productSlug: form.dataset.productSlug || '',
      sourcePage: `${window.location.pathname}${window.location.search}`,
      submittedAt: new Date().toISOString(),
    };

    if (submit) submit.disabled = true;
    if (label) label.hidden = true;
    if (progress) progress.hidden = false;

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        headers: { Accept: 'application/json', 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const result = await response.json().catch(() => ({}));
      if (!response.ok || !result.ok) {
        if (result.fields) {
          Object.entries(result.fields as Record<string, string>).forEach(([field, message]) =>
            showError(field, message),
          );
        }
        throw new Error(result.code || 'SUBMISSION_FAILED');
      }

      form.reset();
      if (model) model.value = value('model');
      if (requestType) requestType.value = value('requestType');
      updateRequestHelp();
      if (status) {
        status.setAttribute('role', 'status');
        status.textContent = 'Thanks — we received your RFQ. We reply on WhatsApp or email with the next document checklist. Final specifications are confirmed in the quotation package.';
        const leadModel = String(payload.model || payload.product || '');
        const analyticsWindow = window as Window & { dataLayer?: unknown[]; gtag?: (...args: unknown[]) => void };
        analyticsWindow.dataLayer = analyticsWindow.dataLayer || [];
        analyticsWindow.dataLayer.push({ event: 'rfq_submit', model: leadModel });
        analyticsWindow.gtag?.('event', 'generate_lead', { model: leadModel });
      }
    } catch {
      if (status) {
        status.setAttribute('role', 'alert');
        status.textContent =
          'Your inquiry could not be sent. Please try again or contact us by email or WhatsApp.';
      }
    } finally {
      if (submit) submit.disabled = false;
      if (label) label.hidden = false;
      if (progress) progress.hidden = true;
    }
  });
</script>

<style>
  .honeypot {
    position: absolute !important;
    left: -10000px !important;
    width: 1px !important;
    height: 1px !important;
    overflow: hidden !important;
  }

  form[data-form-variant='contact'] {
    width: 100%;
    max-width: 100%;
  }

  form[data-form-variant='contact'] .fg {
    margin-bottom: 20px;
  }

  form[data-form-variant='contact'] input,
  form[data-form-variant='contact'] select {
    height: 54px;
    box-sizing: border-box;
    width: 100%;
    min-width: 0;
    border: 1px solid #c4d0d7;
    border-radius: 3px;
    background: #fff;
    color: #273c47;
    padding: 0 14px;
    font: inherit;
  }

  form[data-form-variant='contact'] textarea {
    width: 100%;
    height: 120px;
    min-height: 100px;
    box-sizing: border-box;
    border: 1px solid #c4d0d7;
    border-radius: 3px;
    padding: 12px 14px;
    background: #fff;
    color: #273c47;
    font: inherit;
    resize: vertical;
  }

  form[data-form-variant='contact'] .submit {
    height: 58px;
    box-sizing: border-box;
    padding: 0 16px;
    border: 0;
    border-radius: 3px;
    background: #123b50;
    color: #fff;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
  }

  form[data-form-variant='contact'] .submit:hover { background: #20566f; }
  form[data-form-variant='contact'] .submit:disabled { opacity: .65; cursor: wait; }
  form[data-form-variant='contact'] .rfq-fields { margin: 8px 0 20px; padding: 16px 16px 4px; border: 1px solid #c4d0d7; }
  form[data-form-variant='contact'] .rfq-fields legend { padding: 0 6px; color: #123b50; font-weight: 700; }
  form[data-form-variant='contact'] label { display: block; margin-bottom: 6px; font-weight: 650; color: #273c47; }
  form[data-form-variant='contact'] .req { color: #123b50; }
  .field-help { margin: 7px 0 0; color: #526570; font-size: .9rem; line-height: 1.5; }
  .contact-help { margin: 0 0 12px; }

  .field-error {
    display: block;
    min-height: 1.25rem;
    margin-top: 0.35rem;
    color: #b91c1c;
    font-size: 0.8125rem;
  }

  .field-error:empty {
    display: none;
    min-height: 0;
    margin: 0;
  }

  .contact-error {
    margin-top: -0.5rem;
    margin-bottom: 0.75rem;
  }

  .form-status {
    min-height: 1.5rem;
    margin-top: 0.75rem;
    text-align: center;
  }

  .form-status[role='status'] {
    color: #166534;
  }

  .form-status[role='alert'] {
    color: #b91c1c;
  }

  @media (max-width: 480px) {
    form[data-form-variant='contact'] {
      max-width: 100%;
    }
  }
</style>
