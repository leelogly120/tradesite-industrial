---
interface Props {
  productName?: string;
  productSlug?: string;
}

const { productName = '', productSlug = '' } = Astro.props;
const formAction = import.meta.env.PUBLIC_FORM_ENDPOINT || '/api/inquiry';

const modelOptions = ['Not sure', 'FDDPT-20M', 'FDDPT-25M', 'FDDPT-31M', 'FDDPT-35M'];
const applicationOptions = ['Select...', 'Stadium ceiling', 'Airport terminal', 'Warehouse / Steel structure', 'Other'];
const countryOptions = [
  'Select...', 'United States', 'Canada', 'United Kingdom', 'Germany', 'France',
  'Australia', 'UAE', 'Saudi Arabia', 'Singapore', 'Malaysia', 'India', 'Other',
];
---

<form id="inquiry-form" action={formAction} method="POST">
  <input type="hidden" name="product" value={productName} />
  <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />

  <div class="grid grid-cols-1 md:grid-cols-2 gap-x-4">
    <div class="form-group">
      <label for="name">Full Name <span class="required" aria-hidden="true">*</span></label>
      <input type="text" id="name" name="name" required placeholder="John Smith" />
      <span class="field-error">Please enter your full name.</span>
    </div>
    <div class="form-group">
      <label for="email">Email <span class="required" aria-hidden="true">*</span></label>
      <input type="email" id="email" name="email" required placeholder="john@company.com" />
      <span class="field-error">Please enter a valid email address.</span>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-x-4">
    <div class="form-group">
      <label for="company">Company <span class="required" aria-hidden="true">*</span></label>
      <input type="text" id="company" name="company" required placeholder="Company Ltd." />
      <span class="field-error">Please enter your company name.</span>
    </div>
    <div class="form-group">
      <label for="country">Country <span class="required" aria-hidden="true">*</span></label>
      <select id="country" name="country" required>
        {countryOptions.map(c => <option value={c}>{c}</option>)}
      </select>
      <span class="field-error">Please select your country.</span>
    </div>
    <div class="form-group">
      <label for="phone">Phone</label>
      <input type="tel" id="phone" name="phone" placeholder="+1 234 567 890" />
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-x-4">
    <div class="form-group">
      <label for="model">Model Interest</label>
      <select id="model" name="model">
        {modelOptions.map(m => <option value={m} selected={m === productName}>{m}</option>)}
      </select>
    </div>
    <div class="form-group">
      <label for="application">Application</label>
      <select id="application" name="application">
        {applicationOptions.map(a => <option value={a}>{a}</option>)}
      </select>
    </div>
  </div>

  <div class="form-group">
    <label for="message">Inquiry Details <span class="required" aria-hidden="true">*</span></label>
    <textarea id="message" name="message" required
      placeholder="Please describe your project requirements, ceiling height, site conditions, and any questions..."></textarea>
    <span class="field-error">Please enter your inquiry details.</span>
  </div>

  <button type="submit" class="btn btn-primary w-full" id="submit-btn" style="width:100%;">
    <span id="btn-text">Submit Inquiry</span>
    <span id="btn-spinner" style="display:none;">Submitting...</span>
  </button>
  <p class="text-xs text-center mt-2" style="color:var(--color-text-light);">
    We typically respond within 24 hours.
  </p>
</form>

<div id="form-success" class="hidden text-center py-8">
  <div style="font-size:3rem;color:var(--color-success);margin-bottom:1rem;">&#10004;</div>
  <h3 style="font-size:1.25rem;font-weight:700;color:var(--color-success);">Thank you for your inquiry!</h3>
  <p style="color:var(--color-text-light);margin-top:0.5rem;">
    Your message has been sent successfully. Our engineering team will reply within 24 hours (GMT+8).
  </p>
  <button type="button" class="btn btn-outline-dark btn-sm mt-4" onclick="document.getElementById('form-success')!.classList.add('hidden');document.getElementById('inquiry-form')!.classList.remove('hidden');">
    Send another inquiry
  </button>
</div>

<script>
  const form = document.getElementById('inquiry-form') as HTMLFormElement | null;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    let valid = true;

    // Validate required fields
    form.querySelectorAll('[required]').forEach((el) => {
      const input = el as HTMLInputElement;
      const group = input.closest('.form-group');
      if (!input.value.trim() || (input.type === 'email' && !input.value.includes('@'))) {
        group?.classList.add('error');
        valid = false;
      } else {
        group?.classList.remove('error');
      }
    });
    // Validate country select
    const country = form.querySelector('#country') as HTMLSelectElement;
    if (country && country.value === 'Select...') {
      country.closest('.form-group')?.classList.add('error');
      valid = false;
    }
    if (!valid) return;

    const btn = form.querySelector('#submit-btn') as HTMLButtonElement;
    const btnText = form.querySelector('#btn-text') as HTMLElement;
    const btnSpinner = form.querySelector('#btn-spinner') as HTMLElement;
    btn.disabled = true;
    btnText.style.display = 'none';
    btnSpinner.style.display = 'inline';

    try {
      const data = new FormData(form);
      const res = await fetch(form.action, {
        method: 'POST',
        body: data,
        headers: { Accept: 'application/json' },
      });
      if (res.ok) {
        form.classList.add('hidden');
        document.getElementById('form-success')?.classList.remove('hidden');
      } else {
        alert('Something went wrong. Please try again or email us directly at leelogly120@gmail.com.');
      }
    } catch {
      alert('Network error. Please try again later.');
    } finally {
      btn.disabled = false;
      btnText.style.display = 'inline';
      btnSpinner.style.display = 'none';
    }
  });

  // Clear error on input
  form?.querySelectorAll('input, select, textarea').forEach((el) => {
    el.addEventListener('input', () => {
      el.closest('.form-group')?.classList.remove('error');
    });
    el.addEventListener('blur', () => {
      const input = el as HTMLInputElement;
      if (input.hasAttribute('required') && !input.value.trim()) {
        input.closest('.form-group')?.classList.add('error');
      }
    });
  });
</script>
