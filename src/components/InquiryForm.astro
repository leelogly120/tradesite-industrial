---
interface Props {
  productName?: string;
  productSlug?: string;
}
const { productName = '', productSlug = '' } = Astro.props;
const formAction = 'https://formspree.io/f/your_form_id'; // Replace with Web3Forms or Formspree
---

<form id="inquiry-form" action={formAction} method="POST" class="max-w-2xl mx-auto">
  <input type="hidden" name="_subject" value={`New Inquiry: ${productName || 'General'}`} />
  <input type="hidden" name="product" value={productName} />
  <!-- Honeypot -->
  <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />

  <div class="grid grid-cols-1 md:grid-cols-2 gap-x-4">
    <div class="form-group">
      <label for="name">Full Name *</label>
      <input type="text" id="name" name="name" required placeholder="John Smith" />
    </div>
    <div class="form-group">
      <label for="email">Email *</label>
      <input type="email" id="email" name="email" required placeholder="john@company.com" />
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-x-4">
    <div class="form-group">
      <label for="company">Company</label>
      <input type="text" id="company" name="company" placeholder="Company Ltd." />
    </div>
    <div class="form-group">
      <label for="phone">Phone</label>
      <input type="tel" id="phone" name="phone" placeholder="+1 234 567 890" />
    </div>
  </div>

  <div class="form-group">
    <label for="quantity">Estimated Quantity</label>
    <input type="text" id="quantity" name="quantity" placeholder="e.g. 500 pcs" />
  </div>

  <div class="form-group">
    <label for="message">Inquiry Details *</label>
    <textarea id="message" name="message" required
      placeholder="Please describe your requirements, specifications, or any questions..."></textarea>
  </div>

  <button type="submit" class="btn btn-primary w-full">
    Send Inquiry
  </button>
  <p class="text-xs text-gray-400 mt-2 text-center">
    We typically respond within 24 hours.
  </p>
</form>

<div id="form-success" class="hidden text-center py-8">
  <div class="text-4xl mb-4">&#10004;</div>
  <h3 class="text-xl font-bold text-green-700">Thank you!</h3>
  <p class="text-gray-600 mt-2">Your inquiry has been sent. We will get back to you within 24 hours.</p>
</div>

<script>
  document.getElementById('inquiry-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const data = new FormData(form);

    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: data,
        headers: { Accept: 'application/json' },
      });
      if (res.ok) {
        form.classList.add('hidden');
        document.getElementById('form-success')?.classList.remove('hidden');
      } else {
        alert('Something went wrong. Please try again or email us directly.');
      }
    } catch {
      alert('Network error. Please try again.');
    }
  });
</script>
