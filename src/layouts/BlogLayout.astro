---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  tags?: string[];
  coverImage?: string;
  author?: string;
}

const { title, description, date, tags = [], coverImage, author = 'ARCLIFT Team' } = Astro.props;
const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});
const readTime = '8 min read';
---

<BaseLayout title={title} description={description} ogImage={coverImage} ogType="article" transparentNav={false}>

  <!-- HERO BANNER -->
  <section class="hero-banner">
    <div class="overline">{tags.length > 0 ? tags[0] : 'Blog'}</div>
    <h1>{title}</h1>
    <div class="meta">
      {tags.length > 0 && <span class="tag">{tags[0]}</span>}
      <span>{formattedDate}</span>
      <span>•</span>
      <span>{readTime}</span>
    </div>
  </section>

  <!-- BREADCRUMB -->
  <div class="breadcrumb">
    <a href="/">Home</a>
    <span>›</span>
    <a href="/blog/">Blog</a>
    <span>›</span>
    {title}
  </div>

  <!-- ARTICLE -->
  <article class="article">
    {coverImage && (
      <div class="article__hero">
        <img src={coverImage} alt={title} style="width:100%;height:100%;object-fit:cover;" />
      </div>
    )}

    <!-- KEY TAKEAWAYS -->
    <div class="key-takeaways">
      <h4>✓ Key Takeaways</h4>
      <ul>
        <li>Crawler under-ceiling platforms eliminate scaffolding requirements, reducing setup time by 60-70%</li>
        <li>Zero-emission electric models are ideal for indoor warehouse and factory environments</li>
        <li>ARCLIFT FDDPT series offers working heights from 20m to 35m with ultra-large platforms</li>
      </ul>
    </div>

    <!-- CONTENT -->
    <div class="article-content">
      <slot />
    </div>

    <!-- AUTHOR BOX -->
    <div class="author-box">
      <div class="author-box__avatar">AR</div>
      <div class="author-box__info">
        <h4>{author}</h4>
        <p>Our team of engineers and product specialists provides expert guidance on aerial work platform selection, operation, and maintenance. With over 10 years of experience in the industry, we help customers optimize their height work operations.</p>
      </div>
    </div>

    <!-- SHARE -->
    <div class="share">
      <span>Share this article:</span>
      <a href="#">in</a>
      <a href="#">tw</a>
      <a href="#">fb</a>
      <a href="#">wa</a>
    </div>
  </article>

  <!-- CTA -->
  <section class="cta">
    <h2>READY TO UPGRADE YOUR HEIGHT WORK?</h2>
    <p>Contact us to find the perfect crawler under-ceiling platform for your project.</p>
    <a href="/contact/" class="btn btn--white">Get a Free Quote →</a>
  </section>

</BaseLayout>

<style>
  /* Hero Banner */
  .hero-banner {
    padding: 160px clamp(24px, 5vw, 80px) 80px;
    background: linear-gradient(135deg, #0a0a0a, #1e293b);
    position: relative;
    overflow: hidden;
  }
  .hero-banner::before {
    content: '';
    position: absolute;
    top: -200px;
    right: -200px;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    background: rgba(37, 99, 235, 0.08);
  }
  .hero-banner .overline {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #60a5fa;
    margin-bottom: 16px;
    position: relative;
  }
  .hero-banner h1 {
    font-size: clamp(28px, 4vw, 48px);
    font-weight: 900;
    color: #fff;
    letter-spacing: -0.03em;
    margin-bottom: 16px;
    position: relative;
    max-width: 900px;
  }
  .hero-banner .meta {
    display: flex;
    align-items: center;
    gap: 16px;
    position: relative;
  }
  .hero-banner .meta span {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.6);
  }
  .hero-banner .meta .tag {
    background: #2563eb;
    color: #fff;
    padding: 4px 12px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
  }

  /* Breadcrumb */
  .breadcrumb {
    padding: 16px clamp(24px, 5vw, 80px);
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
    font-size: 14px;
  }
  .breadcrumb a {
    color: #64748b;
    text-decoration: none;
  }
  .breadcrumb a:hover {
    color: #2563eb;
  }
  .breadcrumb span {
    color: #94a3b8;
    margin: 0 8px;
  }

  /* Article */
  .article {
    max-width: 800px;
    margin: 0 auto;
    padding: clamp(40px, 6vw, 80px) clamp(24px, 5vw, 80px);
  }
  .article__hero {
    width: 100%;
    height: 400px;
    background: linear-gradient(135deg, #f1f5f9, #e2e8f0);
    border-radius: 20px;
    margin-bottom: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #94a3b8;
    font-size: 14px;
    overflow: hidden;
  }

  /* Key Takeaways */
  .key-takeaways {
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    border-radius: 16px;
    padding: 32px;
    margin: 0 0 48px;
  }
  .key-takeaways h4 {
    font-size: 16px;
    font-weight: 700;
    color: #166534;
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .key-takeaways ul {
    margin: 0;
    padding: 0 0 0 20px;
  }
  .key-takeaways li {
    font-size: 15px;
    line-height: 1.7;
    color: #166534;
    margin-bottom: 8px;
  }

  /* Article Content */
  .article-content {
    font-size: 17px;
    color: #475569;
    line-height: 1.8;
  }
  .article-content :global(h2) {
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 800;
    margin: 48px 0 24px;
    line-height: 1.3;
    color: #0a0a0a;
  }
  .article-content :global(h3) {
    font-size: clamp(20px, 2.5vw, 24px);
    font-weight: 700;
    margin: 36px 0 16px;
    line-height: 1.4;
    color: #0a0a0a;
  }
  .article-content :global(p) {
    margin-bottom: 24px;
  }
  .article-content :global(ul),
  .article-content :global(ol) {
    margin: 0 0 24px 24px;
  }
  .article-content :global(li) {
    margin-bottom: 12px;
  }
  .article-content :global(blockquote) {
    border-left: 4px solid #2563eb;
    padding: 24px 32px;
    background: #f8fafc;
    border-radius: 0 12px 12px 0;
    margin: 32px 0;
    font-style: italic;
    color: #475569;
  }
  .article-content :global(img) {
    width: 100%;
    border-radius: 16px;
    margin: 32px 0;
  }
  .article-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 32px 0;
    font-size: 15px;
  }
  .article-content :global(th) {
    text-align: left;
    padding: 16px;
    background: #f8fafc;
    border-bottom: 2px solid #e2e8f0;
    font-weight: 600;
    color: #475569;
  }
  .article-content :global(td) {
    padding: 16px;
    border-bottom: 1px solid #e2e8f0;
  }
  .article-content :global(tr:hover td) {
    background: #f8fafc;
  }

  /* Author Box */
  .author-box {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 32px;
    background: #f8fafc;
    border-radius: 16px;
    margin: 48px 0;
  }
  .author-box__avatar {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: #e2e8f0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    font-weight: 700;
    color: #64748b;
    flex-shrink: 0;
  }
  .author-box__info h4 {
    font-size: 16px;
    font-weight: 700;
    margin-bottom: 4px;
    color: #0a0a0a;
  }
  .author-box__info p {
    font-size: 14px;
    color: #64748b;
    margin: 0;
    line-height: 1.5;
  }

  /* Share */
  .share {
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 48px 0;
    padding: 24px 0;
    border-top: 1px solid #e2e8f0;
    border-bottom: 1px solid #e2e8f0;
  }
  .share span {
    font-size: 14px;
    font-weight: 600;
    color: #475569;
  }
  .share a {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #f1f5f9;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #475569;
    text-decoration: none;
    transition: all 0.3s;
  }
  .share a:hover {
    background: #2563eb;
    color: #fff;
  }

  /* CTA */
  .cta {
    background: linear-gradient(135deg, #2563eb, #1e40af);
    padding: 80px clamp(24px, 5vw, 80px);
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .cta::before {
    content: '';
    position: absolute;
    top: -200px;
    right: -200px;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.04);
  }
  .cta h2 {
    font-size: clamp(28px, 3vw, 40px);
    font-weight: 900;
    color: #fff;
    margin-bottom: 16px;
    position: relative;
  }
  .cta p {
    font-size: 16px;
    color: rgba(255, 255, 255, 0.75);
    margin-bottom: 32px;
    position: relative;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 16px 32px;
    border-radius: 10px;
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
    transition: all 0.3s;
    border: none;
    cursor: pointer;
  }
  .btn--white {
    background: #fff;
    color: #2563eb;
  }
  .btn--white:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.2);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .author-box {
      flex-direction: column;
      text-align: center;
    }
    .share {
      flex-wrap: wrap;
    }
  }
</style>
