---
import BaseLayout from './BaseLayout.astro';
import SchemaOrg from '../components/SchemaOrg.astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  tags?: string[];
  coverImage?: string;
  author?: string;
}

const { title, description, date, tags = [], coverImage, author = 'TradeSite Team' } = Astro.props;
const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});
---

<BaseLayout title={title} description={description} ogImage={coverImage} ogType="article">
  <SchemaOrg
    type="Breadcrumb"
    items={[
      { name: 'Home', url: '/' },
      { name: 'Blog', url: '/blog/' },
      { name: title, url: Astro.url.pathname },
    ]}
  />

  <article class="section">
    <div class="container max-w-3xl">
      <!-- Header -->
      <div class="mb-8">
        {tags.length > 0 && (
          <div class="flex gap-2 mb-3">
            {tags.map(tag => (
              <span class="px-2 py-0.5 bg-blue-50 text-blue-700 rounded text-xs font-medium">{tag}</span>
            ))}
          </div>
        )}
        <h1 class="text-3xl font-bold mb-3">{title}</h1>
        <div class="flex items-center gap-4 text-sm text-gray-500">
          <span>{author}</span>
          <span>&bull;</span>
          <time datetime={new Date(date).toISOString()}>{formattedDate}</time>
        </div>
      </div>

      {coverImage && (
        <img src={coverImage} alt={title} class="rounded-xl mb-8 w-full" />
      )}

      <!-- Content -->
      <div class="prose prose-lg max-w-none">
        <slot />
      </div>

      <!-- CTA -->
      <div class="mt-12 p-6 bg-blue-50 rounded-xl text-center">
        <h3 class="text-xl font-bold mb-2">Interested in our products?</h3>
        <p class="text-gray-600 mb-4">Contact us for a free quote and product catalog.</p>
        <a href="/contact/" class="btn btn-primary">Contact Us</a>
      </div>
    </div>
  </article>
</BaseLayout>
