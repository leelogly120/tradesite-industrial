---
import SEOHead from '../components/SEOHead.astro';
import '../styles/global.css';
import '../styles/equipment-design.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: string;
  canonical?: string | false;
  transparentNav?: boolean;
  noindex?: boolean;
  follow?: boolean;
}

const { title, description, ogImage, ogType, canonical, transparentNav = true, noindex = false, follow = false } = Astro.props;
const siteName = 'ARCLIFT';
const currentPath = Astro.url.pathname;

// Avoid duplicate brand name in title
const fullTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/products/', label: 'Products' },
  { href: '/applications/', label: 'Solutions' },
  { href: '/blog/', label: 'Blog' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEOHead
      title={fullTitle}
      description={description}
      ogImage={ogImage}
      ogType={ogType}
      canonical={canonical}
      noindex={noindex}
      follow={follow}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="design-a2">
    <a href="#main-content" class="skip-link">Skip to content</a>

    <div class="contact-strip" aria-label="Direct contact">
      <span>Roof-forming lifts &amp; work platforms</span>
      <a href="mailto:leelogly120@gmail.com">leelogly120@gmail.com</a>
      <a href="https://wa.me/8615515922444">WhatsApp: +86 15515922444</a>
    </div>

    <!-- NAVBAR -->
    <nav class="nav nav--solid" id="nav" data-transparent="false" aria-label="Primary navigation">
      <a href="/" class="nav__logo" aria-label="ARCLIFT home"><img src="/images/logo.png" width="174" height="55" alt="ARCLIFT" /></a>
      <div class="nav__links">
        {navLinks.map(link => (
          <a href={link.href} class={isActive(link.href) ? 'active' : ''} aria-current={isActive(link.href) ? 'page' : undefined}>
            {link.label}
          </a>
        ))}
      </div>
      <a href="/contact/" class="nav__cta">Get a Quote</a>
      <button class="hamburger" id="hamburger" aria-label="Toggle navigation" aria-expanded="false" aria-controls="mobile-drawer">
        <span></span><span></span><span></span>
      </button>
    </nav>

    <!-- Mobile drawer -->
    <div class="drawer-overlay" id="drawer-overlay"></div>
    <div class="mobile-drawer" id="mobile-drawer" role="dialog" aria-modal="true" aria-label="Site navigation" aria-hidden="true" inert>
      <button class="drawer-close" id="drawer-close" aria-label="Close navigation">×</button>
      {navLinks.map(link => (
        <a href={link.href} class={isActive(link.href) ? 'active' : ''}>
          {link.label}
        </a>
      ))}
      <a href="/contact/" class="btn btn--primary" style="margin-top:1.5rem;text-align:center;">Get a Quote</a>
      <a href="https://wa.me/8615515922444">WhatsApp: +86 15515922444</a>
      <a href="mailto:leelogly120@gmail.com">Email ARCLIFT</a>
    </div>

    <main id="main-content">
      <noscript>
        <style is:inline>
          #nav { background: #fff; }
          #nav .nav__logo, #nav .nav__links a { color: #0a0a0a; }
          #hamburger { display: none; }
          .noscript-nav { display: none; }
          @media (max-width: 768px) {
            .noscript-nav { display: flex; flex-wrap: wrap; gap: .5rem 1rem; padding: calc(var(--nav-height) + 1rem) 1.5rem 1rem; background: #eff6ff; }
            .noscript-nav a { align-items: center; display: inline-flex; min-height: 44px; color: #174f94; font-weight: 700; }
          }
        </style>
        <nav class="noscript-nav" aria-label="Navigation without JavaScript">
          {navLinks.map(link => <a href={link.href}>{link.label}</a>)}
        </nav>
      </noscript>
      <slot />
    </main>

    <!-- FOOTER -->
    <footer class="footer">
      <div class="footer__grid">
        <div>
          <div class="footer__brand"><img src="/images/logo.png" width="174" height="55" alt="ARCLIFT" loading="lazy" /></div>
          <p class="footer__brand-desc">Equipment selection and supply for roof-panel roll-forming lifts and large-deck ceiling and wall work platforms.</p>
        </div>
        <div>
          <h2 class="footer__heading">Products</h2>
          <a href="/products/#crawler-roll-forming-lifts">Crawler Roll Forming Lifts</a>
          <a href="/products/#truck-mounted-roll-forming-lifts">Truck-Mounted Lifts</a>
          <a href="/products/#crawler-ceiling-platforms">Crawler Ceiling Platforms</a>
          <a href="/products/#truck-mounted-work-platforms">Truck Work Platforms</a>
          <a href="/products/#roll-forming-machines">Roll Forming Machines</a>
        </div>
        <div>
          <h2 class="footer__heading">Solutions</h2>
          <a href="/applications/stadium/">Stadium</a>
          <a href="/applications/airport/">Airport</a>
          <a href="/applications/warehouse/">Warehouse</a>
        </div>
        <div>
          <h2 class="footer__heading">Company</h2>
          <a href="/about/">About Us</a>
          <a href="/blog/">Blog</a>
          <a href="/contact/">Contact</a>
        </div>
        <div>
          <h2 class="footer__heading">Contact</h2>
          <a href="https://wa.me/8615515922444">WhatsApp: +86 15515922444</a>
          <a href="mailto:leelogly120@gmail.com">Email: leelogly120@gmail.com</a>
          <span>Xinxiang, Henan, China</span>
        </div>
      </div>
      <div class="footer__bottom">
        <span>&copy; {new Date().getFullYear()} ARCLIFT Equipment Co., Ltd. All rights reserved.</span>
        <span>Destination requirement review covers available specifications and documentation; ARCLIFT identifies items requiring local confirmation.</span>
      </div>
    </footer>

    <style is:global>
      @media(min-width:769px){
        body.design-a2{--nav-height:120px}
        .design-a2 .nav{top:32px;height:88px}
        .design-a2 .nav__links{gap:22px}
      }
      .contact-strip{position:fixed;inset:0 0 auto;z-index:1001;height:32px;display:flex;align-items:center;justify-content:flex-end;gap:28px;padding-inline:max(24px,calc((100vw - 1248px)/2));background:#123b50;color:#fff;font-size:13px;line-height:1.2}
      .contact-strip span{margin-right:auto;color:#d2e0e7}
      .contact-strip a{color:#fff;padding-block:6px}
      .contact-strip a:hover{text-decoration:underline}
      .design-a2 .mobile-drawer{overflow-y:auto;overscroll-behavior:contain}
      .design-a2 .mobile-drawer a{flex-shrink:0}
      .design-a2 #main-content>.bread{padding-top:calc(var(--nav-height) + 16px)}
      @media(max-width:1050px) and (min-width:769px){.design-a2 .nav__links{gap:15px}.design-a2 .nav__cta{padding-inline:15px}.contact-strip span{display:none}}
      @media(max-width:768px){.contact-strip,.design-a2 .wa--contact{display:none}}
    </style>

    <!-- WHATSAPP -->
    <a href="https://wa.me/8615515922444" class:list={['wa', { 'wa--contact': currentPath.replace(/\/+$/, '') === '/contact' }]} target="_blank" rel="noopener" aria-label="Chat on WhatsApp">
      <svg viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
    </a>

    <script>
      // Navbar solid on scroll
      const nav = document.getElementById('nav');
      const updateNav = () => nav?.classList.toggle(
        'nav--solid',
        nav.dataset.transparent !== 'true' || window.scrollY > 80,
      );
      updateNav();
      window.addEventListener('scroll', updateNav, { passive: true });

      // Mobile drawer
      const hamburger = document.getElementById('hamburger');
      const drawer = document.getElementById('mobile-drawer');
      const overlay = document.getElementById('drawer-overlay');
      const drawerClose = document.getElementById('drawer-close');

      const focusableSelector = 'button:not([disabled]), a[href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';

      function openDrawer() {
        drawer?.removeAttribute('inert');
        drawer?.setAttribute('aria-hidden', 'false');
        hamburger?.classList.add('open');
        drawer?.classList.add('open');
        overlay?.classList.add('open');
        hamburger?.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
        drawerClose?.focus();
      }
      function closeDrawer(restoreFocus = true) {
        drawer?.setAttribute('inert', '');
        drawer?.setAttribute('aria-hidden', 'true');
        hamburger?.classList.remove('open');
        drawer?.classList.remove('open');
        overlay?.classList.remove('open');
        hamburger?.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
        if (restoreFocus) hamburger?.focus();
      }

      hamburger?.addEventListener('click', () => {
        hamburger.classList.contains('open') ? closeDrawer() : openDrawer();
      });
      overlay?.addEventListener('click', () => closeDrawer());
      drawerClose?.addEventListener('click', () => closeDrawer());
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && drawer?.classList.contains('open')) {
          closeDrawer();
          return;
        }
        if (e.key === 'Tab' && drawer?.classList.contains('open')) {
          const focusable = Array.from(drawer.querySelectorAll<HTMLElement>(focusableSelector));
          const first = focusable[0];
          const last = focusable.at(-1);
          if (!first || !last) return;
          if (e.shiftKey && document.activeElement === first) {
            e.preventDefault();
            last.focus();
          } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault();
            first.focus();
          }
        }
      });
      const desktopNav = window.matchMedia('(min-width: 769px)');
      desktopNav.addEventListener('change', (event) => {
        if (event.matches && drawer?.classList.contains('open')) {
          const focusWasInDrawer = drawer.contains(document.activeElement);
          closeDrawer(false);
          if (focusWasInDrawer) nav?.querySelector<HTMLElement>('.nav__logo')?.focus();
        }
      });
    </script>
  </body>
</html>
