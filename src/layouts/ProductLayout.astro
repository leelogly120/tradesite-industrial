---
import BaseLayout from './BaseLayout.astro';
import SchemaOrg from '../components/SchemaOrg.astro';
import InquiryForm from '../components/InquiryForm.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  specifications?: Record<string, string>;
  features?: string[];
  faq?: { question: string; answer: string }[];
  category?: string;
}

const {
  title, description, image,
  imageAlt = 'Representative editorial equipment-planning visual',
  specifications = {}, features = [], faq = [], category,
} = Astro.props;

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  about: {
    '@type': 'Thing',
    name: 'Archived equipment reference configuration',
    description: 'Final configuration requires the signed technical schedule and approved drawings.',
  },
};
---

<BaseLayout title={title} description={description} ogImage={image}>
  <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
  <SchemaOrg
    type="Breadcrumb"
    items={[
      { name: 'Home', url: '/' },
      { name: 'Products', url: '/products/' },
      ...(category ? [{ name: category, url: '/products/' }] : []),
      { name: title, url: Astro.url.pathname },
    ]}
  />
  {faq.length > 0 && <SchemaOrg type="FAQ" questions={faq} />}

  <div class="container">
    <div class="breadcrumb">
      <a href="/">Home</a><span>/</span><a href="/products/">Products</a><span>/</span><span>{title}</span>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div class="aspect-square bg-gray-100 rounded-xl overflow-hidden">
          {image
            ? <img src={image} alt={imageAlt} class="w-full h-full object-contain" />
            : <div class="w-full h-full flex items-center justify-center text-gray-400">Editorial reference visual</div>}
        </div>
        <div>
          {category && <span class="inline-block px-3 py-1 bg-blue-50 text-blue-700 rounded-full text-sm font-medium mb-3">{category}</span>}
          <h1 class="text-3xl font-bold mb-4">{title}</h1>
          <p class="text-gray-600 mb-6 leading-relaxed">{description}</p>
          <p class="verification-note">Representative editorial image — not model-specific evidence. Final configuration requires the signed technical schedule and approved drawings.</p>
          {features.length > 0 && <ul class="space-y-2 mb-6">{features.map(feature => <li>{feature}</li>)}</ul>}
          <a href="#inquiry" class="btn btn-primary">Request Project Review</a>
        </div>
      </div>
    </div>
  </section>

  {Object.keys(specifications).length > 0 && (
    <section class="section section-alt">
      <div class="container">
        <h2 class="text-2xl font-bold mb-3">Archived Reference Data</h2>
        <p class="verification-note">Use signed project documents—not this website table—for procurement, tender or lift planning.</p>
        <div class="overflow-x-auto">
          <table class="w-full border-collapse"><tbody>
            {Object.entries(specifications).map(([key, val]) => (
              <tr class="border-b border-gray-200">
                <td class="py-3 px-4 font-medium bg-gray-50 w-1/3">{key}</td>
                <td class="py-3 px-4">{val}</td>
              </tr>
            ))}
          </tbody></table>
        </div>
      </div>
    </section>
  )}

  <section class="section"><div class="container prose max-w-none"><slot /></div></section>

  <section id="inquiry" class="section section-alt">
    <div class="container">
      <h2 class="text-2xl font-bold mb-2 text-center">Request a Project Review</h2>
      <p class="text-gray-600 mb-8 text-center">Share the project conditions needed for a documented configuration review.</p>
      <InquiryForm productName={title} productSlug={Astro.url.pathname.split('/').filter(Boolean).at(-1) || ''} />
    </div>
  </section>
</BaseLayout>
